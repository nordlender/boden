# bloc OAuth app credentials (rest.bloc.net) — obtain from the club's bloc account.
BLOC_APPID=
OAUTH_CLIENT_SECRET=

# OAuth redirect URI registered with bloc. Must match the dev server's
# externally-reachable address (see README's Development section).
REDIRECT_URL=http://localhost:4321/

# Session encryption key for auth-astro. Generate with: openssl rand -base64 32
AUTH_SECRET=

# TEMPORARY role allowlist (see src/lib/auth.ts) — comma-separated bloc user
# ids. bloc has no role endpoint yet, so this stands in for one. Log in once,
# read your id off /api/auth/session, then add it here.
ADMIN_USER_IDS=
BOARD_USER_IDS=
MODERATOR_USER_IDS=

# Opt-in dev-only login (dev server only; a production build refuses to start
# if this is set). Set to 1 to sign in as a synthetic admin/board/moderator/
# member instead of via bloc. Leave empty to use real bloc auth.
DEV_LOGIN=

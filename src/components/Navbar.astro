---
import Logo from './nav/Logo.astro';
import NavLinks from './nav/NavLinks.astro';
import UserMenu from './nav/UserMenu.astro';
import UserMenuLinks from './nav/UserMenuLinks.astro';
import CartButton from './nav/CartButton.astro';
import ThemeToggle from './nav/ThemeToggle.astro';
import MorphIcon from 'morphicons/astro';
import { navMenu } from '../lib/icon-nodes';
---

<header class="border-b border-border bg-bg">
	<nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
		<Logo />

		<div class="flex items-center gap-6">
			<div class="hidden md:block">
				<NavLinks />
			</div>

			<div class="flex items-center gap-2">
				<CartButton />
				<ThemeToggle />

				<div class="hidden md:block">
					<UserMenu />
				</div>

				<details class="nav-menu group relative md:hidden">
					<summary
						class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-border-strong text-text-muted hover:bg-bg-subtle [&::-webkit-details-marker]:hidden"
						aria-label="Open menu"
					>
						<MorphIcon icon={navMenu.closed} size={20} class="nav-menu-icon" />
					</summary>
					<div class="absolute right-0 z-10 mt-2 w-48 rounded-md border border-border bg-surface p-4 shadow-lg">
						<NavLinks />
						<div class="mt-3 border-t border-border pt-3">
							<UserMenuLinks />
						</div>
					</div>
				</details>
			</div>
		</div>
	</nav>
</header>

<script>
	import type { MorphIconElement } from 'morphicons/element';
	import { navMenu } from '../lib/icon-nodes';

	document.addEventListener(
		'toggle',
		(event) => {
			const details = event.target;
			if (!(details instanceof HTMLDetailsElement) || !details.classList.contains('nav-menu')) return;
			const icon = details.querySelector<MorphIconElement>('.nav-menu-icon');
			if (!icon) return;
			icon.icon = details.open ? navMenu.open : navMenu.closed;
		},
		true,
	);
</script>

---
// Placeholder shaped like ProductAvailability's section, shown while its
// server island loads.
import { sectionTitleClasses } from '../../lib/layout-styles';
---
<section class="flex flex-col gap-3 border-t border-border pt-region" aria-busy="true" aria-label="Loading availability">
	<p class={sectionTitleClasses}>Availability, next four weeks</p>
	<div class="grid animate-pulse grid-cols-7 gap-1.5 pt-6">
		{Array.from({ length: 28 }, () => <div class="h-9 rounded-md bg-plate" />)}
	</div>
</section>

---
import EmptyCartButton from './EmptyCartButton.astro';
import Button from '../ui/Button.astro';

interface Props {
	primaryHref: string;
	primaryLabel: string;
	// Static pages (e.g. /cart) post straight to this action; the JS-driven
	// cart popup omits it and wires up EmptyCartButton's data-cart-clear
	// listener itself (see CartSidebar.astro's script).
	clearAction?: string;
	// Popup only: starts the clear button hidden until CartSidebar's script
	// confirms the cart has items.
	clearHidden?: boolean;
	// Popup only: renders an "Update cart" button (hidden until a quantity
	// changes) that the sidebar's script swaps in for the primary action.
	withUpdate?: boolean;
}

const { primaryHref, primaryLabel, clearAction, clearHidden = false, withUpdate = false } = Astro.props;
---

<div class="flex items-stretch gap-4">
	{
		clearAction ? (
			<form method="post" action={clearAction}>
				<EmptyCartButton />
			</form>
		) : (
			<div data-cart-clear-wrapper hidden={clearHidden}>
				<EmptyCartButton type="button" />
			</div>
		)
	}
	<Button variant="primary" href={primaryHref} class="flex-1" data-cart-primary>
		{primaryLabel}
	</Button>
	{
		withUpdate && (
			<Button variant="primary" type="button" class="flex-1" data-cart-update hidden>
				Update cart
			</Button>
		)
	}
</div>

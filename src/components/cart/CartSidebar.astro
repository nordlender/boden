---
import CartActionsBar from './CartActionsBar.astro';
import AppIcon from '../icons/AppIcon.astro';
---

{/* Rows are built client-side, so their icons are rendered here once and cloned per row. */}
<template data-cart-remove-icon><AppIcon name="remove" size={16} /></template>
<template data-cart-increment-icon><AppIcon name="increment" size={16} /></template>
<template data-cart-decrement-icon><AppIcon name="decrement" size={16} /></template>
<template data-cart-confirm-icon><AppIcon name="confirm" size={16} /></template>

<div data-cart-backdrop class="fixed inset-0 z-40 hidden bg-overlay"></div>

<aside
	id="cart-sidebar"
	data-cart-sidebar
	class="fixed inset-y-0 right-0 z-50 flex w-full max-w-sm translate-x-full flex-col bg-surface shadow-xl transition-transform duration-200"
	aria-hidden="true"
>
	<div class="flex items-center justify-between border-b border-border px-4 py-3">
		<h2 class="text-sm font-semibold text-text">Cart</h2>
		<button type="button" data-cart-close aria-label="Close cart" class="text-lg leading-none text-text-muted hover:text-text">
			&times;
		</button>
	</div>

	<div data-cart-list class="flex-1 divide-y divide-border overflow-y-auto px-4">
		<p data-cart-empty class="py-6 text-sm text-text-muted">Your cart is empty.</p>
	</div>

	<div class="border-t border-border p-4">
		<CartActionsBar primaryHref="/cart" primaryLabel="Review order" clearHidden />
	</div>
</aside>

<script>
	import { baseClasses, iconOnlySizeClasses, variantClasses } from '../../lib/button-styles';

	// Pages using this sidebar (via BaseLayout) can be prerendered — see
	// astro.config.mjs — so there is no per-request cart cookie to read
	// server-side. It always fetches its content client-side instead, from
	// GET /api/cart (src/pages/api/cart.ts), which wraps
	// src/lib/cart.ts's getCartItems.
	type CartApiItem = {
		itemId: number;
		productSlug: string | null;
		productTitle: string;
		imageUrl: string | null;
		quantity: number;
		inStock: number;
		attributes: { key: string; value: string }[];
	};

	const sidebar = document.querySelector<HTMLElement>('[data-cart-sidebar]');
	const backdrop = document.querySelector<HTMLElement>('[data-cart-backdrop]');
	const list = document.querySelector<HTMLElement>('[data-cart-list]');
	const emptyMessage = document.querySelector<HTMLElement>('[data-cart-empty]');
	const clearWrapper = document.querySelector<HTMLElement>('[data-cart-clear-wrapper]');
	const clearButton = document.querySelector<HTMLButtonElement>('[data-cart-clear]');
	const iconTemplate = (name: string) =>
		document.querySelector<HTMLTemplateElement>(`[data-cart-${name}-icon]`)?.content.firstElementChild ?? null;
	const removeIcon = iconTemplate('remove');
	const incrementIcon = iconTemplate('increment');
	const decrementIcon = iconTemplate('decrement');
	const confirmIcon = iconTemplate('confirm');

	const stepClasses =
		'flex h-7 w-7 items-center justify-center bg-bg-subtle text-text-muted transition-colors hover:text-text focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:text-disabled-text';
	// Greyed out (disabled) until the quantity changes, then accent-colored.
	const confirmClasses = [
		baseClasses,
		iconOnlySizeClasses.sm,
		variantClasses.secondary,
		'shrink-0 enabled:border-accent enabled:text-accent-text enabled:hover:bg-accent-subtle enabled:hover:text-accent-text',
	].join(' ');
	const toggleButtons = document.querySelectorAll<HTMLElement>('[data-cart-toggle]');

	if (sidebar && backdrop && list && emptyMessage) {
		const isOpen = () => !sidebar.classList.contains('translate-x-full');

		async function loadCart() {
			let cartItems: CartApiItem[] = [];
			try {
				const res = await fetch('/api/cart');
				cartItems = await res.json();
			} catch {
				return;
			}

			list?.querySelectorAll('[data-cart-row]').forEach((row) => row.remove());

			if (cartItems.length === 0) {
				emptyMessage!.hidden = false;
				if (clearWrapper) clearWrapper.hidden = true;
				return;
			}
			emptyMessage!.hidden = true;
			if (clearWrapper) clearWrapper.hidden = false;

			for (const item of cartItems) {
				const row = document.createElement('div');
				row.dataset.cartRow = '';
				row.className = 'flex items-center gap-3 py-3';

				const img = document.createElement('img');
				img.src = item.imageUrl ?? '/favicon.svg';
				img.alt = item.productTitle;
				img.className = 'h-12 w-12 shrink-0 rounded object-cover bg-bg-subtle';

				const info = document.createElement('div');
				info.className = 'min-w-0 flex-1 text-sm';

				const name = document.createElement('a');
				name.href = item.productSlug ? `/products/${item.productSlug}` : '/cart';
				name.className = 'block truncate font-medium text-text hover:underline';
				name.textContent = item.productTitle;
				info.appendChild(name);

				const variantLabel = item.attributes.map((a) => a.value).join(' / ');
				if (variantLabel) {
					const variant = document.createElement('p');
					variant.className = 'truncate text-text-muted';
					variant.textContent = variantLabel;
					info.appendChild(variant);
				}

				const max = Math.max(item.inStock, 1);
				let quantity = item.quantity;

				const stepButton = (label: string, icon: Element | null) => {
					const button = document.createElement('button');
					button.type = 'button';
					button.className = stepClasses;
					button.setAttribute('aria-label', label);
					if (icon) button.append(icon.cloneNode(true));
					return button;
				};
				const decrement = stepButton(`Decrease quantity of ${item.productTitle}`, decrementIcon);
				const increment = stepButton(`Increase quantity of ${item.productTitle}`, incrementIcon);

				const count = document.createElement('span');
				count.className = 'flex h-7 min-w-8 items-center justify-center text-sm font-semibold text-text';

				const confirm = document.createElement('button');
				confirm.type = 'button';
				confirm.className = confirmClasses;
				confirm.setAttribute('aria-label', `Update quantity of ${item.productTitle}`);
				if (confirmIcon) confirm.append(confirmIcon.cloneNode(true));

				const render = () => {
					count.textContent = String(quantity);
					decrement.disabled = quantity <= 1;
					increment.disabled = quantity >= max;
					confirm.disabled = quantity === item.quantity;
				};
				decrement.addEventListener('click', () => {
					quantity -= 1;
					render();
				});
				increment.addEventListener('click', () => {
					quantity += 1;
					render();
				});
				confirm.addEventListener('click', async () => {
					const body = new FormData();
					body.set('itemId', String(item.itemId));
					body.set('quantity', String(quantity));
					// The endpoint redirects to /cart; the update has already happened, so don't follow it.
					await fetch('/api/cart/update', { method: 'POST', body, redirect: 'manual' });
					loadCart();
				});
				render();

				const stepper = document.createElement('div');
				stepper.className =
					'inline-flex overflow-hidden rounded-md border border-border-interactive divide-x divide-border-interactive';
				stepper.append(decrement, count, increment);

				const controls = document.createElement('div');
				controls.className = 'mt-1 flex items-center gap-2';
				controls.append(stepper, confirm);
				info.appendChild(controls);

				// Destructive action — error color is the conventional choice here.
				const removeButton = document.createElement('button');
				removeButton.type = 'button';
				removeButton.className = [baseClasses, iconOnlySizeClasses.sm, variantClasses.danger, 'shrink-0 self-start'].join(' ');
				removeButton.setAttribute('aria-label', `Remove ${item.productTitle}`);
				if (removeIcon) removeButton.append(removeIcon.cloneNode(true));
				removeButton.addEventListener('click', async () => {
					const body = new FormData();
					body.set('itemId', String(item.itemId));
					await fetch('/api/cart/remove', { method: 'POST', body });
					loadCart();
				});

				row.append(img, info, removeButton);
				list?.appendChild(row);
			}
		}

		function setOpen(open: boolean) {
			sidebar!.classList.toggle('translate-x-full', !open);
			sidebar!.setAttribute('aria-hidden', String(!open));
			backdrop!.classList.toggle('hidden', !open);
			toggleButtons.forEach((button) => button.setAttribute('aria-expanded', String(open)));
			if (open) loadCart();
		}

		toggleButtons.forEach((button) => {
			button.addEventListener('click', () => setOpen(!isOpen()));
		});

		document.querySelectorAll('[data-cart-close]').forEach((button) => {
			button.addEventListener('click', () => setOpen(false));
		});

		clearButton?.addEventListener('click', async () => {
			await fetch('/api/cart/clear', { method: 'POST' });
			loadCart();
		});

		backdrop.addEventListener('click', () => setOpen(false));

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		if (new URLSearchParams(location.search).get('cartOpen') === '1') {
			setOpen(true);
			const url = new URL(location.href);
			url.searchParams.delete('cartOpen');
			history.replaceState({}, '', url);
		}
	}
</script>

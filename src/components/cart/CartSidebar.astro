---
import CartActionsBar from './CartActionsBar.astro';
---

<div data-cart-backdrop class="fixed inset-0 z-40 hidden bg-overlay"></div>

<aside
	id="cart-sidebar"
	data-cart-sidebar
	class="fixed inset-y-0 right-0 z-50 flex w-full max-w-sm translate-x-full flex-col bg-surface shadow-xl transition-transform duration-200"
	aria-hidden="true"
>
	<div class="flex items-center justify-between border-b border-border px-4 py-3">
		<h2 class="text-sm font-semibold text-text">Cart</h2>
		<button type="button" data-cart-close aria-label="Close cart" class="text-lg leading-none text-text-muted hover:text-text">
			&times;
		</button>
	</div>

	<div data-cart-list class="flex-1 overflow-y-auto px-4">
		<p data-cart-empty class="py-6 text-sm text-text-muted">Your cart is empty.</p>
		<div data-cart-rows class="divide-y divide-border"></div>
	</div>

	<div class="border-t border-border p-4">
		<CartActionsBar primaryHref="/reservation" primaryLabel="Continue to reservation" clearHidden withUpdate />
	</div>
</aside>

<script>
	// Pages using this sidebar (via BaseLayout) can be prerendered — see
	// astro.config.mjs — so there is no per-request cart cookie to read
	// server-side. It always fetches its content client-side instead, from
	// GET /api/cart (src/pages/api/cart.ts), which renders the
	// CartSidebarRows/ItemLine markup server-side via the Container API and
	// returns it as an HTML partial — the client just swaps it in rather
	// than building DOM nodes by hand. Since the rows are replaced wholesale
	// on every load, quantity edits are handled by delegation on
	// [data-cart-rows] instead of per-row listeners. There is no per-row remove:
	// a quantity of 0 removes the line when "Update cart" is clicked.
	const sidebar = document.querySelector<HTMLElement>('[data-cart-sidebar]');
	const backdrop = document.querySelector<HTMLElement>('[data-cart-backdrop]');
	const list = document.querySelector<HTMLElement>('[data-cart-list]');
	const rows = document.querySelector<HTMLElement>('[data-cart-rows]');
	const emptyMessage = document.querySelector<HTMLElement>('[data-cart-empty]');
	const clearWrapper = document.querySelector<HTMLElement>('[data-cart-clear-wrapper]');
	const updateButton = document.querySelector<HTMLButtonElement>('[data-cart-update]');
	const primaryButton = document.querySelector<HTMLElement>('[data-cart-primary]');
	const clearButton = document.querySelector<HTMLButtonElement>('[data-cart-clear]');
	const toggleButtons = document.querySelectorAll<HTMLElement>('[data-cart-toggle]');

	if (sidebar && backdrop && list && rows && emptyMessage) {
		const isOpen = () => !sidebar.classList.contains('translate-x-full');

		async function loadCart() {
			let html = '';
			try {
				const res = await fetch('/api/cart');
				html = await res.text();
			} catch {
				return;
			}

			rows!.innerHTML = html;
			const hasItems = rows!.childElementCount > 0;
			emptyMessage!.hidden = hasItems;
			if (clearWrapper) clearWrapper.hidden = !hasItems;
			syncUpdate();
		}

		// "Update cart" replaces "Review order" while any quantity is unsaved.
		function syncUpdate() {
			const inputs = rows!.querySelectorAll<HTMLInputElement>('[data-cart-quantity]');
			const dirty = [...inputs].some((input) => input.value !== input.defaultValue);
			if (updateButton) updateButton.hidden = !dirty;
			if (primaryButton) primaryButton.hidden = dirty;
		}

		rows.addEventListener('input', syncUpdate);

		// One bulk request, not one per row: each /api/cart/* response rewrites the
		// whole cart cookie, so parallel per-item calls would overwrite each other.
		updateButton?.addEventListener('click', async () => {
			const body = new FormData();
			rows!.querySelectorAll<HTMLInputElement>('[data-cart-quantity]').forEach((input) => body.set(input.name, input.value));
			await fetch('/api/cart/update-all', { method: 'POST', body });
			loadCart();
		});

		function setOpen(open: boolean) {
			sidebar!.classList.toggle('translate-x-full', !open);
			sidebar!.setAttribute('aria-hidden', String(!open));
			backdrop!.classList.toggle('hidden', !open);
			toggleButtons.forEach((button) => button.setAttribute('aria-expanded', String(open)));
			if (open) loadCart();
		}

		toggleButtons.forEach((button) => {
			button.addEventListener('click', () => setOpen(!isOpen()));
		});

		document.querySelectorAll('[data-cart-close]').forEach((button) => {
			button.addEventListener('click', () => setOpen(false));
		});

		clearButton?.addEventListener('click', async () => {
			await fetch('/api/cart/clear', { method: 'POST' });
			loadCart();
		});

		backdrop.addEventListener('click', () => setOpen(false));

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		if (new URLSearchParams(location.search).get('cartOpen') === '1') {
			setOpen(true);
			const url = new URL(location.href);
			url.searchParams.delete('cartOpen');
			history.replaceState({}, '', url);
		}
	}
</script>

---
// The cart popup on every page (mounted by BaseLayout). Its lines, "Update
// cart", "Empty cart" and the check before continuing are the shared
// CartView/CartNextButton behaviour (see CartView.astro); this component
// only adds the slide-in panel. The lines load when the panel opens, since
// some pages hosting it are prerendered (see src/pages/api/cart.ts).
import CartView from './CartView.astro';
import CartNextButton from './CartNextButton.astro';
import { emptyStateClasses, sectionTitleClasses } from '../../lib/layout-styles';
import MorphButton from '../ui/MorphButton.astro';
import Button from '../ui/Button.astro';
---

<div data-cart-backdrop class="fixed inset-0 z-40 hidden bg-overlay"></div>

<aside
	id="cart-sidebar"
	data-cart-sidebar
	class="accent-alt fixed inset-y-0 right-0 z-50 flex w-full max-w-md translate-x-full flex-col border-l border-border bg-surface shadow-2xl shadow-shadow transition-transform duration-[220ms] ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:transition-none"
	inert
>
	<div class="flex h-16 shrink-0 items-center justify-between border-b border-border px-card">
		<h2 class={sectionTitleClasses}>Your cart</h2>
		<MorphButton action="cancel" label="Close cart" data-cart-close />
	</div>

	<div class="flex-1 overflow-y-auto px-card py-stack">
		<CartView name="sidebar" size="compact" editable>
			<div slot="empty" class={emptyStateClasses}>
				<p class="font-semibold text-text">Your cart is empty.</p>
				<p class="mt-1">Pick gear from the shelves, then choose your dates here.</p>
				<div class="mt-4">
					<Button href="/" variant="secondary">Browse gear</Button>
				</div>
			</div>
		</CartView>
	</div>

	<div class="flex items-stretch gap-controls border-t border-border p-card">
		<Button type="button" variant="danger-filled" data-cart-clear="sidebar" hidden>Empty cart</Button>
		<CartNextButton view="sidebar" href="/reservation" label="Continue to reservation" class="flex-1" />
	</div>
</aside>

<script>
	import { getCartView } from './cartView';

	const sidebar = document.querySelector<HTMLElement>('[data-cart-sidebar]');
	const backdrop = document.querySelector<HTMLElement>('[data-cart-backdrop]');
	const viewRoot = sidebar?.querySelector<HTMLElement>('[data-cart-view]');
	const toggleButtons = document.querySelectorAll<HTMLElement>('[data-cart-toggle]');

	if (sidebar && backdrop && viewRoot) {
		const view = getCartView(viewRoot);
		const isOpen = () => !sidebar.classList.contains('translate-x-full');
		let lastFocused: HTMLElement | null = null;

		function setOpen(open: boolean) {
			const wasOpen = isOpen();
			sidebar!.classList.toggle('translate-x-full', !open);
			sidebar!.inert = !open;
			backdrop!.classList.toggle('hidden', !open);
			toggleButtons.forEach((button) => button.setAttribute('aria-expanded', String(open)));
			if (open) {
				if (!wasOpen) lastFocused = document.activeElement as HTMLElement | null;
				sidebar!.querySelector<HTMLElement>('[data-cart-close]')?.focus();
				view.reload();
			} else if (wasOpen) {
				lastFocused?.focus();
			}
		}

		toggleButtons.forEach((button) => button.addEventListener('click', () => setOpen(!isOpen())));
		document.querySelectorAll('[data-cart-close]').forEach((button) => button.addEventListener('click', () => setOpen(false)));
		backdrop.addEventListener('click', () => setOpen(false));
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		// Set by /api/cart/add's redirect so the sidebar opens after adding.
		if (new URLSearchParams(location.search).get('cartOpen') === '1') {
			setOpen(true);
			const url = new URL(location.href);
			url.searchParams.delete('cartOpen');
			history.replaceState({}, '', url);
		}
	}
</script>

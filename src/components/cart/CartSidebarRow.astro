---
import ItemLine from '../ui/ItemLine.astro';
import IconButton from '../ui/IconButton.astro';
import type { CartItem } from '../../lib/cart';

interface Props {
	item: CartItem;
}

const { item } = Astro.props;
---

<div data-cart-row class="py-3">
	<ItemLine
		imageUrl={item.imageUrl}
		name={item.productTitle}
		href={item.productSlug ? `/products/${item.productSlug}` : null}
		attributes={item.attributes}
		thumbnailSize={48}
		class="flex-wrap"
	>
		<Fragment slot="action">
			<form data-cart-update-form data-item-id={item.itemId} class="flex items-center gap-2">
				<label class="sr-only" for={`sidebar-quantity-${item.itemId}`}>
					Quantity for {item.productTitle}
				</label>
				<input
					id={`sidebar-quantity-${item.itemId}`}
					type="number"
					name="quantity"
					value={item.quantity}
					min="0"
					class="h-6 w-14 rounded-md border border-border-interactive px-2 py-0 text-xs"
				/>
				<IconButton
					type="submit"
					icon="check"
					label={`Update quantity for ${item.productTitle}`}
					size="sm"
					disabled
					data-cart-update-submit
					class="size-6 shrink-0 p-0!"
				/>
			</form>
			<button
				type="button"
				data-cart-remove
				data-item-id={item.itemId}
				class="shrink-0 self-start text-xs text-error hover:underline"
			>
				Remove
			</button>
		</Fragment>
	</ItemLine>
</div>

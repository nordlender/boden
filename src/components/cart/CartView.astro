---
// The cart as shown on any cart page (the sidebar, /reservation,
// /reservation/confirm): its lines, an empty state, and a notice for when
// the cart changed or couldn't be updated. Pair it with a CartNextButton
// carrying the same `name` for the page's next step. cartView.ts gives every
// cart page the same behaviour:
//
// - editable: changing a quantity swaps the next button for "Update cart",
//   so the cart is saved before moving on.
// - Before moving on, the cart is fetched again. If it changed since it was
//   shown (another tab, the sidebar), the page doesn't continue: an editable
//   view shows the new cart with a notice; a read-only view (the confirm
//   step) keeps what was reviewed and asks the member to go back. The next
//   step re-checks the submitted snapshot server-side too (confirm.astro,
//   /api/orders/create).
//
// `cart` renders the lines server-side; leave it out to load them
// client-side when needed (the sidebar, which also sits on prerendered
// pages with no cart cookie to read).
import Callout from '../ui/Callout.astro';
import CartLineRows from './CartLineRows.astro';
import type { CartLineRowSize } from './CartLineRow.astro';
import type { ShownCart } from '../../lib/cart';
import { emptyStateClasses } from '../../lib/layout-styles';

interface Props {
	name: string;
	cart?: ShownCart;
	size?: CartLineRowSize;
	editable?: boolean;
	availability?: boolean;
	newTab?: boolean;
	// Extra classes for the rows container (e.g. borders).
	class?: string;
}

const { name, cart, size = 'compact', editable = false, availability = false, newTab = false, class: className } = Astro.props;
const flag = (on: boolean) => (on ? '' : undefined);
---

<div
	data-cart-view={name}
	data-size={size}
	data-editable={flag(editable)}
	data-availability={flag(availability)}
	data-new-tab={flag(newTab)}
	data-deferred={flag(!cart)}
	data-cart-id={cart?.cartId ?? ''}
	data-cart-entries={JSON.stringify(cart?.entries ?? [])}
	class="flex flex-col gap-stack"
>
	<div aria-live="polite">
		<div data-cart-notice hidden>
			<Callout variant="warning" live={false}><p data-cart-notice-text></p></Callout>
		</div>
	</div>
	<div data-cart-rows class:list={['divide-y divide-border', className]}>
		{cart && <CartLineRows lines={cart.lines} size={size} editable={editable} availability={availability} newTab={newTab} />}
	</div>
	<div data-cart-empty hidden={!cart || cart.lines.length > 0}>
		<slot name="empty"><p class={emptyStateClasses}>Your cart is empty.</p></slot>
	</div>
</div>

<script>
	import { initCartViews } from './cartView';

	initCartViews();
</script>

---
import Button from '../ui/Button.astro';
import Callout from '../ui/Callout.astro';
import { fieldClasses, formClasses, inputClasses, labelClasses, readonlyInputClasses, textareaClasses } from '../../lib/form-styles';

interface Props {
  name: string | null;
  email: string | null;
  mobile: string | null;
  hasUnpaidFees: boolean | null;
  userIsMember: boolean | null;
}

const { name, email, mobile, hasUnpaidFees, userIsMember } = Astro.props;

// Yes/No display per the moderator-review-page spec (docs/moderator-review.md)
// — hasUnpaidFees/userIsMember are semester-membership-fee flags from bloc,
// not something a member can self-report. Display only: the inputs have no
// `name`, and /api/orders/create re-fetches the values server-side.
const yesNo = (value: boolean | null) => (value === null ? 'Unknown' : value ? 'Yes' : 'No');

const labelClass = `${fieldClasses} ${labelClasses}`;
---

<form class:list={['checkout-form', formClasses]} method="POST" action="/reservation/confirm">
	<input type="hidden" name="fromDate" data-checkout-from-date />
	<input type="hidden" name="toDate" data-checkout-to-date />
	{/* JSON lists of { from, to }, filled from TimeRangesPicker (#368). */}
	<input type="hidden" name="pickupRanges" data-checkout-pickup-ranges />
	<input type="hidden" name="returnRanges" data-checkout-return-ranges />
	{hasUnpaidFees && (
		<Callout variant="error" live={false}>
			<p>
				Note: you have an unpaid fee. You can still submit the form. Please check your payments on osiklatring.no. If you have paid the current semester fee, this could be an error.
			</p>
		</Callout>
	)}
	<label class={labelClass}>
		Name
		<input type="text" name="name" value={name ?? ''} required class:list={['w-full', inputClasses]} />
	</label>
	<label class={labelClass}>
		Email
		<input type="email" name="email" value={email ?? ''} required class:list={['w-full', inputClasses]} />
	</label>
	<label class={labelClass}>
		Mobile
		<input type="tel" name="mobile" value={mobile ?? ''} class:list={['w-full', inputClasses]} />
	</label>
	<div class="grid grid-cols-2 gap-stack">
		<label class={labelClass}>
			Unpaid fee?
			<input type="text" value={yesNo(hasUnpaidFees)} readonly class:list={['w-full', readonlyInputClasses]} />
		</label>
		<label class={labelClass}>
			Member?
			<input type="text" value={yesNo(userIsMember)} readonly class:list={['w-full', readonlyInputClasses]} />
		</label>
	</div>
	<label class={labelClass}>
		Note
		<textarea name="note" placeholder="Optional note for the moderator" rows={3} class:list={['w-full', textareaClasses]}></textarea>
	</label>
	<Callout variant="info" live={false}>
		<p>
			Oslo Studentidrettslag (OSI) is not liable for any injury, loss, or damage arising from the use of rented
			equipment. By checking the box below, you confirm that you have read and accept this.
		</p>
		<label class="mt-4 flex items-start gap-3 font-medium">
			<input type="checkbox" name="disclaimerAccepted" required class="mt-0.5 size-4" />
			I accept the liability disclaimer above.
		</label>
	</Callout>
	<Button type="submit" variant="primary" size="lg" class="mt-2 self-start">Review order</Button>
</form>

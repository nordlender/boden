---
import Button from '../ui/Button.astro';

interface Props {
  name: string | null;
  email: string | null;
  mobile: string | null;
  hasUnpaidFees: boolean | null;
  userIsMember: boolean | null;
}

const { name, email, mobile, hasUnpaidFees, userIsMember } = Astro.props;

// Yes/No display per the moderator-review-page spec (docs/moderator-review.md)
// — hasUnpaidFees/userIsMember are semester-membership-fee flags from bloc,
// not something a member can self-report. Display only: the inputs have no
// `name`, and /api/orders/create re-fetches the values server-side.
const yesNo = (value: boolean | null) => (value === null ? 'Unknown' : value ? 'Yes' : 'No');

const fieldClass = 'w-full rounded-md border border-border-interactive px-3 py-2 text-sm text-text focus:border-accent focus:outline-none';
const readonlyFieldClass = `${fieldClass} bg-disabled-bg text-disabled-text`;
const labelClass = 'block text-sm font-medium text-text';
---

<form class="checkout-form flex flex-col gap-4" method="POST" action="/api/orders/create">
	<input type="hidden" name="fromDate" data-checkout-from-date />
	<input type="hidden" name="toDate" data-checkout-to-date />
	{hasUnpaidFees && (
		<p class="rounded-lg border border-error-border bg-error-subtle p-3 text-sm text-error-text">
			Note: you have an unpaid fee. You can still submit the form. Please check your payments on osiklatring.no. If you have paid the current semester fee, this could be an error.
		</p>
	)}
	<label class={labelClass}>
		Name
		<input type="text" name="name" value={name ?? ''} required class={`${fieldClass} mt-1`} />
	</label>
	<label class={labelClass}>
		Email
		<input type="email" name="email" value={email ?? ''} required class={`${fieldClass} mt-1`} />
	</label>
	<label class={labelClass}>
		Mobile
		<input type="tel" name="mobile" value={mobile ?? ''} class={`${fieldClass} mt-1`} />
	</label>
	<div class="grid grid-cols-2 gap-4">
		<label class={labelClass}>
			Unpaid fee?
			<input type="text" value={yesNo(hasUnpaidFees)} readonly class={`${readonlyFieldClass} mt-1`} />
		</label>
		<label class={labelClass}>
			Member?
			<input type="text" value={yesNo(userIsMember)} readonly class={`${readonlyFieldClass} mt-1`} />
		</label>
	</div>
	<label class={labelClass}>
		Note
		<textarea name="note" placeholder="Optional note for the moderator" rows={3} class={`${fieldClass} mt-1`}></textarea>
	</label>
	<div class="rounded-lg border border-info-border bg-info-subtle p-3">
			<p class="text-sm text-info-text">
				Oslo Studentidrettslag (OSI) is not liable for any injury, loss, or damage arising from the use of rented
				equipment. By checking the box below, you confirm that you have read and accept this.
			</p>
			<label class="mt-3 flex items-start gap-2 text-sm text-info-text">
				<input type="checkbox" name="disclaimerAccepted" required class="mt-0.5" />
				I accept the liability disclaimer above.
			</label>
		</div>
	<Button type="submit" variant="primary" size="lg" class="self-start">Place order</Button>
</form>

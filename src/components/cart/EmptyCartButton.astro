---
interface Props {
	type?: 'submit' | 'button';
	class?: string;
}

const { type = 'submit', class: className = '' } = Astro.props;
---

<button
	type={type}
	data-cart-clear
	class:list={[
		'flex items-center gap-1 rounded border border-error-border px-2.5 py-1.5 text-sm text-error hover:bg-error-subtle',
		className,
	]}
>
	Empty cart
</button>

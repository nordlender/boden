---
import { Icon } from 'astro-icon/components';
import { icons } from '../../lib/icons';

interface Props {
	name: keyof typeof icons;
	size?: number;
	class?: string;
	// astro-icon draws each icon once per page (a <symbol>) and every later
	// use references it. A first use inside a <template> (e.g. OptsFields'
	// cloneable row) puts that <symbol> where the page can't see it, blanking
	// every other copy of the icon. `inline` draws this one in full instead.
	inline?: boolean;
}

const { name, size = 20, class: className, inline = false } = Astro.props;
const iconName = icons[name];
---
{inline ? (
	<Icon is:inline name={iconName} width={size} height={size} stroke-width="1.75" class={className} />
) : (
	<Icon name={iconName} width={size} height={size} stroke-width="1.75" class={className} />
)}

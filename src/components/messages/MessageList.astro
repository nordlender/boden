---
// Shared "Messages" box — used read-only on the moderator hub
// (src/components/moderator/MessagesBox.astro) and, with `editable`, on the
// admin hub (src/components/admin/MessagesBox.astro) where admins can edit
// or delete their own posts inline. Kept as one component so the two hubs
// can't drift into two different box layouts (see issue #151).
import AppIcon from '../icons/AppIcon.astro';
import Button from '../ui/Button.astro';
import MorphButton from '../ui/MorphButton.astro';
import type { MessageRow } from '../../lib/messages';
import { formatDateTimeDisplay } from '../../lib/dates';

interface Props {
	messages: MessageRow[];
	editable?: boolean;
	redirectTo?: string;
}

const { messages, editable = false, redirectTo } = Astro.props;
---

<div class="rounded-lg border border-border bg-surface">
	<h2 class="border-b border-border px-4 py-2 text-sm font-semibold text-text">Messages</h2>
	{
		messages.length === 0 ? (
			<p class="p-4 text-sm text-text-muted">No messages from admins right now.</p>
		) : (
			<ul class="divide-y divide-border">
				{messages.map((message) => (
					<li class="px-4 py-3">
						<div class="flex items-start justify-between gap-3">
							<div class="min-w-0">
								<p class="whitespace-pre-wrap text-sm text-text">{message.content}</p>
								<p class="mt-1 text-xs text-text-muted">
									{message.authorName} &middot; {formatDateTimeDisplay(message.createdAt)}
									{message.updatedAt.getTime() !== message.createdAt.getTime() && ' (edited)'}
								</p>
							</div>
							{editable && (
								<div class="flex shrink-0 items-center gap-1">
									<details class="edit-toggle">
										<summary class="flex cursor-pointer list-none rounded-md p-1.5 text-text-muted hover:bg-bg-subtle hover:text-text [&::-webkit-details-marker]:hidden">
											<AppIcon name="edit" size={16} />
										</summary>
									</details>
									<form method="post" action="/api/messages/delete">
										<input type="hidden" name="id" value={message.id} />
										<input type="hidden" name="redirectTo" value={redirectTo} />
										<MorphButton action="delete" size="sm" type="submit" />
									</form>
								</div>
							)}
						</div>
						{editable && (
							<form method="post" action="/api/messages/update" class="edit-form mt-2 hidden flex-col gap-2">
								<input type="hidden" name="id" value={message.id} />
								<input type="hidden" name="redirectTo" value={redirectTo} />
								<textarea
									name="content"
									rows="2"
									class="min-w-0 rounded border border-border-interactive px-2 py-1 text-sm"
									required
								>{message.content}</textarea>
								<Button type="submit" size="sm" class="self-start">
									Save
								</Button>
							</form>
						)}
					</li>
				))}
			</ul>
		)
	}
</div>

{
	editable && (
		<script>
			// Toggling a message's `<details>` edit trigger reveals its sibling
			// `.edit-form` (the message's `<li>`, not the details itself) instead
			// of an inline `<details>` body — keeps the summary a plain icon
			// trigger (no default-open disclosure arrow) while still needing no
			// client state beyond the `<details>` element Astro already gives us
			// for free.
			document.querySelectorAll<HTMLDetailsElement>('details.edit-toggle').forEach((details) => {
				details.addEventListener('toggle', () => {
					const form = details.closest('li')?.querySelector<HTMLFormElement>('.edit-form');
					if (form) {
						form.classList.toggle('hidden', !details.open);
						form.classList.toggle('flex', details.open);
					}
				});
			});
		</script>
	)
}

---
// Shared "Messages" box — used read-only on the moderator hub
// (src/components/moderator/MessagesBox.astro) and, with `editable`, on the
// admin hub (src/components/admin/MessagesBox.astro) where admins can edit
// or delete their own posts inline. Kept as one component so the two hubs
// can't drift into two different box layouts (see issue #151).
import AppIcon from '../icons/AppIcon.astro';
import Button from '../ui/Button.astro';
import MorphButton from '../ui/MorphButton.astro';
import type { MessageRow } from '../../lib/messages';
import { formatDateTimeDisplay } from '../../lib/dates';

interface Props {
	messages: MessageRow[];
	editable?: boolean;
	redirectTo?: string;
}

const { messages, editable = false, redirectTo } = Astro.props;
---

<div class="rounded-lg border border-border bg-surface">
	<h2 class="border-b border-border px-4 py-2 text-sm font-semibold text-text">Messages</h2>
	{
		messages.length === 0 ? (
			<p class="p-4 text-sm text-text-muted">No messages from admins right now.</p>
		) : (
			<ul class="divide-y divide-border">
				{messages.map((message) =>
					editable ? (
						// A native <details> per message, not a separate popup/box: the
						// content+delete row (.message-view) and the edit form
						// (.edit-form) are both always-present direct children of one
						// <details>, and the plain `[open]` rules in the <style> below
						// swap which one is visible, in the exact same slot. Content,
						// the edit-icon summary, and delete are all direct children too
						// (not nested inside <summary>, which would make delete's click
						// also toggle the disclosure) -- `order` puts them in the right
						// visual position regardless of DOM order.
						<li class="px-4 py-3">
							<details class="message-edit flex flex-wrap items-start gap-3">
								<summary class="edit-summary order-2 cursor-pointer list-none rounded-md p-1.5 text-text-muted hover:bg-bg-subtle hover:text-text [&::-webkit-details-marker]:hidden">
									<AppIcon name="edit" size={16} />
								</summary>
								<div class="message-view order-1 min-w-0 flex-1">
									<p class="whitespace-pre-wrap text-sm text-text">{message.content}</p>
									<p class="mt-1 text-xs text-text-muted">
										{message.authorName} &middot; {formatDateTimeDisplay(message.createdAt)}
										{message.updatedAt.getTime() !== message.createdAt.getTime() && ' (edited)'}
									</p>
								</div>
								<form method="post" action="/api/messages/delete" class="message-view order-3 shrink-0">
									<input type="hidden" name="id" value={message.id} />
									<input type="hidden" name="redirectTo" value={redirectTo} />
									<MorphButton action="delete" size="sm" type="submit" />
								</form>
								<form method="post" action="/api/messages/update" class="edit-form order-4 flex basis-full flex-col gap-2">
									<input type="hidden" name="id" value={message.id} />
									<input type="hidden" name="redirectTo" value={redirectTo} />
									<textarea
										name="content"
										rows="3"
										class="min-w-0 rounded border border-border-interactive px-2 py-1 text-sm"
										required
									>{message.content}</textarea>
									<div class="flex gap-2">
										<Button type="submit" size="sm">
											Save
										</Button>
										<Button type="button" size="sm" class="cancel-edit">
											Cancel
										</Button>
									</div>
								</form>
							</details>
						</li>
					) : (
						<li class="px-4 py-3">
							<p class="whitespace-pre-wrap text-sm text-text">{message.content}</p>
							<p class="mt-1 text-xs text-text-muted">
								{message.authorName} &middot; {formatDateTimeDisplay(message.createdAt)}
								{message.updatedAt.getTime() !== message.createdAt.getTime() && ' (edited)'}
							</p>
						</li>
					),
				)}
			</ul>
		)
	}
</div>

<style>
	/* In-place editing: .message-view (content + delete) and .edit-form are
	   both always in the DOM as direct children of the same <details>; only
	   one shows at a time, swapping in the exact same slot rather than
	   opening a second box elsewhere on the page. */
	.message-edit > .edit-form {
		display: none;
	}
	.message-edit[open] > .message-view {
		display: none;
	}
	.message-edit[open] > .edit-form {
		display: flex;
	}
</style>

{
	editable && (
		<script>
			// The only bit of interactivity that isn't plain <details>/CSS: the
			// Cancel button closes the <details> (re-clicking the edit icon does
			// this too, natively) and resets the textarea to the message's saved
			// content, discarding an unsaved in-progress edit.
			document.querySelectorAll<HTMLDetailsElement>('details.message-edit').forEach((details) => {
				const textarea = details.querySelector('textarea');
				const original = textarea?.value ?? '';
				details.querySelector('.cancel-edit')?.addEventListener('click', () => {
					if (textarea) textarea.value = original;
					details.open = false;
				});
			});
		</script>
	)
}

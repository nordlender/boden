---
// Standardized message list — the "Messages" board on both the moderator
// and admin hubs (so the two can't drift into two different box layouts, see
// issue #151), and each unit's notes on /admin/items/[id]/units (unit notes
// are messages too — see src/db/schema.ts). `isAdmin` is forwarded to each
// row: only admins may pin or delete (MessageTableRow.astro).
//
// `title: null` drops the heading row (unit notes sit inside their own
// dropdown); `pinnable: false` hides pinning (unit notes are a log, not a
// board).
import MessageTableRow from './MessageTableRow.astro';
import type { MessageRow } from '../../lib/messages';

interface Props {
	messages: MessageRow[];
	isAdmin?: boolean;
	redirectTo?: string;
	title?: string | null;
	emptyText?: string;
	pinnable?: boolean;
}

const { messages, isAdmin = false, redirectTo, title = 'Messages', emptyText = 'No messages right now.', pinnable = true } = Astro.props;
---

<div class="flex flex-col gap-3">
	{
		title !== null && (
			<div class="flex items-center justify-between gap-3">
				<h2 class="text-lg font-semibold text-text">{title}</h2>
				<slot name="actions" />
			</div>
		)
	}

	<div class="rounded-lg border border-border bg-surface">
		{
			messages.length === 0 ? (
				<p class="p-4 text-sm text-text-muted">{emptyText}</p>
			) : (
				<ul class="divide-y divide-border">
					{messages.map((message) => (
						<MessageTableRow message={message} isAdmin={isAdmin} pinnable={pinnable} redirectTo={redirectTo} />
					))}
				</ul>
			)
		}
	</div>
</div>

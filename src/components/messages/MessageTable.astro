---
// Standardized "Messages" board — used identically by both the moderator
// hub and the admin hub, so the two can't drift into two different box
// layouts (see issue #151). `isAdmin` and `currentUserId` are forwarded to
// each row so it can decide its own pin/delete affordances (admins may
// pin/delete any message; moderators may delete only their own — see issue
// #225 and MessageTableRow.astro).
import MessageTableRow from './MessageTableRow.astro';
import type { MessageRow } from '../../lib/messages';

interface Props {
	messages: MessageRow[];
	currentUserId?: string | null;
	isAdmin?: boolean;
	redirectTo?: string;
	/** Cap the list's height to the viewport and scroll inside it (hub pages). */
	scrollable?: boolean;
}

const { messages, currentUserId = null, isAdmin = false, redirectTo, scrollable = false } = Astro.props;

// Reserves leave room below the board: on mobile the action tiles stack, so
// only room for one is kept; from `sm` they sit in a row, so all three fit.
// The 10rem floor keeps the board usable on very short viewports.
const scrollClass = scrollable
	? 'max-h-[max(10rem,calc(100dvh-22rem))] overflow-y-auto sm:max-h-[max(10rem,calc(100dvh-26rem))]'
	: '';
---

<div class="flex flex-col gap-3">
	<div class="flex items-center justify-between gap-3">
		<h2 class="text-lg font-semibold text-text">Messages</h2>
		<slot name="actions" />
	</div>

	<div class={`rounded-lg border border-border bg-surface ${scrollClass}`}>
		{
			messages.length === 0 ? (
				<p class="p-4 text-sm text-text-muted">No messages right now.</p>
			) : (
				<ul class="divide-y divide-border">
					{messages.map((message) => (
						<MessageTableRow message={message} currentUserId={currentUserId} isAdmin={isAdmin} redirectTo={redirectTo} />
					))}
				</ul>
			)
		}
	</div>
</div>

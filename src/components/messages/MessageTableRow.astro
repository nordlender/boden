---
// One message in MessageTable.astro's list. Read-only for everyone but
// admins, who get delete (enforced again server-side in
// src/pages/api/messages/delete.ts) and, where the list is `pinnable`,
// pin/unpin. There is no editing — a correction is just a new message.
import MorphButton from '../ui/MorphButton.astro';
import TextMorphButton from '../ui/TextMorphButton.astro';
import type { MessageRow } from '../../lib/messages';
import { formatDateTimeDisplay } from '../../lib/dates';

interface Props {
	message: MessageRow;
	isAdmin?: boolean;
	pinnable?: boolean;
	redirectTo?: string;
}

const { message, isAdmin = false, pinnable = true, redirectTo } = Astro.props;

const canPin = isAdmin && pinnable;
const canDelete = isAdmin;
---

<li class="px-4 py-3">
	<div class="flex items-start justify-between gap-3">
		<div class="min-w-0">
			<p class="whitespace-pre-wrap text-sm text-text">{message.content}</p>
			<p class="mt-1 text-xs text-text-muted">
				{message.authorName} &middot; {formatDateTimeDisplay(message.createdAt)}
			</p>
		</div>
		{
			(canPin || canDelete) && (
				<div class="flex shrink-0 items-center gap-1">
					{canPin && (
						<form method="post" action={message.pinnedAt ? '/api/messages/unpin' : '/api/messages/pin'}>
							<input type="hidden" name="id" value={message.id} />
							<input type="hidden" name="redirectTo" value={redirectTo} />
							{message.pinnedAt ? (
								<TextMorphButton action="unpin" size="sm" type="submit" />
							) : (
								<MorphButton action="pin" size="sm" type="submit" />
							)}
						</form>
					)}
					{canDelete && (
						<form method="post" action="/api/messages/delete">
							<input type="hidden" name="id" value={message.id} />
							<input type="hidden" name="redirectTo" value={redirectTo} />
							<MorphButton action="delete" size="sm" type="submit" />
						</form>
					)}
				</div>
			)
		}
	</div>
</li>

---
// One of the index page's three large action tiles (Retrieve / Return /
// Pickup days). A plain link styled as a big tap target rather than a
// <button> — each one just navigates, nothing to submit. The icon morphs
// to its "hover" shape (see moderatorActionIcons in icon-nodes.ts) on
// pointer hover, keyboard focus, or touch — the shared <script> below
// covers all three so a tap gets the same feedback as a mouse hover.
import MorphIcon from 'morphicons/astro';
import { moderatorActionIcons } from '../../lib/icon-nodes';

interface Props {
	href: string;
	label: string;
	description: string;
	iconKey: keyof typeof moderatorActionIcons;
}

const { href, label, description, iconKey } = Astro.props;
const icon = moderatorActionIcons[iconKey];
---

<a
	href={href}
	data-action-icon={iconKey}
	class="action-tile flex flex-1 flex-col items-center gap-2 rounded-lg border border-border bg-surface px-5 py-6 text-center transition-colors hover:border-accent hover:bg-bg-subtle sm:items-start sm:text-left"
>
	<MorphIcon icon={icon.default} size={36} class="action-tile-icon text-text" />
	<span class="text-lg font-semibold text-text">{label}</span>
	<span class="text-sm text-text-muted">{description}</span>
</a>

<script>
	import type { MorphIconElement } from 'morphicons/element';
	import { moderatorActionIcons } from '../../lib/icon-nodes';

	function setState(tile: Element, state: 'default' | 'hover') {
		const key = tile.getAttribute('data-action-icon') as keyof typeof moderatorActionIcons | null;
		const icons = key && moderatorActionIcons[key];
		if (!icons) return;
		const icon = tile.querySelector<MorphIconElement>('.action-tile-icon');
		if (icon) icon.icon = icons[state];
	}

	document.querySelectorAll<HTMLElement>('.action-tile').forEach((tile) => {
		tile.addEventListener('pointerenter', () => setState(tile, 'hover'));
		tile.addEventListener('pointerleave', () => setState(tile, 'default'));
		tile.addEventListener('focus', () => setState(tile, 'hover'));
		tile.addEventListener('blur', () => setState(tile, 'default'));
	});
</script>

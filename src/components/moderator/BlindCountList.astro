---
// Shared "blind count" checklist — the header card, mismatch banner, and
// per-line qty_<id> input form were near-identical copies between
// retrieve/[id]/count.astro (retrieval) and return/[id].astro (return).
// The moderator's count must always be blind, so `target` is only used
// here to compute the correction message — it's never echoed into the
// form as a hidden/pre-filled value.
import ItemLine from '../ui/ItemLine.astro';
import Button from '../ui/Button.astro';
import Callout from '../ui/Callout.astro';
import { cardClasses } from '../../lib/layout-styles';
import { formClasses, inputSmClasses } from '../../lib/form-styles';

interface Line {
	orderItemId: number;
	itemName: string;
	itemImageUrl?: string | null;
	target: number;
	enteredValue: number | null;
	correction: string | null;
}

interface Props {
	title: string;
	description: string;
	action: string;
	mismatch?: boolean;
	lines: Line[];
	submitLabel?: string;
}

const { title, description, action, mismatch = false, lines, submitLabel = 'Complete' } = Astro.props;
---

<div class:list={[cardClasses, 'flex flex-col gap-6 p-card']}>
	<div class="flex flex-col gap-snug">
		<h1 class="text-xl font-semibold tracking-tight text-text">{title}</h1>
		<p class="text-sm leading-relaxed text-text-muted">{description}</p>
	</div>

	{
		mismatch && (
			<Callout variant="warning">
				<p>Some counts don't match yet — see the notes below and adjust.</p>
			</Callout>
		)
	}

	<form method="post" action={action} class={formClasses}>
		<ul class="flex flex-col divide-y divide-border">
			{
				lines.map((line) => (
					<li class="py-3">
						<ItemLine imageUrl={line.itemImageUrl} name={line.itemName}>
							{line.correction && <span class="text-xs font-medium text-warning-text">{line.correction}</span>}
							<Fragment slot="action">
								<input
									type="number"
									inputmode="numeric"
									aria-label={`Counted quantity for ${line.itemName}`}
									name={`qty_${line.orderItemId}`}
									min="0"
									value={line.enteredValue ?? undefined}
									required
									class:list={['w-20', inputSmClasses]}
								/>
							</Fragment>
						</ItemLine>
					</li>
				))
			}
		</ul>

		<Button type="submit" variant="primary" size="lg" class="self-start">
			{submitLabel}
		</Button>
	</form>
</div>

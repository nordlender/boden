---
// Read-only view of the admin-authored message board (see issue #151 for
// the authoring side, src/components/admin/MessagesBox.astro). Shares its
// box/list markup with the admin hub via MessageList.astro so the two
// never drift into different layouts.
import MessageList from '../messages/MessageList.astro';
import { listMessages } from '../../lib/messages';

const messages = await listMessages();
---

<MessageList messages={messages} />

---
// Composes the shared order-detail display used by the hub and review
// pages: header, hasUnpaidFees/userIsMember chips, contact name, the
// following-rental warning (hub only), the item list, and a slot for
// page-specific actions (Accept/Reject, Retrieve items, Return items).
import OrderCodeHeader from '../orders/OrderCodeHeader.astro';
import SubmittedContactDetails from '../orders/SubmittedContactDetails.astro';
import StatusChip from './StatusChip.astro';
import OrderItemsList from './OrderItemsList.astro';
import Callout from '../ui/Callout.astro';
import Card from '../ui/Card.astro';
import { cardFooterClasses } from '../../lib/layout-styles';
import type { FollowingRentalWarning, OrderDetail } from '../../lib/moderatorOrders';

interface Props {
	order: OrderDetail;
	showAvailability?: boolean;
	adjustableTargets?: boolean;
	followingRentalWarnings?: FollowingRentalWarning[];
	// Forwarded to OrderItemsList/OrderItemRow — the id of an out-of-tree
	// <form> (rendered by the page in the `actions` slot below, which is a
	// sibling of the item list, not a wrapper around it) that each line's
	// target_<orderItemId> input should submit with. Only relevant together
	// with adjustableTargets. Optional/additive.
	formId?: string;
}

const { order, showAvailability = false, adjustableTargets = false, followingRentalWarnings = [], formId } = Astro.props;
---

<Card as="div">
	<OrderCodeHeader orderCode={order.orderCode} status={order.status} fromDate={order.fromDate} toDate={order.toDate} />

	<div class="flex flex-wrap gap-x-6 gap-y-2">
		<StatusChip label="Unpaid fees" value={order.hasUnpaidFees} goodValue={false} />
		<StatusChip label="Is member" value={order.userIsMember} goodValue={true} />
	</div>

	<p class="text-sm">
		<span class="text-text-muted">Liability disclaimer:</span>
		{
			order.disclaimerAcceptedAt ? (
				<span class="font-medium text-success-text">Accepted {order.disclaimerAcceptedAt.toLocaleString('nb-NO')}</span>
			) : (
				<span class="font-medium text-text-muted">Not accepted</span>
			)
		}
	</p>

	<SubmittedContactDetails contactName={order.contactName} />

	{
		followingRentalWarnings.length > 0 && (
			<Callout variant="warning" title="Order must be returned on the correct day">
				<ul class="flex flex-col gap-1.5">
					{followingRentalWarnings.map((warning) => (
						<li>
							{warning.itemName} is needed for order #{warning.followingOrderCode}, starting {warning.followingFromDate} — make
							sure the member knows to return on time.
						</li>
					))}
				</ul>
			</Callout>
		)
	}

	{order.note && <p class="text-sm text-text-muted">Note: {order.note}</p>}

	{order.status === 'rejected' && order.rejectedReason && (
		<Callout variant="error" title="Rejected">
			<p>{order.rejectedReason}</p>
		</Callout>
	)}

	<OrderItemsList items={order.items} showAvailability={showAvailability} adjustableTargets={adjustableTargets} formId={formId} />

	<div class={cardFooterClasses}>
		<slot name="actions" />
	</div>
</Card>

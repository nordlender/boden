---
// A single order line's display — image, name, requested quantity, and the
// optional per-line extras OrderItemsList toggles (availability reasons, an
// editable reduced-target input for a flagged line, a retrieved-quantity
// readout). Built on the shared ui/ItemLine primitive; kept separate from
// OrderItemsList so one line's look can be tuned without touching the
// list/loop logic around it.
import ItemLine from '../ui/ItemLine.astro';
import Badge from '../ui/Badge.astro';

interface Props {
	orderItemId: number;
	itemName: string;
	itemImageUrl: string | null;
	requestedQuantity: number;
	showAvailability?: boolean;
	archived?: boolean;
	doubleBooked?: boolean;
	// Renders an editable target-quantity <input> in place of a hidden one,
	// but only for a line that's actually flagged unavailable — see this
	// PR's plan's "Shortfall handling" decision (the moderator sets an
	// explicit reduced target before retrieval starts, rather than it
	// defaulting silently).
	adjustableTargets?: boolean;
	retrievedQuantity?: number | null;
	// Id of an out-of-tree <form> (rendered elsewhere, e.g. a page's `actions`
	// slot) that this row's target_<orderItemId> input should submit with,
	// via the HTML5 `form="..."` attribute — needed because OrderDetailCard
	// renders this list as a sibling of its `actions` slot, not nested inside
	// it, so a literal wrapping <form> isn't possible. Optional/additive: a
	// caller that doesn't pass it gets today's behavior unchanged.
	formId?: string;
}

const {
	orderItemId,
	itemName,
	itemImageUrl,
	requestedQuantity,
	showAvailability = false,
	archived = false,
	doubleBooked = false,
	adjustableTargets = false,
	retrievedQuantity = null,
	formId,
} = Astro.props;

const unavailable = archived || doubleBooked;
---

<li class="py-2">
	<ItemLine imageUrl={itemImageUrl} name={itemName} quantity={requestedQuantity} quantityStyle="inline">
		{
			showAvailability && unavailable && (
				<span class="flex flex-wrap gap-2 pt-0.5 text-xs">
					{archived && <Badge tone="warning">Archived / unpublished</Badge>}
					{doubleBooked && <Badge tone="warning">Fully booked elsewhere</Badge>}
				</span>
			)
		}
		{retrievedQuantity !== null && <span class="text-xs text-text-muted">Retrieved: {retrievedQuantity}</span>}
		<Fragment slot="action">
			{
				adjustableTargets &&
					(unavailable ? (
						<label class="flex flex-col items-end gap-0.5 text-xs text-text-muted">
							Target qty
							<input
								type="number"
								name={`target_${orderItemId}`}
								value={requestedQuantity}
								min="0"
								max={requestedQuantity}
								required
								form={formId}
								class="w-16 rounded border border-border-strong px-2 py-1 text-sm text-text"
							/>
						</label>
					) : (
						<input type="hidden" name={`target_${orderItemId}`} value={requestedQuantity} form={formId} />
					))
			}
		</Fragment>
	</ItemLine>
</li>

---
// Tri-state Yes/No/Unknown chip for orders.hasUnpaidFees/userIsMember.
// `null` is a first-class "Unknown" state, not a loading flicker — bloc's
// API currently always returns null for both fields (see
// docs/moderator-review.md), so Unknown is the common case today, not an
// edge case. `goodValue` lets the same component express opposite polarity
// for the two call sites: userIsMember (good = true) vs hasUnpaidFees
// (good = false).
import Badge from '../ui/Badge.astro';
import type { BadgeTone } from '../../lib/badge-styles';

interface Props {
	label: string;
	value: boolean | null;
	goodValue: boolean;
}

const { label, value, goodValue } = Astro.props;

const displayValue = value === null ? 'Unknown' : value ? 'Yes' : 'No';
const tone: BadgeTone = value === null ? 'neutral' : value === goodValue ? 'success' : 'error';
---

<span class="inline-flex items-center gap-1.5 text-sm">
	<span class="text-text-muted">{label}:</span>
	<Badge {tone}>{displayValue}</Badge>
</span>

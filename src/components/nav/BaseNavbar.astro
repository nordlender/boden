---
import Logo from './Logo.astro';
import NavLinks, { type NavLink } from './NavLinks.astro';
import UserMenu from './UserMenu.astro';
import UserMenuLinks from './UserMenuLinks.astro';
import CartButton from './CartButton.astro';
import ThemeToggle from './ThemeToggle.astro';
import Dropdown from '../ui/Dropdown.astro';
import MorphIcon from 'morphicons/astro';
import { navMenu } from '../../lib/icon-nodes';
import { triggerBoxClasses, triggerIconPixelSize } from '../../lib/icon-sizes';

interface Props {
	links: NavLink[];
	showCart?: boolean;
}

const { links, showCart = false } = Astro.props;
---

<header class="sticky top-0 z-30 border-b border-border bg-bg">
	<nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-gutter">
		<Logo />

		<div class="flex items-center gap-6">
			<div class="hidden md:block">
				<NavLinks links={links} />
			</div>

			<div class="flex items-center gap-1">
				{showCart && <CartButton />}
				<ThemeToggle />

				<div class="hidden md:block">
					<UserMenu />
				</div>

				<Dropdown
					align="right"
					ariaLabel="Open menu"
					panel="floating"
					panelClass="mt-3 w-64"
					class="nav-menu group md:hidden"
				>
					<span slot="trigger" class:list={['flex items-center justify-center rounded-full text-text-muted transition-colors hover:bg-bg-subtle hover:text-text group-open:bg-bg-subtle group-open:text-text', triggerBoxClasses.md]}>
						<MorphIcon icon={navMenu.closed} size={triggerIconPixelSize.md} class="nav-menu-icon" />
					</span>
					<NavLinks links={links} />
					<div class="mt-3 border-t border-border pt-3">
						<UserMenuLinks />
					</div>
				</Dropdown>
			</div>
		</div>
	</nav>
</header>

<script>
	import type { MorphIconElement } from 'morphicons/element';
	import { navMenu } from '../../lib/icon-nodes';

	document.addEventListener(
		'toggle',
		(event) => {
			const details = event.target;
			if (!(details instanceof HTMLDetailsElement) || !details.classList.contains('nav-menu')) return;
			const icon = details.querySelector<MorphIconElement>('.nav-menu-icon');
			if (!icon) return;
			icon.icon = details.open ? navMenu.open : navMenu.closed;
		},
		true,
	);
</script>

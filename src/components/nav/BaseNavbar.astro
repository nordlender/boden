---
import Logo from './Logo.astro';
import NavLinks, { type NavLink } from './NavLinks.astro';
import UserMenu from './UserMenu.astro';
import UserMenuLinks from './UserMenuLinks.astro';
import CartButton from './CartButton.astro';
import ThemeToggle from './ThemeToggle.astro';
import MorphIcon from 'morphicons/astro';
import { navMenu } from '../../lib/icon-nodes';
import { triggerBoxClasses, triggerIconPixelSize } from '../../lib/icon-sizes';
import { floatingPanelClasses } from '../../lib/layout-styles';

interface Props {
	links: NavLink[];
	showCart?: boolean;
}

const { links, showCart = false } = Astro.props;
---

<header class="border-b border-border bg-bg">
	<nav class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-gutter py-4">
		<Logo />

		<div class="flex items-center gap-8">
			<div class="hidden md:block">
				<NavLinks links={links} />
			</div>

			<div class="flex items-center gap-controls">
				{showCart && <CartButton />}
				<ThemeToggle />

				<div class="hidden md:block">
					<UserMenu />
				</div>

				<details class="nav-menu group relative md:hidden">
					<summary
						class:list={['flex cursor-pointer list-none items-center justify-center rounded-md border border-border-strong text-text-muted hover:bg-bg-subtle [&::-webkit-details-marker]:hidden', triggerBoxClasses.md]}
						aria-label="Open menu"
					>
						<MorphIcon icon={navMenu.closed} size={triggerIconPixelSize.md} class="nav-menu-icon" />
					</summary>
					<div class:list={['absolute right-0 z-10 mt-3 w-60', floatingPanelClasses]}>
						<NavLinks links={links} />
						<div class="mt-4 border-t border-border pt-4">
							<UserMenuLinks />
						</div>
					</div>
				</details>
			</div>
		</div>
	</nav>
</header>

<script>
	import type { MorphIconElement } from 'morphicons/element';
	import { navMenu } from '../../lib/icon-nodes';

	document.addEventListener(
		'toggle',
		(event) => {
			const details = event.target;
			if (!(details instanceof HTMLDetailsElement) || !details.classList.contains('nav-menu')) return;
			const icon = details.querySelector<MorphIconElement>('.nav-menu-icon');
			if (!icon) return;
			icon.icon = details.open ? navMenu.open : navMenu.closed;
		},
		true,
	);
</script>

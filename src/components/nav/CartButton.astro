---
import IconButton from '../ui/IconButton.astro';
import { iconOnlyPixelSize } from '../../lib/button-styles';

// IconButton defaults to size="md" — this inline svg (the escape-hatch slot
// IconButton offers when AppIcon's fixed icon set doesn't cover a shape,
// see IconButton.astro) has to size itself to match, since it renders
// outside IconButton's own AppIcon-driven sizing.
const size = iconOnlyPixelSize.md;
---

<IconButton
	label="Toggle cart"
	data-cart-toggle
	aria-expanded="false"
	aria-controls="cart-sidebar"
>
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width={size} height={size}>
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			d="M2.25 3h1.5l.75 3m0 0L6 15.75A2.25 2.25 0 0 0 8.25 18h8.25a2.25 2.25 0 0 0 2.19-1.75L21 8.25H4.5m0 0L4.28 7.5"
		/>
		<circle cx="9" cy="20.25" r="1" fill="currentColor" stroke="none" />
		<circle cx="18" cy="20.25" r="1" fill="currentColor" stroke="none" />
	</svg>
</IconButton>

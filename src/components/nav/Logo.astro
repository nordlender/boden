---
// Boden wordmark with the club's emblem as its endorsement: "Boden" is the
// product's own name, OSI Klatring the owner (see PRODUCT.md, Brand). The
// endorsement line shows at every width.
import LogoIcon from '../../assets/logo.svg';
---

<a href="/" class="group flex items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus-ring" aria-label="Boden by OSI Klatring, home">
	<LogoIcon width={32} height={32} class="size-8 shrink-0 text-text transition-colors group-hover:text-accent-text" aria-hidden="true" />
	<span class="flex flex-col leading-none">
		<span class="text-xl font-extrabold tracking-[-0.03em] text-text">Boden</span>
		<span class="mt-1 text-[0.6875rem] font-medium tracking-wide whitespace-nowrap text-text-muted">by OSI Klatring</span>
	</span>
</a>

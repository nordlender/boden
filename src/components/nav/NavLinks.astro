---
export interface NavLink {
	href: string;
	label: string;
	disabled?: boolean;
	// Only shown once the client-side session check (see UserMenuLinks.astro)
	// confirms the visitor is signed in. Needed because pages using this
	// component can be prerendered (no per-request Astro.locals.user), so the
	// gate can't be done server-side here — see Navbar.astro.
	authOnly?: boolean;
}

interface Props {
	links: NavLink[];
}

const { links } = Astro.props;
const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
---

<ul class="flex flex-col gap-1 md:flex-row md:items-center md:gap-1">
	{
		links.map((link) =>
			link.disabled ? (
				<li>
					<span class="block cursor-not-allowed rounded-md px-3 py-2 text-sm font-medium text-disabled-text" aria-disabled="true" title="Coming soon">
						{link.label}
					</span>
				</li>
			) : (
				<li {...(link.authOnly ? { 'data-signed-in': true, hidden: true } : {})}>
					<a href={link.href} aria-current={normalize(link.href) === currentPath ? 'page' : undefined} class="relative block rounded-md px-3 py-2 text-sm font-medium text-text-muted transition-colors hover:text-text focus-visible:outline-2 focus-visible:outline-focus-ring aria-[current=page]:font-bold aria-[current=page]:text-text md:after:absolute md:after:inset-x-3 md:after:-bottom-[0.875rem] md:after:h-0.5 md:after:rounded-full md:after:bg-accent md:after:opacity-0 md:aria-[current=page]:after:opacity-100">
						{link.label}
					</a>
				</li>
			)
		)
	}
</ul>

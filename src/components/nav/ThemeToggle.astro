---
import MorphIcon from 'morphicons/astro';
import { themeToggle } from '../../lib/icon-nodes';
---

<button
	type="button"
	id="theme-toggle"
	class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-md border border-border-strong text-text-muted hover:bg-bg-subtle"
	aria-label="Toggle dark mode"
>
	<MorphIcon icon={themeToggle.light} size={20} class="theme-toggle-icon" />
</button>

<script>
	import type { MorphIconElement } from 'morphicons/element';
	import { themeToggle } from '../../lib/icon-nodes';

	function resolvedTheme(): 'light' | 'dark' {
		const explicit = document.documentElement.getAttribute('data-theme');
		if (explicit === 'light' || explicit === 'dark') return explicit;
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	}

	const button = document.getElementById('theme-toggle');
	const icon = button?.querySelector<MorphIconElement>('.theme-toggle-icon');

	// Corrects the icon rendered above (always "light") for the OS-preference
	// case (data-theme unset — see BaseLayout's init script). Uses .set()
	// rather than the animated `.icon =` setter (used below, on click) since
	// this is a startup correction, not a user-triggered toggle — it should
	// jump straight to the right shape, not morph into it.
	if (icon && resolvedTheme() === 'dark') {
		icon.set(themeToggle.dark);
	}

	// Hint at the click action with tabler's "sun-moon" icon while
	// hovered or focused, then morph back to the current theme's icon.
	// Tracked as one combined state rather than two independent on/off
	// pairs, since hover and focus can overlap (e.g. tabbing to the
	// button while the mouse already rests over it) and either one
	// ending shouldn't clear the hint while the other still holds.
	let hovered = false;
	let focused = false;

	function syncIcon() {
		if (!icon) return;
		icon.icon = hovered || focused ? themeToggle.hover : themeToggle[resolvedTheme()];
	}

	button?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = resolvedTheme() === 'dark' ? 'light' : 'dark';

		root.setAttribute('data-theme', next);
		try {
			localStorage.setItem('theme', next);
		} catch {
			// localStorage may be unavailable (privacy mode); theme just won't persist.
		}

		// Only morph to the theme icon if not currently hinting via
		// hover/focus — syncIcon is the source of truth for that, so this
		// avoids fighting it if hover/focus is still active when the
		// click lands.
		if (icon && !hovered && !focused) icon.icon = themeToggle[next];
	});

	button?.addEventListener('mouseenter', () => {
		hovered = true;
		syncIcon();
	});
	button?.addEventListener('mouseleave', () => {
		hovered = false;
		syncIcon();
	});
	button?.addEventListener('focus', () => {
		focused = true;
		syncIcon();
	});
	button?.addEventListener('blur', () => {
		focused = false;
		syncIcon();
	});
</script>

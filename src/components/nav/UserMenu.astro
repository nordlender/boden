---
import UserMenuLinks from './UserMenuLinks.astro';
import AppIcon from '../icons/AppIcon.astro';
import { triggerBoxClasses, triggerIconPixelSize } from '../../lib/icon-sizes';
import { menuPanelClasses } from '../../lib/layout-styles';
---

<details class="group relative">
	<summary
		class:list={['flex cursor-pointer list-none items-center justify-center rounded-full border border-border-strong text-text-muted hover:bg-bg-subtle [&::-webkit-details-marker]:hidden', triggerBoxClasses.md]}
		aria-label="Account"
	>
		<AppIcon name="user" size={triggerIconPixelSize.md} />
	</summary>
	<div class:list={['absolute right-0 z-10 mt-3 w-60', menuPanelClasses]}>
		<UserMenuLinks />
	</div>
</details>

---
import UserMenuLinks from './UserMenuLinks.astro';
import AppIcon from '../icons/AppIcon.astro';
import Dropdown from '../ui/Dropdown.astro';
import { triggerBoxClasses, triggerIconPixelSize } from '../../lib/icon-sizes';
---

<Dropdown
	align="right"
	ariaLabel="Account"
	triggerClass={`flex items-center justify-center rounded-full border border-border-strong text-text-muted hover:bg-bg-subtle ${triggerBoxClasses.md}`}
	panelClass="mt-2 w-48 p-2"
	class="group"
>
	<Fragment slot="trigger">
		<AppIcon name="user" size={triggerIconPixelSize.md} />
	</Fragment>
	<UserMenuLinks />
</Dropdown>

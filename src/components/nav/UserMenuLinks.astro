---
import { eyebrowClasses, menuItemClasses } from '../../lib/layout-styles';
import { inputSmClasses } from '../../lib/form-styles';
import { DEV_MODE, DEV_USERS } from '../../lib/devMode';
---

<!--
	This component can be rendered on a prerendered page (the shop grid and
	404 are built once, ahead of any request), so there
	is no per-visitor session to read server-side here the way src/pages/reservation/index.astro
	does with getSession(Astro.request). Instead it renders signed-out by
	default and a client script below corrects it against auth-astro's own
	session endpoint — no changes to src/auth.ts/src/lib/auth.ts/middleware
	needed for this.
-->
<div data-user-menu-links>
	<p data-user-email class="mb-2 truncate px-3 pt-1 text-xs text-text-muted" hidden></p>
	<ul class="flex flex-col gap-1">
		<li data-signed-out>
			<a href="/auth/login" class={menuItemClasses}>Sign in</a>
		</li>
		<li data-signed-in hidden>
			<button
				type="button"
				data-sign-out
				class={menuItemClasses}
			>
				Sign out
			</button>
		</li>
	</ul>
	<!-- Dev mode only (src/lib/devMode.ts): sign in as a fixed test user. -->
	{DEV_MODE && (
		<label class="mt-1 flex flex-col gap-1.5 border-t border-border px-3 pb-1 pt-2.5">
			<span class={eyebrowClasses}>Change user</span>
			<select data-change-user class:list={['w-full', inputSmClasses]}>
				<option value="" disabled selected>Choose a user…</option>
				{DEV_USERS.map((u) => (
					<option value={u.id}>{u.name} ({u.role})</option>
				))}
			</select>
		</label>
	)}
</div>

<script>
	import { signIn, signOut } from 'auth-astro/client';

	async function loadSession() {
		try {
			const res = await fetch('/api/auth/session');
			const session = await res.json();
			const signedIn = Boolean(session?.user);

			document.querySelectorAll<HTMLElement>('[data-signed-out]').forEach((el) => {
				el.hidden = signedIn;
			});
			document.querySelectorAll<HTMLElement>('[data-signed-in]').forEach((el) => {
				el.hidden = !signedIn;
			});
			document.querySelectorAll<HTMLSelectElement>('[data-change-user]').forEach((select) => {
				const current = [...select.options].find((o) => o.value && o.value === session?.user?.id);
				if (current) current.selected = true;
			});
			document.querySelectorAll<HTMLElement>('[data-user-email]').forEach((el) => {
				if (signedIn && session.user?.email) {
					el.textContent = session.user.email;
					el.hidden = false;
				} else {
					el.hidden = true;
				}
			});
		} catch {
			// Leave the default signed-out markup in place.
		}
	}

	document.querySelectorAll<HTMLButtonElement>('[data-sign-out]').forEach((button) => {
		button.addEventListener('click', () => {
			// auth-astro's SignOutParams type pulls in `next-auth/react`, which
			// isn't installed as a dependency here (same gap login.astro's signIn
			// call works around) — cast rather than pull in next-auth for types.
			void signOut({ callbackUrl: '/' } as Parameters<typeof signOut>[0]);
		});
	});

	// Dev mode only — the select isn't rendered otherwise. Signing in again
	// replaces the current session, so no sign-out first; callbackUrl brings
	// the user back to the page they were on, re-rendered as the new user.
	document.querySelectorAll<HTMLSelectElement>('[data-change-user]').forEach((select) => {
		select.addEventListener('change', () => {
			if (!select.value) return;
			// Same next-auth/react type gap as signOut above.
			void signIn('credentials', { userId: select.value, callbackUrl: location.href } as Parameters<typeof signIn>[1]);
		});
	});

	void loadSession();
</script>

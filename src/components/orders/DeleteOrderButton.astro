---
// Member-side "get rid of this order" action, behind a confirm popover.
// Which action depends on how far the order has got (#371):
// - 'requested' (not yet reviewed): hard delete, DELETE /api/orders/[code].
// - 'scheduled' (accepted, not handed out): soft cancel,
//   POST /api/orders/[code]/cancel — the order is kept as 'cancelled'.
// - anything later: nothing is rendered.
import ActionPopover from '../ui/ActionPopover.astro';
import { inlineErrorClasses } from '../../lib/form-styles';

interface Props {
	orderCode: string;
	status: string;
}

const { orderCode, status } = Astro.props;
const mode = status === 'requested' ? 'delete' : status === 'scheduled' ? 'cancel' : null;
const popoverId = `${mode}-order-${orderCode}-confirm`;
---

{
	mode === 'delete' && (
		<div data-delete-order={orderCode} data-order-action="delete">
			<ActionPopover
				id={popoverId}
				title={`Delete order #${orderCode}?`}
				triggerLabel="Delete order"
				triggerVariant="danger"
				confirmLabel="Delete"
				confirmVariant="danger"
			>
				<p class="text-sm text-text-muted">This cannot be undone.</p>
			</ActionPopover>
			<p data-delete-order-error hidden class:list={['mt-2', inlineErrorClasses]} />
		</div>
	)
}
{
	mode === 'cancel' && (
		<div data-delete-order={orderCode} data-order-action="cancel">
			<ActionPopover
				id={popoverId}
				title={`Cancel order #${orderCode}?`}
				triggerLabel="Cancel order"
				triggerVariant="danger"
				confirmLabel="Cancel order"
				confirmVariant="danger"
				dismissLabel="Keep order"
			>
				<p class="text-sm text-text-muted">
					A moderator has already accepted this order. Cancelling frees the gear for others and cannot be undone.
				</p>
			</ActionPopover>
			<p data-delete-order-error hidden class="mt-2 text-sm text-error-text" />
		</div>
	)
}

<script>
	document.querySelectorAll<HTMLElement>('[data-delete-order]').forEach((container) => {
		const orderCode = container.dataset.deleteOrder;
		const isCancel = container.dataset.orderAction === 'cancel';
		const trigger = container.querySelector<HTMLButtonElement>('[data-action-popover-confirm]');
		const errorEl = container.querySelector<HTMLElement>('[data-delete-order-error]');

		trigger?.addEventListener('click', async () => {
			if (!orderCode) return;

			const popover = trigger.closest('[popover]') as HTMLElement | null;
			popover?.hidePopover();
			trigger.disabled = true;
			errorEl?.setAttribute('hidden', '');

			try {
				const res = isCancel
					? await fetch(`/api/orders/${orderCode}/cancel`, { method: 'POST' })
					: await fetch(`/api/orders/${orderCode}`, { method: 'DELETE' });
				if (res.ok) {
					// A deleted order is gone; a cancelled one stays, so reload
					// to show its cancelled state.
					if (isCancel) window.location.reload();
					else window.location.href = '/';
					return;
				}
				const body = await res.json().catch(() => ({}));
				if (errorEl) {
					if (body.error === 'not_deletable' || body.error === 'not_cancellable') {
						errorEl.textContent = `This order can no longer be ${isCancel ? 'cancelled' : 'deleted'} (status: ${body.status}).`;
					} else {
						errorEl.textContent = `This order could not be ${isCancel ? 'cancelled' : 'deleted'}.`;
					}
					errorEl.removeAttribute('hidden');
				}
			} catch {
				if (errorEl) {
					errorEl.textContent = 'Something went wrong. Please try again.';
					errorEl.removeAttribute('hidden');
				}
			} finally {
				trigger.disabled = false;
			}
		});
	});
</script>

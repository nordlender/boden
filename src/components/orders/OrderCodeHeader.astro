---
import { formatDateDisplay } from '../../lib/dates';
import OrderStatusBadge from './OrderStatusBadge.astro';

interface Props {
	orderCode: string;
	status: string;
	fromDate: string;
	toDate: string;
	// h1 on an order's own page; h2 where the page already has its h1 (the
	// order receipt under "Order placed").
	headingLevel?: 'h1' | 'h2';
}

const { orderCode, status, fromDate, toDate, headingLevel: Heading = 'h1' } = Astro.props;
---

<!--
	The order code is read aloud at the pick-up counter, so it is the largest
	thing on the card: wide-tracked, tabular, impossible to misread.
-->
<div class="flex flex-col gap-snug">
	<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
		<Heading class="flex items-baseline gap-3">
			<span class="text-base font-semibold text-text-muted">Order</span>
			<span class="tabular text-3xl font-extrabold tracking-[0.12em] text-text sm:text-4xl">{orderCode}</span>
		</Heading>
		<OrderStatusBadge status={status} />
	</div>
	<p class="text-sm text-text-muted">
		Pick-up <time datetime={fromDate} class="font-semibold text-text">{formatDateDisplay(fromDate)}</time>
		<span aria-hidden="true" class="px-1 text-border-strong">/</span>
		Return <time datetime={toDate} class="font-semibold text-text">{formatDateDisplay(toDate)}</time>
	</p>
</div>

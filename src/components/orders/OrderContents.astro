---
import ItemQtyLine from '../ui/ItemQtyLine.astro';
import ItemLine from '../ui/ItemLine.astro';
import type { Attribute } from '../../lib/attributes';

interface OrderItemView {
	itemName: string;
	requestedQuantity: number;
	itemImageUrl?: string | null;
	// Only used by the showImages layout (see src/lib/orderItemView.ts).
	attributes?: Attribute[];
	href?: string | null;
}

interface Props {
	items: OrderItemView[];
	note: string | null;
	// Renders each line as a full ItemLine (image or placeholder, linked
	// product name, variant values such as size/colour, "Qty: N") instead
	// of the plain "{name} × {qty}" text line. Used by the checkout success
	// receipt, where it helps confirm what was actually reserved (#220).
	// Defaults to false so /orders/[code].astro's text-only look is
	// unaffected.
	showImages?: boolean;
}

const { items, note, showImages = false } = Astro.props;
---

<section class="flex flex-col gap-2">
	<h2 class="text-sm font-semibold tracking-wide text-text-muted uppercase">Items</h2>
	<ul class:list={['flex flex-col text-sm text-text', showImages ? 'gap-3' : 'gap-1']}>
		{
			items.map((item) =>
				showImages ? (
					<li>
						<ItemLine
							imageUrl={item.itemImageUrl}
							name={item.itemName}
							href={item.href}
							attributes={item.attributes}
							quantity={item.requestedQuantity}
							thumbnailSize={56}
						/>
					</li>
				) : (
					<ItemQtyLine name={item.itemName} quantity={item.requestedQuantity} />
				),
			)
		}
	</ul>
	{note && <p class="text-sm text-text-muted">Note: {note}</p>}
</section>

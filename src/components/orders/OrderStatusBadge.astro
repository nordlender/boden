---
import Badge from '../ui/Badge.astro';
import type { BadgeTone } from '../../lib/badge-styles';

interface Props {
	status: string;
	class?: string;
}

const { status, class: className } = Astro.props;

// Keyed by the orders.status enum (see OrderStatus in src/lib/orderStatus.ts).
const toneByStatus: Record<string, BadgeTone> = {
	requested: 'warning',
	scheduled: 'info',
	active: 'success',
	returned: 'neutral',
	rejected: 'error',
};
const tone = toneByStatus[status] ?? 'neutral';
---

<Badge tone={tone} class:list={['capitalize', className]}>{status}</Badge>

---
import Badge from '../ui/Badge.astro';
import type { BadgeTone } from '../../lib/badge-styles';
import { ORDER_STATUS_LABELS, isOrderStatus } from '../../lib/orderStatus';

interface Props {
	status: string;
	class?: string;
}

const { status, class: className } = Astro.props;

// Keyed by the orders.status enum (see OrderStatus in src/lib/orderStatus.ts).
const toneByStatus: Record<string, BadgeTone> = {
	requested: 'warning',
	scheduled: 'info',
	active: 'success',
	returned: 'neutral',
	rejected: 'error',
	no_show: 'error',
};
const tone = toneByStatus[status] ?? 'neutral';
const label = isOrderStatus(status) ? ORDER_STATUS_LABELS[status] : status;
---

<Badge tone={tone} class:list={['capitalize', className]}>{label}</Badge>

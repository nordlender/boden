---
interface Props {
	status: string;
	class?: string;
}

const { status, class: className } = Astro.props;

// src/db/schema.ts's orders.status enum: 'requested' | 'active' | 'returned' | 'rejected'.
// Written out in full (not built from `status`) so Tailwind's class scanner can see them.
const badgeClasses: Record<string, string> = {
	requested: 'bg-warning-subtle border-warning-border text-warning-text',
	active: 'bg-success-subtle border-success-border text-success-text',
	returned: 'bg-bg-subtle border-border text-text-muted',
	rejected: 'bg-error-subtle border-error-border text-error-text',
};
const badgeClass = badgeClasses[status] ?? 'bg-bg-subtle border-border text-text-muted';
---

<span class:list={['rounded-full border px-2 py-0.5 text-xs font-medium capitalize whitespace-nowrap', badgeClass, className]}>
	{status}
</span>

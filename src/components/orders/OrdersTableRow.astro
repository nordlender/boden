---
import { formatDateDisplay } from '../../lib/dates';
import OrderStatusBadge from './OrderStatusBadge.astro';
import MorphButton from '../ui/MorphButton.astro';

interface Props {
	// orderCode, status and viewHref are omitted for an order that doesn't
	// exist yet (the /reservation/confirm preview) — the matching cells are
	// then left out and the grid collapses to dates + name.
	orderCode?: string;
	status?: string;
	fromDate: string;
	toDate: string;
	customerName: string;
	viewHref?: string;
}

const { orderCode, status, fromDate, toDate, customerName, viewHref } = Astro.props;
const isPersisted = Boolean(orderCode && status && viewHref);
---

<div class="flex flex-col gap-3 rounded-xl border border-border bg-surface px-5 py-3.5 text-sm">
	<!--
		DOM order is the sm+ column order (status, dates, customer, code, view),
		so reading and focus order match what's on screen at every width. The
		stacked mobile layout — status + view, then customer, then dates + code
		— comes from explicit max-sm: grid placements, not CSS `order`. A preview
		(no order yet) drops status/code/view and keeps dates + customer.
	-->
	<div
		class:list={[
			'grid grid-cols-2 items-center gap-x-4 gap-y-2 sm:gap-y-0',
			isPersisted ? 'sm:grid-cols-[5rem_1fr_1fr_auto_auto]' : 'sm:grid-cols-[1fr_1fr]',
		]}
	>
		{
			isPersisted && (
				<div class="w-20">
					<OrderStatusBadge status={status!} />
				</div>
			)
		}
		<span class="text-text-muted max-sm:col-start-1 max-sm:row-start-3">{formatDateDisplay(fromDate)} &ndash; {formatDateDisplay(toDate)}</span>
		<span class="truncate font-medium text-text max-sm:col-span-2 max-sm:row-start-2">{customerName}</span>
		{isPersisted && <span class="font-mono text-text-muted max-sm:col-start-2 max-sm:row-start-3 max-sm:justify-self-end">#{orderCode}</span>}
		{
			isPersisted && (
				<MorphButton
					href={viewHref!}
					label={`View order #${orderCode}`}
					action="view"
					class="max-sm:col-start-2 max-sm:row-start-1 max-sm:justify-self-end"
				/>
			)
		}
	</div>
	<slot />
</div>

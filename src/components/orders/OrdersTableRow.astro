---
import { formatDateDisplay } from '../../lib/dates';
import OrderStatusBadge from './OrderStatusBadge.astro';
import MorphButton from '../ui/MorphButton.astro';

interface Props {
	// orderCode, status and viewHref are omitted for an order that doesn't
	// exist yet (the /reservation/confirm preview) — the matching cells are
	// then left out and the grid collapses to dates + name.
	orderCode?: string;
	status?: string;
	fromDate: string;
	toDate: string;
	customerName: string;
	viewHref?: string;
}

const { orderCode, status, fromDate, toDate, customerName, viewHref } = Astro.props;
const isPersisted = Boolean(orderCode && status && viewHref);
---

<div class="flex flex-col gap-2 rounded-md border border-border px-3 py-2 text-sm">
	<div
		class:list={[
			'grid grid-cols-2 items-center gap-x-3 gap-y-1 sm:gap-y-0',
			isPersisted ? 'sm:grid-cols-[5rem_1fr_1fr_auto_auto]' : 'sm:grid-cols-[1fr_1fr]',
		]}
	>
		{
			isPersisted && (
				<>
					<div class="order-1 w-20">
						<OrderStatusBadge status={status!} />
					</div>
					<MorphButton
						href={viewHref!}
						label={`View order #${orderCode}`}
						action="view"
						class="order-2 justify-self-end sm:order-5 sm:justify-self-auto"
					/>
				</>
			)
		}
		<span class="order-3 col-span-2 truncate font-medium text-text sm:order-3 sm:col-span-1">{customerName}</span>
		<span class="order-4 text-text-muted sm:order-2">{formatDateDisplay(fromDate)} &ndash; {formatDateDisplay(toDate)}</span>
		{isPersisted && <span class="order-5 justify-self-end font-mono text-text-muted sm:order-4 sm:justify-self-auto">#{orderCode}</span>}
	</div>
	<slot />
</div>

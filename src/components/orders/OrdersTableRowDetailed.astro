---
import { formatDateDisplay } from '../../lib/dates';
import OrderStatusBadge from './OrderStatusBadge.astro';

interface OrderRowItem {
	itemName: string;
	requestedQuantity: number;
}

interface Props {
	orderCode: string;
	status: string;
	fromDate: string;
	toDate: string;
	customerName: string;
	items: OrderRowItem[];
	viewHref: string;
}

const { orderCode, status, fromDate, toDate, customerName, items, viewHref } = Astro.props;
---

<div class="flex flex-col gap-3 rounded-md border border-border p-3 text-sm">
	<div class="flex flex-wrap items-center justify-between gap-2">
		<div class="flex flex-wrap items-center gap-3">
			<OrderStatusBadge status={status} />
			<span class="text-text-muted">{formatDateDisplay(fromDate)} &ndash; {formatDateDisplay(toDate)}</span>
			<span class="font-medium text-text">{customerName}</span>
			<span class="font-mono text-text-muted">#{orderCode}</span>
		</div>
		<a href={viewHref} class="rounded-md border border-border px-3 py-1.5 text-sm font-medium text-text hover:bg-bg-subtle">
			View order
		</a>
	</div>
	<ul class="flex flex-col gap-1 pl-1 text-text-muted">
		{
			items.map((item) => (
				<li>
					{item.itemName} &times; {item.requestedQuantity}
				</li>
			))
		}
	</ul>
</div>

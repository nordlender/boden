---
import { formatPickupWindow, type PickupWindowDisplay } from '../../lib/pickupWindowFormat';

interface Props {
	windows: PickupWindowDisplay[];
}

const { windows } = Astro.props;
---

{
	windows.length > 0 && (
		<div class="text-sm text-text-muted">
			<p class="font-medium text-text">Pick-up time &amp; place</p>
			<ul class="mt-1 list-inside list-disc">
				{windows.map((window) => <li>{formatPickupWindow(window)}</li>)}
			</ul>
		</div>
	)
}

---
// Member-facing view of the checkout contact snapshot (schema.ts's
// orders.contactName/contactEmail/contactMobile). Only the name is shown
// here — email/mobile are persisted on the order for future admin/moderator
// visibility but are intentionally omitted from this page for privacy.
interface Props {
	contactName: string;
}

const { contactName } = Astro.props;
---

<section class="flex flex-col gap-1">
	<h2 class="text-sm font-semibold tracking-wide text-text-muted uppercase">Submitted by</h2>
	<p class="text-sm text-text">{contactName}</p>
</section>

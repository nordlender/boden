---
import OrderCodeHeader from './OrderCodeHeader.astro';
import OrderContents from './OrderContents.astro';
import type { OrderStatus } from '../../constants/orders';

interface OrderItemView {
	itemName: string;
	requestedQuantity: number;
	itemImageUrl?: string | null;
}

interface Props {
	orderCode: string;
	status: OrderStatus;
	fromDate: string;
	toDate: string;
	note: string | null;
	items: OrderItemView[];
	showImages?: boolean;
}

const { orderCode, status, fromDate, toDate, note, items, showImages = false } = Astro.props;
---

<section class="order-summary flex flex-col gap-4">
	<OrderCodeHeader orderCode={orderCode} status={status} fromDate={fromDate} toDate={toDate} />
	<OrderContents items={items} note={note} showImages={showImages} />
</section>

---
// Date-range picker for the reservation page. Cally
// (https://github.com/WickyNilliams/cally) ships a <calendar-range> custom
// element with no imposed styling — the `::part()` rules below are what
// make it look like the rest of the site (same semantic theme tokens,
// rounded corners, same font as everything else). The shared part of that
// theme lives in global.css under `.cally-theme`; only this calendar's own
// availability/selection colors are below.
//
// `import 'cally'` (which registers the custom elements) lives in the
// <script> block below, NOT in this frontmatter — Astro's frontmatter runs
// server-side only and is never shipped to the browser, so a side-effect
// import up here would leave the client with an inert <calendar-range> that
// never upgrades. The <script> block is compiled as a real client module,
// which is where the registration needs to happen.
interface Props {
	// Time + place windows per pick-up date (see src/lib/pickupDays.ts). Every
	// date that has one is a pick-up day (first day of the range — see
	// src/db/schema.ts's orders.fromDate) and is colored green; everything
	// else keeps the default "request pick up" styling. The selected pick-up
	// day's windows are listed under the range summary. Unset (reschedule
	// modal) colors and shows none.
	pickupWindows?: Record<string, PickupWindowDisplay[]>;
	// Preselects an existing range — "YYYY-MM-DD/YYYY-MM-DD", same shape as
	// this component's own `change` event value. Used by the reschedule flow
	// (ChangeOrderLink.astro) to open the calendar already showing the
	// order's current dates; unset for a fresh pick (the /reservation page).
	value?: string;
}

import { todayIsoInOslo } from '../../lib/dates';
import CallyLegend from '../ui/CallyLegend.astro';
import CallyNavIcons from '../ui/CallyNavIcons.astro';
import type { PickupWindowDisplay } from '../../lib/pickupWindowFormat';

const { pickupWindows = {}, value } = Astro.props;
// Europe/Oslo's today, not the server host's — see src/lib/dates.ts.
const todayIso = todayIsoInOslo();
---

<div class="reservation-calendar cally-theme rounded-xl border border-border bg-surface p-card">
	<CallyLegend
		items={[
			{ label: 'Pick up available', swatch: 'bg-success-subtle ring-1 ring-inset ring-success-border' },
			{ label: 'Request pick up', swatch: 'border border-border-strong' },
		]}
	/>

	<calendar-range
		data-reservation-calendar
		months={2}
		page-by="single"
		min={todayIso}
		value={value}
		data-pickup-windows={JSON.stringify(pickupWindows)}
	>
		<CallyNavIcons />
		<calendar-month></calendar-month>
		<calendar-month offset={1}></calendar-month>
	</calendar-range>

	<p class="mt-stack text-sm text-text-muted">
		<span data-range-summary>Select a pick-up and return date.</span>
	</p>
	<ul data-pickup-windows-list hidden class="mt-1 list-inside list-disc text-sm text-text-muted"></ul>
</div>

<style>
	/* Day-level parts live on <calendar-month> (light DOM, no exportparts), so
	   they are targeted there — `calendar-range::part()` only reaches the
	   header and prev/next buttons. Base day styling is in global.css. */

	/* Availability tint — declared before range-start/range-end/range-inner
	   below so an actual selection always visually wins over it. */
	.reservation-calendar calendar-range calendar-month::part(pickup-available) {
		background-color: var(--color-success-subtle);
		box-shadow: inset 0 0 0 1px var(--color-success-border);
		color: var(--color-success-text);
	}

	/* Selected range: one continuous band. Start/end are solid and rounded on
	   their outer side only, inner days are a square tint, so adjacent cells
	   join with no gaps (day buttons fill their cell — see global.css). A
	   one-day or half-picked range (start and end the same cell) is a fully
	   rounded box. Where the band wraps at a week boundary (Monday = day-1 is
	   the first column, Sunday = day-0 the last) the cell on the wrap is
	   rounded too, so each row's segment has finished ends.
	   box-shadow: none drops the availability tint's inset border. */
	.reservation-calendar calendar-range calendar-month::part(range-inner),
	.reservation-calendar calendar-range calendar-month::part(range-start),
	.reservation-calendar calendar-range calendar-month::part(range-end) {
		box-shadow: none;
	}

	.reservation-calendar calendar-range calendar-month::part(range-inner) {
		border-radius: 0;
		background-color: var(--color-accent-subtle);
		color: var(--color-accent-text);
	}

	.reservation-calendar calendar-range calendar-month::part(range-inner day-1) {
		border-radius: 0.375rem 0 0 0.375rem;
	}

	.reservation-calendar calendar-range calendar-month::part(range-inner day-0) {
		border-radius: 0 0.375rem 0.375rem 0;
	}

	.reservation-calendar calendar-range calendar-month::part(range-start),
	.reservation-calendar calendar-range calendar-month::part(range-end) {
		background-color: var(--color-accent);
		color: var(--color-text-inverted);
	}

	.reservation-calendar calendar-range calendar-month::part(range-start) {
		border-radius: 0.375rem 0 0 0.375rem;
	}

	.reservation-calendar calendar-range calendar-month::part(range-end) {
		border-radius: 0 0.375rem 0.375rem 0;
	}

	.reservation-calendar calendar-range calendar-month::part(range-start day-0),
	.reservation-calendar calendar-range calendar-month::part(range-end day-1),
	.reservation-calendar calendar-range calendar-month::part(range-start range-end) {
		border-radius: 0.375rem;
	}
</style>

<script>
	import 'cally';
	import { formatDateDisplay, dateToIsoInOslo } from '../../lib/dates';
	import { formatPickupWindow, type PickupWindowDisplay } from '../../lib/pickupWindowFormat';

	type RangeCalendar = HTMLElement & {
		value?: string;
		getDayParts?: (date: Date) => string;
	};

	const calendar = document.querySelector<RangeCalendar>('[data-reservation-calendar]');
	const summary = document.querySelector<HTMLElement>('[data-range-summary]');
	const windowsList = document.querySelector<HTMLElement>('[data-pickup-windows-list]');

	let pickupWindows: Record<string, PickupWindowDisplay[]> = {};
	try {
		pickupWindows = JSON.parse(calendar?.dataset.pickupWindows ?? '{}');
	} catch {
		// No windows listed — the summary still works without them.
	}

	if (calendar) {
		// Every date with a window is a pick-up day.
		const availableDates = new Set(Object.keys(pickupWindows));

		// Cally hands `getDayParts` a local-midnight Date for each rendered
		// cell — deriving its date string via toISOString() (UTC) shifted the
		// match by a day for CET/CEST viewers (#50). dateToIsoInOslo reads the
		// wall-clock date in Europe/Oslo instead, matching the pickupWindows
		// keys (also Oslo-anchored — see src/lib/pickupDays.ts) regardless of
		// the viewer's own device timezone.
		calendar.getDayParts = (date) => (availableDates.has(dateToIsoInOslo(date)) ? 'pickup-available' : '');
	}

	// Lists the time + place of the selected pick-up day's windows under the
	// summary; hidden when no day is selected or it has none on record.
	function renderPickupWindows(from: string | undefined) {
		if (!windowsList) return;
		const windows = from ? (pickupWindows[from] ?? []) : [];
		windowsList.replaceChildren(
			...windows.map((window) => {
				const li = document.createElement('li');
				li.textContent = formatPickupWindow(window);
				return li;
			}),
		);
		windowsList.hidden = windows.length === 0;
	}

	// Fires once the calendar first upgrades even with a preselected `value`
	// and no user interaction yet — show that preselection in the summary.
	if (calendar?.value) {
		const [initialFrom, initialTo] = calendar.value.split('/').filter(Boolean);
		if (summary && initialFrom && initialTo) {
			summary.textContent = `Pick-up ${formatDateDisplay(initialFrom)} · Return ${formatDateDisplay(initialTo)}`;
		}
		// Back-navigation from /reservation/confirm can restore the range.
		renderPickupWindows(initialFrom && initialTo ? initialFrom : undefined);
	}

	calendar?.addEventListener('change', () => {
		// Cally's <calendar-range> reports the selection as a single
		// slash-separated `value` string ("YYYY-MM-DD/YYYY-MM-DD") once both
		// ends are picked — confirmed against cally's source (the `value`
		// hook calendar-range uses joins with "/", unlike calendar-multi's
		// space-separated one). Splitting on whitespace here left `to`
		// undefined on every real selection, which silently reset the whole
		// form back to its unselected state instead of ever calling
		// /api/reservation/availability.
		const value = calendar.value ?? '';
		const [from, to] = value.split('/').filter(Boolean);

		if (summary) {
			summary.textContent = from && to ? `Pick-up ${formatDateDisplay(from)} · Return ${formatDateDisplay(to)}` : 'Select a pick-up and return date.';
		}

		renderPickupWindows(from && to ? from : undefined);

		calendar.dispatchEvent(new CustomEvent('reservation-range-change', { bubbles: true, detail: { from, to } }));
	});
</script>

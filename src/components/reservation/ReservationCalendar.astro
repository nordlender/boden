---
// Date-range picker for the reservation page. Cally
// (https://github.com/WickyNilliams/cally) ships a <calendar-range> custom
// element with no imposed styling — the `::part()` rules below are what
// make it look like the rest of the site (gray-900/gray-200 palette,
// rounded corners, same font as everything else).
//
// Note which host each ::part() rule hangs off: <calendar-range>'s own
// shadow root only contains the header (prev/next buttons, heading) and a
// <slot part="months">. The days live in <calendar-month>'s shadow root,
// and the two <calendar-month> elements below are light-DOM *children* of
// <calendar-range>, not part of its shadow tree — so day-level parts have to
// be addressed as `calendar-month::part(...)`. See the <style> block.
//
// `import 'cally'` (which registers the custom elements) lives in the
// <script> block below, NOT in this frontmatter — Astro's frontmatter runs
// server-side only and is never shipped to the browser, so a side-effect
// import up here would leave the client with an inert <calendar-range> that
// never upgrades. The <script> block is compiled as a real client module,
// which is where the registration needs to happen.
interface Props {
	// Pick-up days (first day of the range — see src/db/schema.ts's
	// orders.fromDate) with a moderator confirmed available to hand out
	// orders, per src/lib/pickupDays.ts. Colored green in the calendar;
	// everything else is left at the default "request pick up" styling.
	availablePickupDates?: string[];
}

const { availablePickupDates = [] } = Astro.props;
const todayIso = new Date().toISOString().slice(0, 10);
---

<div class="reservation-calendar rounded-lg border border-gray-200 bg-white p-3">
	<ul class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-600">
		<li class="flex items-center gap-1.5">
			<span class="h-3 w-3 rounded-full bg-green-100 ring-1 ring-inset ring-green-400" aria-hidden="true"></span>
			Pick up available
		</li>
		<li class="flex items-center gap-1.5">
			<span class="h-3 w-3 rounded-full border border-gray-300" aria-hidden="true"></span>
			Request pick up
		</li>
	</ul>

	<calendar-range
		data-reservation-calendar
		months={2}
		page-by="single"
		min={todayIso}
		data-available-pickup-dates={JSON.stringify(availablePickupDates)}
	>
		<svg slot="previous" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M15 6l-6 6l6 6" />
		</svg>
		<svg slot="next" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M9 6l6 6l-6 6" />
		</svg>
		<calendar-month></calendar-month>
		<calendar-month offset={1}></calendar-month>
	</calendar-range>

	<p class="mt-2 text-sm text-gray-600">
		<span data-range-summary>Select a pick-up and return date.</span>
	</p>
</div>

<style>
	.reservation-calendar calendar-range {
		--color-accent: var(--color-gray-900);
		/* Corner radius of a day cell. Inherits down into <calendar-month>'s
		   shadow tree (custom properties cross shadow boundaries), which is
		   how the range-rounding rules further down get at it. */
		--day-radius: 0.375rem;
		display: block;
		width: 100%;
		font-family: inherit;
		font-size: 0.875rem;
	}

	/* Cally's shadow DOM renders ::part(container) (column flex: the
	   header — prev/next/heading — above ::part(months), the <slot> the two
	   <calendar-month> children below land in) and both parts default to a
	   content-fit width, not a stretched one. Widen everything to fill this
	   card, and only flip ::part(months) to a row on desktop — the header
	   always stays above regardless of viewport. */
	.reservation-calendar calendar-range::part(container),
	.reservation-calendar calendar-range::part(header) {
		width: 100%;
	}

	.reservation-calendar calendar-range::part(months) {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
	}

	.reservation-calendar calendar-range calendar-month {
		/* Repeated here, not just on <calendar-range>: cally's own
		   `:host { --color-accent: black }` inside <calendar-month> beats a
		   value that's merely inherited from the parent, so the accent has to
		   be set on the month element itself to take. */
		--color-accent: var(--color-gray-900);
		width: 100%;
	}

	@media (min-width: 48rem) {
		.reservation-calendar calendar-range::part(months) {
			flex-direction: row;
		}

		.reservation-calendar calendar-range calendar-month {
			width: auto;
			min-width: 0;
			flex: 1 1 0%;
		}
	}

	/* The prev/next chevrons — these really do live in <calendar-range>'s own
	   shadow root (part="button previous" / "button next"), so this host is
	   correct here. Everything day-level below hangs off <calendar-month>
	   instead. */
	.reservation-calendar calendar-range::part(button) {
		border-radius: 0.375rem;
		color: var(--color-gray-600);
	}

	.reservation-calendar calendar-range::part(button):hover {
		background-color: var(--color-gray-100);
	}

	/* ------------------------------------------------------------------
	   Day cells.

	   These were previously written as `calendar-range::part(day)` and so on,
	   which matched nothing: ::part() only reaches into the shadow tree of
	   the element it's attached to, the <calendar-month> children are slotted
	   light DOM rather than part of <calendar-range>'s shadow tree, and cally
	   sets no exportparts. The only reason a selected range showed up at all
	   was cally's own `button:is([aria-pressed=true]) { background:
	   var(--color-accent) }`, which paints every day of the range — endpoints
	   and interior alike — the same flat accent color.

	   <calendar-month> is itself a shadow host sitting in this document, so
	   `calendar-month::part(...)` reaches its days. Normal declarations from
	   the outer tree beat the component's own shadow styles regardless of
	   specificity, so these override cally's built-ins without !important.
	   ------------------------------------------------------------------ */

	.reservation-calendar calendar-month::part(head) {
		font-weight: 600;
		color: var(--color-gray-900);
	}

	/* Cally hard-codes each day button to 2.25rem square and only zeroes the
	   UA's *inline* td padding (`td { padding-inline: 0 }`). Because the
	   months are stretched to fill this card, each column ends up around 50px
	   wide, so a 36px button floats in the middle of it with ~7px of dead
	   space on either side; vertically, the UA's 1px block padding plus the
	   baseline descender under an inline-block button add a few more. That
	   dead space is the "gap" between selected days. Letting each day fill
	   its cell edge to edge removes it, so a range can paint as one bar. */
	.reservation-calendar calendar-month::part(td) {
		padding: 0;
	}

	.reservation-calendar calendar-month::part(button) {
		display: flex;
		align-items: center;
		justify-content: center;
		inline-size: 100%;
		block-size: 2.25rem;
		border-radius: var(--day-radius);
	}

	.reservation-calendar calendar-month::part(today) {
		font-weight: 700;
	}

	/* Availability tint — declared before range-start/range-end/range-inner
	   below so an actual selection always visually wins over it. */
	.reservation-calendar calendar-month::part(pickup-available) {
		background-color: var(--color-green-50);
		box-shadow: inset 0 0 0 1px var(--color-green-300);
		color: var(--color-green-800);
	}

	.reservation-calendar calendar-month::part(range-inner) {
		background-color: var(--color-gray-100);
		color: var(--color-gray-900);
		/* The green ring above is a box-shadow, not a background, so it isn't
		   overridden by the background-color rules here — left in place it
		   would draw an outline around individual days in the middle of the
		   range and break the bar back up into chips. */
		box-shadow: none;
	}

	.reservation-calendar calendar-month::part(range-start),
	.reservation-calendar calendar-month::part(range-end) {
		background-color: var(--color-gray-900);
		color: white;
		box-shadow: none;
	}

	/* ------------------------------------------------------------------
	   Range corner rounding.

	   A contiguous selection should read as a single pill: rounded only where
	   the range genuinely ends, square at every seam where two selected days
	   touch. All of these selectors have identical specificity (the idents
	   inside ::part() don't add any), so the cascade here is pure source
	   order — general rules first, edge cases after.

	   Logical corner properties keep this right under RTL: cally sorts the
	   range so range-start is always the earlier date, which is the
	   inline-start side in both writing directions.
	   ------------------------------------------------------------------ */

	.reservation-calendar calendar-month::part(range-inner) {
		border-radius: 0;
	}

	.reservation-calendar calendar-month::part(range-start) {
		border-start-end-radius: 0;
		border-end-end-radius: 0;
	}

	.reservation-calendar calendar-month::part(range-end) {
		border-start-start-radius: 0;
		border-end-start-radius: 0;
	}

	/* …except where the bar physically can't continue. A week row wraps, and
	   each month is its own <table>, so a range that crosses either boundary
	   has to be capped there rather than left looking sheared off.

	   day-1/day-0 are cally's own per-weekday parts (0 = Sunday), so with its
	   default firstDayOfWeek of 1 those are the first and last columns.
	   month-start/month-end come from our getDayParts hook in the <script>
	   below, since cally has no part for "first/last day of this month". */
	.reservation-calendar calendar-month::part(range-inner day-1),
	.reservation-calendar calendar-month::part(range-inner month-start),
	.reservation-calendar calendar-month::part(range-end day-1),
	.reservation-calendar calendar-month::part(range-end month-start) {
		border-start-start-radius: var(--day-radius);
		border-end-start-radius: var(--day-radius);
	}

	.reservation-calendar calendar-month::part(range-inner day-0),
	.reservation-calendar calendar-month::part(range-inner month-end),
	.reservation-calendar calendar-month::part(range-start day-0),
	.reservation-calendar calendar-month::part(range-start month-end) {
		border-start-end-radius: var(--day-radius);
		border-end-end-radius: var(--day-radius);
	}

	/* Between the first and second click cally reports the tentative range as
	   [d, d], so one day carries both endpoint parts. Last rule wins, so this
	   also re-rounds a single-day range that happens to sit in the first or
	   last column. */
	.reservation-calendar calendar-month::part(range-start range-end) {
		border-radius: var(--day-radius);
	}
</style>

<script>
	import 'cally';

	type RangeCalendar = HTMLElement & {
		value?: string;
		getDayParts?: (date: Date) => string;
	};

	const calendar = document.querySelector<RangeCalendar>('[data-reservation-calendar]');
	const summary = document.querySelector<HTMLElement>('[data-range-summary]');

	if (calendar) {
		let availableDates: Set<string>;
		try {
			availableDates = new Set(JSON.parse(calendar.dataset.availablePickupDates ?? '[]'));
		} catch {
			availableDates = new Set();
		}

		// Extra ::part() names for each day, consumed by the <style> block above.
		// Cally already exposes `day-0`…`day-6` (weekday column) but nothing for
		// "first/last day of this month", and a selected range needs to be
		// rounded off at a month boundary too — each <calendar-month> is its own
		// <table>, so the range bar can't visually continue past the 1st or the
		// last of the month even though the range itself does.
		calendar.getDayParts = (date) => {
			const parts = [];

			if (availableDates.has(date.toISOString().slice(0, 10))) parts.push('pickup-available');

			// getDayParts is handed a UTC-based Date (same basis as the ISO
			// slicing above), so the UTC accessors are the correct ones here.
			if (date.getUTCDate() === 1) parts.push('month-start');

			const nextDay = new Date(date.getTime());
			nextDay.setUTCDate(nextDay.getUTCDate() + 1);
			if (nextDay.getUTCDate() === 1) parts.push('month-end');

			return parts.join(' ');
		};
	}

	function formatDisplay(value: string) {
		return new Date(`${value}T00:00:00`).toLocaleDateString(undefined, {
			month: 'short',
			day: 'numeric',
			year: 'numeric',
		});
	}

	calendar?.addEventListener('change', () => {
		// Cally's <calendar-range> reports the selection as a single
		// slash-separated `value` string ("YYYY-MM-DD/YYYY-MM-DD") once both
		// ends are picked — confirmed against cally's source (the `value`
		// hook calendar-range uses joins with "/", unlike calendar-multi's
		// space-separated one). Splitting on whitespace here left `to`
		// undefined on every real selection, which silently reset the whole
		// form back to its unselected state instead of ever calling
		// /api/reservation/availability.
		const value = calendar.value ?? '';
		const [from, to] = value.split('/').filter(Boolean);

		if (summary) {
			summary.textContent = from && to ? `Pick-up ${formatDisplay(from)} · Return ${formatDisplay(to)}` : 'Select a pick-up and return date.';
		}

		calendar.dispatchEvent(new CustomEvent('reservation-range-change', { bubbles: true, detail: { from, to } }));
	});
</script>

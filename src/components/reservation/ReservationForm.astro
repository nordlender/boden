---
import ReservationCalendar from './ReservationCalendar.astro';
import ReservationItemRow from './ReservationItemRow.astro';
import CheckoutForm from '../cart/CheckoutForm.astro';
import { entryKey, type CartLine } from '../../lib/cart';
import { formatAttributes } from '../../lib/attributes';
import type { PickupWindowDisplay } from '../../lib/pickupWindowFormat';
import type { ReservationCartLineRef } from './reservationFormState';
import Callout from '../ui/Callout.astro';
import { sectionTitleClasses } from '../../lib/layout-styles';

interface Props {
	cartLines: CartLine[];
	pickupWindows: Record<string, PickupWindowDisplay[]>;
	maxRentalDays: number;
	name: string | null;
	email: string | null;
	mobile: string | null;
	hasUnpaidFees: boolean | null;
	userIsMember: boolean | null;
}

const { cartLines, pickupWindows, maxRentalDays, name, email, mobile, hasUnpaidFees, userIsMember } = Astro.props;

const lineRefs: ReservationCartLineRef[] = cartLines.map((line) =>
	'setId' in line
		? { key: entryKey({ setId: line.setId }), setId: line.setId, quantity: line.quantity }
		: { key: entryKey({ itemId: line.itemId }), itemId: line.itemId, quantity: line.quantity },
);
---

<div data-reservation-form data-cart-lines={JSON.stringify(lineRefs)} data-max-rental-days={maxRentalDays} class="flex flex-col gap-region">
	<section class="flex flex-col gap-stack">
		<h2 class={sectionTitleClasses}>1. Pick-up &amp; return dates</h2>
		<ReservationCalendar pickupWindows={pickupWindows} />
	</section>

	<section class="flex flex-col gap-stack">
		<h2 class={sectionTitleClasses}>2. Your items</h2>

		{/* One polite live region around the loading/warning/error boxes so
		    their text is announced when it changes; the Callouts inside are
		    not live themselves, to avoid nested live regions.
		    reservationFormState.ts fills in the text (#262). */}
		<div aria-live="polite" class="flex flex-col gap-stack">
			<p data-availability-loading hidden class="text-sm text-text-muted">Checking availability…</p>
			<div data-over-max-warning hidden>
				<Callout variant="warning" title="Longer than the maximum rental period" live={false}>
					<p data-over-max-warning-text></p>
				</Callout>
			</div>
			<div data-unavailable-warning hidden>
				<Callout variant="warning" live={false}>
					<p data-unavailable-warning-text></p>
				</Callout>
			</div>
			<div data-availability-error hidden>
				<Callout variant="error" live={false}>
					<p data-availability-error-text></p>
				</Callout>
			</div>
		</div>

		<div class="divide-y divide-border border-y border-border">
			{
				cartLines.map((line) =>
					'setId' in line ? (
						<ReservationItemRow
							kind="set"
							id={line.setId}
							productSlug={line.productSlug}
							productTitle={line.productTitle}
							imageUrl={line.imageUrl}
							quantity={line.quantity}
							subtitle={line.label}
							components={line.children}
						/>
					) : (
						<ReservationItemRow
							kind="item"
							id={line.itemId}
							productSlug={line.productSlug}
							productTitle={line.productTitle}
							imageUrl={line.imageUrl}
							quantity={line.quantity}
							subtitle={formatAttributes(line.attributes)}
						/>
					),
				)
			}
		</div>
	</section>

	<section class="flex flex-col gap-stack">
		<h2 class={sectionTitleClasses}>3. Your details</h2>
		<CheckoutForm name={name} email={email} mobile={mobile} hasUnpaidFees={hasUnpaidFees} userIsMember={userIsMember} />
		<p data-submit-hint aria-live="polite" class="text-sm text-text-muted">Select your pick-up and return dates above to continue.</p>
	</section>
</div>

<script>
	// See reservationFormState.ts for the fetch/availability/submit-state
	// logic and reservationFormRender.ts for the pure DOM rendering it calls
	// into. This tag just reads the cart lines back out of the DOM (passed
	// down as data-cart-lines, since a real module script — unlike
	// is:inline + define:vars — can't have server frontmatter values
	// injected directly) and wires everything up.
	import { initReservationForm, type ReservationCartLineRef } from './reservationFormState';

	const form = document.querySelector<HTMLElement>('[data-reservation-form]');
	const cartLines: ReservationCartLineRef[] = JSON.parse(form?.dataset.cartLines ?? '[]');
	initReservationForm(cartLines, Number(form?.dataset.maxRentalDays));
</script>

---
import ReservationCalendar from './ReservationCalendar.astro';
import ReservationItemRow from './ReservationItemRow.astro';
import CheckoutForm from '../cart/CheckoutForm.astro';
import type { CartItem } from '../../lib/cart';

interface Props {
	cartItems: CartItem[];
	availablePickupDates: string[];
	name: string | null;
	email: string | null;
	mobile: string | null;
	hasUnpaidFees: boolean | null;
	userIsMember: boolean | null;
}

const { cartItems, availablePickupDates, name, email, mobile, hasUnpaidFees, userIsMember } = Astro.props;
---

<div
	data-reservation-form
	data-cart-items={JSON.stringify(cartItems.map((item) => ({ itemId: item.itemId, quantity: item.quantity })))}
	class="flex flex-col gap-8"
>
	<section>
		<h2 class="mb-3 text-sm font-semibold tracking-wide text-gray-500 uppercase">1. Pick-up &amp; return dates</h2>
		<ReservationCalendar availablePickupDates={availablePickupDates} />
	</section>

	<section>
		<h2 class="mb-3 text-sm font-semibold tracking-wide text-gray-500 uppercase">2. Your items</h2>

		<p
			data-mixed-availability-warning
			hidden
			class="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800"
		>
			At least one of the items is not available in this timeframe. You can set up a separate order by clicking the
			split icon next to each item.
		</p>

		<p data-availability-loading hidden class="mb-4 text-sm text-gray-500">Checking availability…</p>

		<div class="divide-y divide-gray-200 border-y border-gray-200">
			{
				cartItems.map((item) => (
					<ReservationItemRow
						itemId={item.itemId}
						productSlug={item.productSlug}
						productTitle={item.productTitle}
						imageUrl={item.imageUrl}
						quantity={item.quantity}
						attributes={item.attributes}
					/>
				))
			}
		</div>
	</section>

	<section>
		<h2 class="mb-3 text-sm font-semibold tracking-wide text-gray-500 uppercase">3. Your details</h2>
		<CheckoutForm name={name} email={email} mobile={mobile} hasUnpaidFees={hasUnpaidFees} userIsMember={userIsMember} />
		<p data-submit-hint class="mt-2 text-sm text-gray-500">Select your pick-up and return dates above to continue.</p>
	</section>
</div>

<script>
	// See reservationFormState.ts for the fetch/availability/submit-state
	// logic and reservationFormRender.ts for the pure DOM rendering it calls
	// into. This tag just reads the cart items back out of the DOM (passed
	// down as data-cart-items, since a real module script — unlike
	// is:inline + define:vars — can't have server frontmatter values
	// injected directly) and wires everything up.
	import { initReservationForm } from './reservationFormState';

	const form = document.querySelector<HTMLElement>('[data-reservation-form]');
	const cartItems: { itemId: number; quantity: number }[] = JSON.parse(form?.dataset.cartItems ?? '[]');
	initReservationForm(cartItems);
</script>

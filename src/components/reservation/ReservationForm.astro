---
import ReservationCalendar from './ReservationCalendar.astro';
import CartView from '../cart/CartView.astro';
import CheckoutForm from '../cart/CheckoutForm.astro';
import type { ShownCart } from '../../lib/cart';
import type { PickupWindowDisplay } from '../../lib/pickupWindowFormat';
import Callout from '../ui/Callout.astro';
import { sectionTitleClasses } from '../../lib/layout-styles';

interface Props {
	cart: ShownCart;
	pickupWindows: Record<string, PickupWindowDisplay[]>;
	maxRentalDays: number;
	name: string | null;
	email: string | null;
	mobile: string | null;
	hasUnpaidFees: boolean | null;
	userIsMember: boolean | null;
}

const { cart, pickupWindows, maxRentalDays, name, email, mobile, hasUnpaidFees, userIsMember } = Astro.props;
---

<div data-reservation-form data-max-rental-days={maxRentalDays} class="flex flex-col gap-region">
	<section class="flex flex-col gap-stack">
		<h2 class:list={[sectionTitleClasses, 'flex items-center gap-3']}><span aria-hidden="true" class="tabular grid size-7 shrink-0 place-items-center rounded-full bg-accent text-sm font-bold text-on-accent">1</span><span><span class="sr-only">Step 1: </span>Pick-up &amp; return dates</span></h2>
		<ReservationCalendar pickupWindows={pickupWindows} />
	</section>

	<section class="flex flex-col gap-stack">
		<h2 class:list={[sectionTitleClasses, 'flex items-center gap-3']}><span aria-hidden="true" class="tabular grid size-7 shrink-0 place-items-center rounded-full bg-accent text-sm font-bold text-on-accent">2</span><span><span class="sr-only">Step 2: </span>Your items</span></h2>

		{/* One polite live region around the loading/warning/error boxes so
		    their text is announced when it changes; the Callouts inside are
		    not live themselves, to avoid nested live regions.
		    reservationFormState.ts fills in the text (#262). */}
		<div aria-live="polite" class="flex flex-col gap-stack">
			<p data-availability-loading hidden class="text-sm text-text-muted">Checking availability…</p>
			<div data-unavailable-warning hidden>
				<Callout variant="warning" live={false}>
					<p data-unavailable-warning-text></p>
				</Callout>
			</div>
			<div data-availability-error hidden>
				<Callout variant="error" live={false}>
					<p data-availability-error-text></p>
				</Callout>
			</div>
		</div>

		<CartView name="reservation" cart={cart} size="detailed" editable availability class="border-y border-border" />
	</section>

	<section class="flex flex-col gap-stack">
		<h2 class:list={[sectionTitleClasses, 'flex items-center gap-3']}><span aria-hidden="true" class="tabular grid size-7 shrink-0 place-items-center rounded-full bg-accent text-sm font-bold text-on-accent">3</span><span><span class="sr-only">Step 3: </span>Your details</span></h2>
		<CheckoutForm cart={cart} name={name} email={email} mobile={mobile} hasUnpaidFees={hasUnpaidFees} userIsMember={userIsMember} />
		<p data-submit-hint aria-live="polite" class="text-sm text-text-muted">Select your pick-up and return dates above to continue.</p>
	</section>
</div>

<script>
	// See reservationFormState.ts for the fetch/availability/submit-state
	// logic and reservationFormRender.ts for the pure DOM rendering it calls
	// into. The cart's lines come from the page's CartView (cartView.ts).
	import { initReservationForm } from './reservationFormState';

	const form = document.querySelector<HTMLElement>('[data-reservation-form]');
	const cartView = form?.querySelector<HTMLElement>('[data-cart-view="reservation"]');
	if (form && cartView) initReservationForm(cartView, Number(form.dataset.maxRentalDays));
</script>

---
import AppIcon from '../icons/AppIcon.astro';

interface Props {
	kind: 'item' | 'set';
	id: number;
	productSlug: string | null;
	productTitle: string;
	imageUrl: string | null;
	quantity: number;
	// Already-formatted per-kind subtitle text, computed by the caller — an
	// item's joined attribute values, or a set's own manually-typed label
	// (see cart.ts's CartSetLine comment on why a set has no attributes of
	// its own to join).
	subtitle: string | null;
	// Only for a set row — its resolved components, shown indented and
	// smaller underneath, read-only (never independently split/removed —
	// see cart.ts's CartSetChild).
	children?: { productTitle: string; quantityPerSet: number }[];
}

const { kind, id, productSlug, productTitle, imageUrl, quantity, subtitle, children = [] } = Astro.props;
const lineKey = `${kind}:${id}`;
---

<div data-reservation-row data-line-key={lineKey} class="py-4">
	<div class="flex flex-wrap items-center gap-4">
		<div class="h-16 w-16 shrink-0 overflow-hidden rounded bg-bg-subtle">
			{imageUrl && <img src={imageUrl} alt={productTitle} class="h-full w-full object-cover" />}
		</div>

		<div class="min-w-0 flex-1">
			<a href={productSlug ? `/products/${productSlug}` : '#'} class="font-medium text-text hover:underline">
				{productTitle}
			</a>
			{kind === 'set' && <span class="ml-2 rounded-full bg-bg-subtle px-2 py-0.5 text-[10px] font-medium text-text-muted">Set</span>}
			{subtitle && <p class="text-sm text-text-muted">{subtitle}</p>}
			<p class="text-sm text-text-muted">Qty: {quantity}</p>
		</div>

		<p data-availability-badge class="hidden rounded-full px-2 py-0.5 text-xs font-medium"></p>

		<p data-split-tag hidden class="rounded-full bg-accent px-2 py-0.5 text-xs font-medium text-text-inverted">
			Separate order
		</p>

		<button
			type="button"
			data-split-order-button
			hidden
			aria-pressed="false"
			title="Move this item to a separate order"
			class="shrink-0 rounded-md border border-border-strong p-1.5 text-text-muted hover:bg-bg-subtle hover:text-text aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-text-inverted"
		>
			<AppIcon name="splitOrder" size={16} />
			<span class="sr-only">Move {productTitle} to a separate order</span>
		</button>
	</div>

	{kind === 'set' && children.length > 0 && (
		<ul class="mt-3 ml-20 flex flex-col gap-0.5 border-l border-border pl-3 text-xs text-text-muted">
			{children.map((child) => {
				const totalQuantity = child.quantityPerSet * quantity;
				return (
					<li>
						{totalQuantity > 1 ? `${totalQuantity}× ` : ''}
						{child.productTitle}
					</li>
				);
			})}
		</ul>
	)}
</div>

---
import ItemLine from '../ui/ItemLine.astro';

interface Props {
	itemId: number;
	productSlug: string | null;
	productTitle: string;
	imageUrl: string | null;
	quantity: number;
	attributes: { key: string; value: string }[];
}

const { itemId, productSlug, productTitle, imageUrl, quantity, attributes } = Astro.props;
---

<div data-reservation-row data-item-id={itemId} class="py-4">
	<ItemLine
		imageUrl={imageUrl}
		name={productTitle}
		href={productSlug ? `/products/${productSlug}` : null}
		attributes={attributes}
		quantity={quantity}
		thumbnailSize={64}
		gap="lg"
		class="flex-wrap"
	>
		<Fragment slot="badge">
			<p data-availability-badge hidden class="rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap"></p>
		</Fragment>

		<Fragment slot="action">
			<button
				type="button"
				data-remove-item-button
				hidden
				title="Remove this item from your cart"
				class="shrink-0 rounded-md border border-border-strong px-2 py-1 text-sm text-text-muted hover:bg-bg-subtle hover:text-text"
			>
				Remove
				<span class="sr-only">{productTitle} from your cart</span>
			</button>
		</Fragment>
	</ItemLine>
</div>

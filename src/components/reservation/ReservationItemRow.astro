---
import AppIcon from '../icons/AppIcon.astro';

interface Props {
	itemId: number;
	productSlug: string | null;
	productTitle: string;
	imageUrl: string | null;
	quantity: number;
	attributes: { key: string; value: string }[];
	// Non-null when this row's entire quantity came from one bundled set
	// (see src/lib/cart.ts's CartItem.setId doc comment) — shows a badge and
	// suppresses the split-order button below: splitting a single item out
	// of a kit while leaving the rest in the main order would create an
	// order with only part of the kit, which this app never wants to
	// produce (see GitHub issue #61's "a kit is atomic" design decision).
	// Not yet built: reducing the *whole kit's* quantity as one unit the way
	// a single item's quantity can be reduced — for now, an unavailable kit
	// blocks submission until dates change or the kit is removed from the
	// cart. Flagged as a v2 follow-up, not silently degraded.
	setTitle?: string | null;
}

const { itemId, productSlug, productTitle, imageUrl, quantity, attributes, setTitle = null } = Astro.props;
---

<div data-reservation-row data-item-id={itemId} data-in-set={setTitle ? '1' : undefined} class="flex flex-wrap items-center gap-4 py-4">
	<div class="h-16 w-16 shrink-0 overflow-hidden rounded bg-gray-100">
		{imageUrl && <img src={imageUrl} alt={productTitle} class="h-full w-full object-cover" />}
	</div>

	<div class="min-w-0 flex-1">
		<a href={productSlug ? `/products/${productSlug}` : '#'} class="font-medium text-gray-900 hover:underline">
			{productTitle}
		</a>
		{attributes.length > 0 && <p class="text-sm text-gray-500">{attributes.map((a) => a.value).join(' / ')}</p>}
		<p class="text-sm text-gray-500">Qty: {quantity}</p>
	</div>

	{setTitle && (
		<p class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">Part of: {setTitle}</p>
	)}

	<p data-availability-badge class="hidden rounded-full px-2 py-0.5 text-xs font-medium"></p>

	<p data-split-tag hidden class="rounded-full bg-gray-900 px-2 py-0.5 text-xs font-medium text-white">
		Separate order
	</p>

	<button
		type="button"
		data-split-order-button
		hidden
		aria-pressed="false"
		title="Move this item to a separate order"
		class="shrink-0 rounded-md border border-gray-300 p-1.5 text-gray-500 hover:bg-gray-50 hover:text-gray-900 aria-pressed:border-gray-900 aria-pressed:bg-gray-900 aria-pressed:text-white"
	>
		<AppIcon name="splitOrder" size={16} />
		<span class="sr-only">Move {productTitle} to a separate order</span>
	</button>
</div>

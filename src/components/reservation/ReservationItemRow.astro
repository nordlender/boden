---
import ItemLine from '../ui/ItemLine.astro';
import Badge from '../ui/Badge.astro';
import SetChildrenList from '../cart/SetChildrenList.astro';
import { badgeBaseClasses } from '../../lib/badge-styles';
import { baseClasses, sizeClasses, variantClasses } from '../../lib/button-styles';

interface Props {
	kind: 'item' | 'set';
	id: number;
	productSlug: string | null;
	productTitle: string;
	imageUrl: string | null;
	quantity: number;
	// Already-formatted per-kind subtitle text, computed by the caller — an
	// item's joined attribute values, or a set's own manually-typed label
	// (see cart.ts's CartSetLine comment on why a set has no attributes of
	// its own to join).
	subtitle: string | null;
	// Only for a set row — its resolved components, shown indented and
	// smaller underneath, read-only (never independently removed —
	// see cart.ts's CartSetChild).
	components?: { productTitle: string; quantityPerSet: number }[];
	// Display-only (the confirm step): no availability badge, remove button or
	// form-state hooks, and the product link opens in a new tab so the member
	// doesn't leave a page whose form values only live in this POST response.
	readonly?: boolean;
}

const { kind, id, productSlug, productTitle, imageUrl, quantity, subtitle, components = [], readonly = false } = Astro.props;
const lineKey = `${kind}:${id}`;
---

<div data-reservation-row={readonly ? undefined : ''} data-line-key={readonly ? undefined : lineKey} class="py-5">
	<ItemLine
		imageUrl={imageUrl}
		name={productTitle}
		href={productSlug ? `/products/${productSlug}` : null}
		subtitle={subtitle}
		quantity={quantity}
		thumbnailSize={64}
		gap="lg"
		newTab={readonly}
		class="flex-wrap"
	>
		{kind === 'set' && <Badge class="mt-0.5 self-start">Set</Badge>}
		{
			!readonly && (
				<Fragment slot="badge">
					<p data-availability-badge hidden class={badgeBaseClasses} />
				</Fragment>
			)
		}

		{
			!readonly && (
				<Fragment slot="action">
					<button
						type="button"
						data-remove-item-button
						hidden
						title={`Remove this ${kind} from your cart`}
						class:list={['shrink-0', baseClasses, sizeClasses.sm, variantClasses.secondary]}
					>
						Remove
						<span class="sr-only">{productTitle} from your cart</span>
					</button>
				</Fragment>
			)
		}
		{kind === 'set' && <SetChildrenList slot="below" components={components} quantity={quantity} />}
	</ItemLine>
</div>

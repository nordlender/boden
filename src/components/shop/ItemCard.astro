---
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props {
	// The grid tile is one per product (see lib/shop.ts's ShopGridProduct);
	// exactly one of these is non-null — the representative variant, used for
	// the `?item=<id>` / `?set=<id>` link that preselects it on
	// /products/[slug] (see VariantPicker.astro).
	itemId: number | null;
	setId: number | null;
	productSlug: string;
	productTitle: string;
	imageUrl: string | null;
}

const { itemId, setId, productSlug, productTitle, imageUrl } = Astro.props;
const isSet = setId !== null;
const href = `/products/${productSlug}?${isSet ? `set=${setId}` : `item=${itemId}`}`;
---

<a
	href={href}
	class="group flex flex-col overflow-hidden rounded-lg border border-border bg-surface transition hover:border-border-strong hover:shadow-sm"
>
	<div class="relative aspect-square overflow-hidden bg-bg-subtle">
		{
			isSet && (
				<span class="absolute left-2 top-2 rounded-full bg-surface px-2 py-0.5 text-[10px] font-medium text-text-muted shadow-sm">
					Set
				</span>
			)
		}
		{
			imageUrl ? (
				<img src={imageUrl} alt={productTitle} class="h-full w-full object-cover transition group-hover:scale-105" />
			) : (
				<div class="flex h-full w-full items-center justify-center text-disabled-text">
					<ImagePlaceholder size={32} />
				</div>
			)
		}
	</div>
	<div class="flex flex-1 flex-col gap-1 p-3">
		<h3 class="text-sm font-medium text-text">{productTitle}</h3>
	</div>
</a>

---
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props {
	// Which product-page query param this tile preselects — see
	// src/pages/products/[slug].astro's `?item=`/`?set=` handling.
	kind: 'item' | 'set';
	variantId: number;
	productSlug: string;
	productTitle: string;
	imageUrl: string | null;
	// Already-formatted per-kind subtitle — an item's joined attribute
	// values, or a set's own manually-typed label — computed by the caller
	// (ItemGrid) since an item and a set derive it differently.
	variantLabel: string | null;
}

const { kind, variantId, productSlug, productTitle, imageUrl, variantLabel } = Astro.props;
const href = `/products/${productSlug}?${kind}=${variantId}`;
---

<a
	href={href}
	class="group flex flex-col overflow-hidden rounded-lg border border-border bg-surface transition hover:border-border-strong hover:shadow-sm"
>
	<div class="relative aspect-square overflow-hidden bg-bg-subtle">
		{
			kind === 'set' && (
				<span class="absolute left-2 top-2 rounded-full bg-surface px-2 py-0.5 text-[10px] font-medium text-text-muted shadow-sm">
					Set
				</span>
			)
		}
		{
			imageUrl ? (
				<img src={imageUrl} alt={productTitle} class="h-full w-full object-cover transition group-hover:scale-105" />
			) : (
				<div class="flex h-full w-full items-center justify-center text-disabled-text">
					<ImagePlaceholder size={32} />
				</div>
			)
		}
	</div>
	<div class="flex flex-1 flex-col gap-1 p-3">
		<h3 class="text-sm font-medium text-text">{productTitle}</h3>
		{variantLabel && <p class="text-xs text-text-muted">{variantLabel}</p>}
	</div>
</a>

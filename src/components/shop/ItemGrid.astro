---
import ItemCard from './ItemCard.astro';

interface Item {
	slug: string;
	name: string;
	imageUrl: string;
	stockCount: number;
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;
---

{
	items.length === 0 ? (
		<p class="text-sm text-gray-600">No items available.</p>
	) : (
		<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
			{items.map((item) => (
				<ItemCard slug={item.slug} name={item.name} imageUrl={item.imageUrl} stockCount={item.stockCount} />
			))}
		</div>
	)
}

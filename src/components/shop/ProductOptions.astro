---
interface OptionValue {
	id: number;
	label: string;
	imageUrl: string | null;
	attributes: string | null;
}

interface OptionGroup {
	id: number;
	name: string;
	values: OptionValue[];
}

interface Props {
	groups: OptionGroup[];
}

const { groups } = Astro.props;

function parseAttributes(json: string | null): [string, string][] {
	if (!json) return [];
	try {
		const parsed = JSON.parse(json);
		return Object.entries(parsed).filter((entry): entry is [string, string] => typeof entry[1] === 'string');
	} catch {
		return [];
	}
}
---

{
	groups.length > 0 && (
		<div data-product-options class="flex flex-col gap-4">
			{groups.map((group) => {
				const hasAttributes = group.values.some((value) => value.attributes);
				const initialAttributes = parseAttributes(group.values[0]?.attributes ?? null);

				return (
					<fieldset>
						<legend class="mb-2 text-sm font-medium text-gray-900">{group.name}</legend>
						<div class="flex flex-wrap gap-2">
							{group.values.map((value, index) => (
								<label class="cursor-pointer">
									<input
										type="radio"
										name={`option-${group.id}`}
										value={value.id}
										checked={index === 0}
										{...(value.imageUrl ? { 'data-option-image': value.imageUrl } : {})}
										{...(value.attributes ? { 'data-attributes': value.attributes } : {})}
										class="peer sr-only"
									/>
									<span class="block rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-700 peer-checked:border-gray-900 peer-checked:ring-1 peer-checked:ring-gray-900 hover:border-gray-400">
										{value.label}
									</span>
								</label>
							))}
						</div>

						{hasAttributes && (
							<dl data-option-attributes class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
								{initialAttributes.map(([key, value]) => (
									<div class="contents">
										<dt class="text-gray-500">{key}</dt>
										<dd class="text-gray-900">{value}</dd>
									</div>
								))}
							</dl>
						)}
					</fieldset>
				);
			})}
		</div>
	)
}

<script>
	document.querySelectorAll<HTMLElement>('[data-product-options]').forEach((container) => {
		const image = document.querySelector<HTMLImageElement>('[data-product-image]');

		container.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
			input.addEventListener('change', () => {
				if (!input.checked) return;

				if (image && input.dataset.optionImage) {
					image.src = input.dataset.optionImage;
				}

				const list = input.closest('fieldset')?.querySelector<HTMLElement>('[data-option-attributes]');
				if (!list || !input.dataset.attributes) return;

				let attributes: Record<string, unknown>;
				try {
					attributes = JSON.parse(input.dataset.attributes);
				} catch {
					return;
				}

				list.replaceChildren();
				for (const [key, value] of Object.entries(attributes)) {
					if (typeof value !== 'string') continue;

					const row = document.createElement('div');
					row.className = 'contents';

					const dt = document.createElement('dt');
					dt.className = 'text-gray-500';
					dt.textContent = key;

					const dd = document.createElement('dd');
					dd.className = 'text-gray-900';
					dd.textContent = value;

					row.append(dt, dd);
					list.appendChild(row);
				}
			});
		});
	});
</script>

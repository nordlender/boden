---
// Owns the "choose a variant, add to cart" form on the product page:
// item select (when a product has more than one item), the resulting
// attribute list, stock message, quantity cap, and add-to-cart button — plus
// the client-side script that keeps all of those (and the product image
// rendered by the page above this form) in sync as the selected item
// changes, including a `?item=<id>` preselect from an ItemCard link.
//
// The product image lives in the page, not here (it's rendered above this
// form in a separate grid column) — the script below reaches it via the
// same `[data-product-image]`/`[data-product-image-placeholder]` selectors
// the page renders, rather than this component owning that markup too.
import type { ShopItem } from '../../lib/shop';
import Button from '../ui/Button.astro';

interface Props {
	items: ShopItem[];
	productSlug: string;
	thumbnailImageUrl: string | null;
	attributeKeyOrder: string[];
}

const { items, productSlug, thumbnailImageUrl, attributeKeyOrder } = Astro.props;
const initialItem = items[0] ?? null;
---

<form action="/api/cart/add" method="post" class="flex flex-col gap-4 border-t border-border pt-4">
	<input type="hidden" name="redirect" value={`/products/${productSlug}`} />

	{
		items.length > 1 ? (
			<div>
				<label class="mb-2 block text-sm font-medium text-text" for="itemId">
					Choose a variant
				</label>
				<select id="itemId" name="itemId" class="w-full rounded-md border border-border-interactive px-3 py-2 text-sm">
					{items.map((item) => {
						const label = item.attributes.map((a) => a.value).join(' / ') || `Option ${item.id}`;
						return (
							<option
								value={item.id}
								selected={item.id === initialItem?.id}
								disabled={item.inStock <= 0}
								data-image={item.imageUrl ?? thumbnailImageUrl ?? ''}
								data-stock={item.inStock}
								data-attributes={JSON.stringify(item.attributes)}
							>
								{label}
								{item.inStock <= 0 ? ' (out of stock)' : ''}
							</option>
						);
					})}
				</select>
			</div>
		) : (
			<input type="hidden" name="itemId" value={items[0].id} />
		)
	}

	{attributeKeyOrder.length > 0 && (
		<dl data-item-attributes class="grid grid-cols-2 gap-x-4 gap-y-2 border-t border-border pt-4 text-sm">
			{(initialItem?.attributes ?? []).map((attribute) => (
				<div class="contents">
					<dt class="text-text-muted">{attribute.key}</dt>
					<dd class="text-text">{attribute.value}</dd>
				</div>
			))}
		</dl>
	)}

	{/* TODO: Style later, warning? — is "out of stock" an error or a warning state? */}
	<p
		data-stock-message
		class={`text-sm font-medium ${(initialItem?.inStock ?? 0) > 0 ? 'text-success-text' : 'text-error-text'}`}
	>
		{(initialItem?.inStock ?? 0) > 0 ? `${initialItem?.inStock} in stock` : 'Out of stock'}
	</p>

	<div class="flex items-center gap-3">
		<input
			type="number"
			name="quantity"
			value="1"
			min="1"
			max={Math.max(initialItem?.inStock ?? 1, 1)}
			required
			data-quantity-input
			class="w-16 rounded-md border border-border-interactive px-2 py-1.5 text-sm"
		/>
		<Button type="submit" variant="primary" size="lg" data-add-to-cart disabled={(initialItem?.inStock ?? 0) <= 0}>
			Add to cart
		</Button>
	</div>
</form>

<script>
	// Keeps the image, stock message, quantity cap, and attribute list in
	// sync with whichever variant is selected — including a `?item=<id>`
	// preselect from an ItemCard link, applied here rather than server-side
	// since the product page is prerendered.
	const select = document.querySelector<HTMLSelectElement>('select[name="itemId"]');
	const image = document.querySelector<HTMLImageElement>('[data-product-image]');
	const imagePlaceholder = document.querySelector<HTMLElement>('[data-product-image-placeholder]');
	const stockMessage = document.querySelector<HTMLElement>('[data-stock-message]');
	const quantityInput = document.querySelector<HTMLInputElement>('[data-quantity-input]');
	const submitButton = document.querySelector<HTMLButtonElement>('[data-add-to-cart]');
	const attributesList = document.querySelector<HTMLElement>('[data-item-attributes]');

	function renderAttributes(json: string | undefined) {
		if (!attributesList || !json) return;
		let attributes: { key: string; value: string }[];
		try {
			attributes = JSON.parse(json);
		} catch {
			return;
		}

		attributesList.replaceChildren();
		for (const { key, value } of attributes) {
			const wrapper = document.createElement('div');
			wrapper.className = 'contents';

			const dt = document.createElement('dt');
			dt.className = 'text-text-muted';
			dt.textContent = key;

			const dd = document.createElement('dd');
			dd.className = 'text-text';
			dd.textContent = value;

			wrapper.append(dt, dd);
			attributesList.appendChild(wrapper);
		}
	}

	function applyOption(option: HTMLOptionElement) {
		const stock = Number(option.dataset.stock ?? '0');
		const imageUrl = option.dataset.image ?? '';

		if (image) {
			if (imageUrl) {
				image.src = imageUrl;
				image.hidden = false;
				if (imagePlaceholder) imagePlaceholder.hidden = true;
			} else {
				image.hidden = true;
				image.removeAttribute('src');
				if (imagePlaceholder) imagePlaceholder.hidden = false;
			}
		}

		if (stockMessage) {
			stockMessage.textContent = stock > 0 ? `${stock} in stock` : 'Out of stock';
			// TODO: Style later, warning? — is "out of stock" an error or a warning state?
			stockMessage.className = `text-sm font-medium ${stock > 0 ? 'text-success-text' : 'text-error-text'}`;
		}

		if (quantityInput) quantityInput.max = String(Math.max(stock, 1));
		if (submitButton) submitButton.disabled = stock <= 0;

		renderAttributes(option.dataset.attributes);
	}

	if (select) {
		const preselect = new URLSearchParams(location.search).get('item');
		if (preselect && select.querySelector(`option[value="${CSS.escape(preselect)}"]`)) {
			select.value = preselect;
		}

		select.addEventListener('change', () => {
			const option = select.selectedOptions[0];
			if (option) applyOption(option);
		});

		const initialOption = select.selectedOptions[0];
		if (initialOption) applyOption(initialOption);
	}
</script>

---
// Owns the "choose a variant, add to cart" form on the product page: the
// variant buttons (when the product has more than one), the resulting
// attribute list (items only), a set's automatically-derived "Includes"
// breakdown, stock message, quantity cap, and add-to-cart button — plus the
// client-side script that keeps all of those (and the product image
// rendered by the page above this form) in sync as the selected variant
// changes, including a `?item=<id>`/`?set=<id>` preselect from an ItemCard
// link.
//
// A product's variant slot is an item OR a set (src/db/schema.ts's `sets`
// comment), and the two are assumed mutually exclusive per product — a
// product's variants are all items, or all sets, never a mix. This picker
// enforces that assumption itself rather than trusting callers/data to hold
// it: it picks exactly one kind (items, unless there are none) and never
// shows a set as an option alongside an item, or vice versa.
//
// Which attribute is the variant is the admin's choice (`variantKeys`, from
// productAttributeKeys.isVariant): a button's text is that key's value
// (joined with " / " if there are several), and those keys are left out of
// the attribute list since the selected button already shows them. A product
// with no variant key flagged falls back to labelling buttons with every
// attribute value, and nothing is omitted.
//
// A set has no attribute template of its own — a set's "Includes" content
// is derived automatically from its components' own real attribute values
// (src/lib/sets.ts's getSetComponentDisplayBulk), and its picker option
// text is the admin's own manually-typed `label` (e.g. "S"), not anything
// joined from attributes.
//
// The product image lives in the page, not here (it's rendered above this
// form in a separate grid column) — the script below reaches it via the
// same `[data-product-image]`/`[data-product-image-placeholder]` selectors
// the page renders, rather than this component owning that markup too.
import type { ShopItem, ShopSet } from '../../lib/shop';
import type { SetComponentDisplay } from '../../lib/sets';
import Button from '../ui/Button.astro';
import AppIcon from '../icons/AppIcon.astro';
import { formatAttributes } from '../../lib/attributes';
import { tableClasses, tbodyRowClasses, tdClasses, theadRowClasses, thClasses } from '../../lib/table-styles';
import { labelClasses } from '../../lib/form-styles';
import { variantKey } from '../../lib/availabilityCalendar';

interface Props {
	items: ShopItem[];
	sets: ShopSet[];
	productSlug: string;
	thumbnailImageUrl: string | null;
	variantKeys: string[];
}

const { items, sets, productSlug, thumbnailImageUrl, variantKeys } = Astro.props;

const variantKeySet = new Set(variantKeys);
const hasVariantKeys = variantKeys.length > 0;

type Variant =
	| { kind: 'item'; id: number; imageUrl: string | null; inStock: number; attributes: { key: string; value: string }[]; variantValues: { key: string; value: string }[] }
	| { kind: 'set'; id: number; imageUrl: string | null; inStock: number; label: string | null; componentDisplay: SetComponentDisplay[] };

const variantKind: 'item' | 'set' = items.length > 0 ? 'item' : 'set';
const variants: Variant[] =
	variantKind === 'item'
		? items.map(
				(item): Variant => ({
					kind: 'item',
					id: item.id,
					imageUrl: item.imageUrl,
					inStock: item.inStock,
					attributes: item.attributes.filter((a) => !variantKeySet.has(a.key)),
					variantValues: hasVariantKeys ? item.attributes.filter((a) => variantKeySet.has(a.key)) : item.attributes,
				}),
			)
		: sets.map((set): Variant => ({ kind: 'set', id: set.id, imageUrl: set.imageUrl, inStock: set.inStock, label: set.label, componentDisplay: set.componentDisplay }));
const initialVariant = variants[0] ?? null;
const initialMax = Math.max(initialVariant?.inStock ?? 1, 1);

function optionLabel(variant: Variant): string {
	const text = variant.kind === 'item' ? formatAttributes(variant.variantValues) : variant.label;
	return text || `Option ${variant.id}`;
}
---

<form action="/api/cart/add" method="post" class="flex flex-col gap-6 border-t border-border pt-6">
	<input type="hidden" name="redirectTo" value={`/products/${productSlug}`} />
	<!--
		Exactly one of these is ever actually submitted — a disabled input is
		left out of FormData entirely, so the script below toggles `disabled`
		alongside `value` whenever the selected variant's kind changes, rather
		than this form ever sending both an itemId and a setId.
	-->
	<input
		type="hidden"
		name="itemId"
		data-variant-item-id
		value={initialVariant?.kind === 'item' ? String(initialVariant.id) : ''}
		disabled={initialVariant?.kind !== 'item'}
	/>
	<input
		type="hidden"
		name="setId"
		data-variant-set-id
		value={initialVariant?.kind === 'set' ? String(initialVariant.id) : ''}
		disabled={initialVariant?.kind !== 'set'}
	/>

	{
		variants.length > 1 && (
			<fieldset>
				<legend class:list={['mb-3', labelClasses]}>
					{variantKind === 'item' && hasVariantKeys ? variantKeys.join(' / ') : 'Choose a variant'}
				</legend>
				<div data-variant-options class="flex flex-wrap gap-controls">
					{variants.map((variant) => {
						const label = optionLabel(variant);
						const selected = variant.kind === initialVariant?.kind && variant.id === initialVariant?.id;
						return (
							<button
								type="button"
								aria-pressed={selected ? 'true' : 'false'}
								data-variant-option
								data-kind={variant.kind}
								data-id={variant.id}
								data-image={variant.imageUrl ?? thumbnailImageUrl ?? ''}
								data-stock={variant.inStock}
								class={`min-h-10 min-w-12 rounded-md border px-4 py-2 text-sm transition-colors hover:bg-bg-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-pressed:border-selected-border aria-pressed:bg-selected-subtle aria-pressed:font-medium aria-pressed:hover:bg-selected-subtle aria-pressed:text-selected-text ${variant.inStock > 0 ? 'border-border-interactive text-text' : 'border-border-interactive text-disabled-text line-through'}`}
							>
								{variant.kind === 'set' ? `Set — ${label}` : label}
								{variant.inStock <= 0 && <span class="sr-only"> (out of stock)</span>}
							</button>
						);
					})}
				</div>
			</fieldset>
		)
	}

	{/*
		Every variant's details (attribute list or set contents, plus stock
		message) are rendered here up front, one panel each; the script below
		only toggles `hidden` to show the selected one, so this markup is the
		single source of truth for how a variant's details look.
	*/}
	{variants.map((variant) => (
		<div data-variant-panel={variantKey(variant.kind, variant.id)} hidden={variant !== initialVariant} class="flex flex-col gap-6">
			{variant.kind === 'item' && variant.attributes.length > 0 && (
				<dl class="grid grid-cols-2 gap-x-6 gap-y-3 border-t border-border pt-6 text-sm">
					{variant.attributes.map((attribute) => (
						<div class="contents">
							<dt class="text-text-muted">{attribute.key}</dt>
							<dd class="text-text">{attribute.value}</dd>
						</div>
					))}
				</dl>
			)}

			{variant.kind === 'set' && (
				<div class="border-t border-border pt-6 text-sm">
					<p class:list={['mb-3', labelClasses]}>Attributes</p>
					<div class="flex flex-col gap-4">
						{variant.componentDisplay.map((group) =>
							group.kind === 'table' ? (
								<table class={tableClasses.dense}>
									<thead>
										<tr class={theadRowClasses.dense}>
											<th class={thClasses.dense}>Component</th>
											{group.keys.map((key) => (
												<th class={thClasses.dense}>{key}</th>
											))}
										</tr>
									</thead>
									<tbody>
										{group.rows.map((row) => (
											<tr class={tbodyRowClasses}>
												<td class:list={[tdClasses.dense, 'text-text']}>
													{row.productTitle}
													{row.quantity > 1 && ` (×${row.quantity})`}
												</td>
												{row.values.map((value) => (
													<td class:list={[tdClasses.dense, 'text-text-muted']}>{value ?? '—'}</td>
												))}
											</tr>
										))}
									</tbody>
								</table>
							) : (
								<p class="text-text-muted">
									{group.quantity > 1 ? `${group.quantity}× ` : ''}
									<span class="text-text">{group.productTitle}</span>
									{group.attributes.length > 0 && ` — ${group.attributes.map((a) => `${a.key}: ${a.value}`).join(', ')}`}
								</p>
							),
						)}
					</div>
				</div>
			)}

			{/* TODO: Style later, warning? — is "out of stock" an error or a warning state? */}
			<p class={`text-sm font-medium ${variant.inStock > 0 ? 'text-success-text' : 'text-error-text'}`}>
				{variant.inStock > 0 ? `${variant.inStock} in stock` : 'Out of stock'}
			</p>
		</div>
	))}

	<div class="flex items-center gap-controls">
		{/* Stepper's height (h-12) and count text (text-base) are pinned to
			Button's `lg` size (see sizeClasses in lib/button-styles.ts) rather
			than derived from it, since a plain <input type="number"> can't be
			styled with the spinner removed consistently across browsers. */}
		<div class="inline-flex h-12 divide-x divide-border-interactive overflow-hidden rounded-md border border-border-interactive">
			<button
				type="button"
				aria-label="Decrease quantity"
				data-quantity-decrement
				disabled
				class="flex h-12 w-12 items-center justify-center bg-bg-subtle text-text-muted transition-colors hover:text-text active:bg-border focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:text-disabled-text disabled:active:bg-bg-subtle"
			>
				<AppIcon name="decrement" size={20} />
			</button>
			<span data-quantity-display class="flex h-12 min-w-[3.5rem] items-center justify-center text-base font-semibold text-text">
				1
			</span>
			<button
				type="button"
				aria-label="Increase quantity"
				data-quantity-increment
				disabled={initialMax <= 1}
				class="flex h-12 w-12 items-center justify-center bg-bg-subtle text-text-muted transition-colors hover:text-text active:bg-border focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:text-disabled-text disabled:active:bg-bg-subtle"
			>
				<AppIcon name="increment" size={20} />
			</button>
		</div>
		<input type="hidden" name="quantity" value="1" data-quantity-input data-max={initialMax} />
		<Button type="submit" variant="primary" size="lg" data-add-to-cart disabled={(initialVariant?.inStock ?? 0) <= 0}>
			Add to cart
		</Button>
	</div>
</form>

<script>
	// Keeps the image, quantity cap, form inputs, and which variant's details
	// panel is shown in sync with whichever variant is selected — including a
	// `?item=<id>`/`?set=<id>` preselect from an ItemCard link.
	const options = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-variant-option]'));
	const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-variant-panel]'));
	const image = document.querySelector<HTMLImageElement>('[data-product-image]');
	const imagePlaceholder = document.querySelector<HTMLElement>('[data-product-image-placeholder]');
	const quantityInput = document.querySelector<HTMLInputElement>('[data-quantity-input]');
	const quantityDisplay = document.querySelector<HTMLElement>('[data-quantity-display]');
	const quantityIncrement = document.querySelector<HTMLButtonElement>('[data-quantity-increment]');
	const quantityDecrement = document.querySelector<HTMLButtonElement>('[data-quantity-decrement]');
	const submitButton = document.querySelector<HTMLButtonElement>('[data-add-to-cart]');
	const itemIdInput = document.querySelector<HTMLInputElement>('[data-variant-item-id]');
	const setIdInput = document.querySelector<HTMLInputElement>('[data-variant-set-id]');

	function setQuantity(value: number) {
		if (!quantityInput) return;
		const max = Number(quantityInput.dataset.max ?? '1');
		const clamped = Math.min(Math.max(Math.trunc(value) || 1, 1), max);
		quantityInput.value = String(clamped);
		if (quantityDisplay) quantityDisplay.textContent = String(clamped);
		if (quantityDecrement) quantityDecrement.disabled = clamped <= 1;
		if (quantityIncrement) quantityIncrement.disabled = clamped >= max;
	}

	quantityIncrement?.addEventListener('click', () => setQuantity(Number(quantityInput?.value ?? '1') + 1));
	quantityDecrement?.addEventListener('click', () => setQuantity(Number(quantityInput?.value ?? '1') - 1));

	function applyOption(option: HTMLButtonElement) {
		for (const other of options) other.setAttribute('aria-pressed', String(other === option));

		const stock = Number(option.dataset.stock ?? '0');
		const imageUrl = option.dataset.image ?? '';
		const kind = option.dataset.kind;
		const id = option.dataset.id ?? '';

		if (image) {
			if (imageUrl) {
				image.src = imageUrl;
				image.hidden = false;
				if (imagePlaceholder) imagePlaceholder.hidden = true;
			} else {
				image.hidden = true;
				image.removeAttribute('src');
				if (imagePlaceholder) imagePlaceholder.hidden = false;
			}
		}

		if (quantityInput) {
			quantityInput.dataset.max = String(Math.max(stock, 1));
			setQuantity(Number(quantityInput.value));
		}
		if (submitButton) submitButton.disabled = stock <= 0;

		if (itemIdInput) {
			itemIdInput.disabled = kind !== 'item';
			itemIdInput.value = kind === 'item' ? id : '';
		}
		if (setIdInput) {
			setIdInput.disabled = kind !== 'set';
			setIdInput.value = kind === 'set' ? id : '';
		}

		const key = `${kind}-${id}`;
		for (const panel of panels) panel.hidden = panel.dataset.variantPanel !== key;

		// Shows this variant's availability calendar (ProductAvailability.astro).
		const variantScope = document.querySelector<HTMLElement>('[data-selected-variant]');
		if (variantScope && kind && id) variantScope.dataset.selectedVariant = key;
	}

	if (options.length > 0) {
		const params = new URLSearchParams(location.search);
		const presetKind = params.has('set') ? 'set' : params.has('item') ? 'item' : null;
		const presetId = presetKind ? params.get(presetKind) : null;
		const preset = presetKind && presetId ? options.find((o) => o.dataset.kind === presetKind && o.dataset.id === presetId) : undefined;
		const initial = preset ?? options.find((o) => o.getAttribute('aria-pressed') === 'true');

		for (const option of options) option.addEventListener('click', () => applyOption(option));
		if (initial) applyOption(initial);
	}
</script>

---
type Variant = 'info' | 'warning' | 'error' | 'success' | 'help';

interface Props {
	variant: Variant;
	title?: string;
	class?: string;
}

const { variant, title, class: className = '' } = Astro.props;

const icons: Record<Variant, string> = {
	info: 'M12 8h.01M11 12h1v4h1 M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z',
	warning: 'M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z',
	error: 'M12 8v4m0 4h.01M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z',
	success: 'm9 12 2 2 4-4M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z',
	help: 'M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 3.5M12 17h.01M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z',
};

// Written out in full (not built from `variant`) so Tailwind's class scanner can see them.
const boxClasses: Record<Variant, string> = {
	info: 'bg-info-subtle border-info-border text-info-text',
	warning: 'bg-warning-subtle border-warning-border text-warning-text',
	error: 'bg-error-subtle border-error-border text-error-text',
	success: 'bg-success-subtle border-success-border text-success-text',
	help: 'bg-help-subtle border-help-border text-help-text',
};

const iconClasses: Record<Variant, string> = {
	info: 'text-info',
	warning: 'text-warning',
	error: 'text-error',
	success: 'text-success',
	help: 'text-help',
};
---

<div
	class:list={['flex gap-3 rounded-md border p-4 text-sm', boxClasses[variant], className]}
	role={variant === 'error' ? 'alert' : 'status'}
>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		class:list={['h-5 w-5 shrink-0', iconClasses[variant]]}
		aria-hidden="true"
	>
		<path stroke-linecap="round" stroke-linejoin="round" d={icons[variant]} />
	</svg>
	<div class="min-w-0">
		{title && <p class="mb-1 font-medium">{title}</p>}
		<div class="[&_p]:leading-relaxed">
			<slot />
		</div>
	</div>
</div>

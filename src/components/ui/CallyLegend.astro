---
// Legend row above a Cally calendar. `swatch` is the Tailwind classes for the
// colored dot (kept as full literal strings at the call site so Tailwind sees them).
interface Props {
	items: { label: string; swatch: string }[];
}

const { items } = Astro.props;
---

<ul class="mb-stack flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-text-muted">
	{
		items.map((item) => (
			<li class="flex items-center gap-1.5">
				<span class:list={['h-3 w-3 rounded-full', item.swatch]} aria-hidden="true" />
				{item.label}
			</li>
		))
	}
</ul>

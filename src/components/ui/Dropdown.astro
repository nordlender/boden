---
// General-purpose dropdown built on <details>/<summary>: native open/close,
// keyboard toggling and expanded/collapsed state for screen readers come
// for free. The delegated script below adds the rest of what a dropdown
// should do: close on outside click, on focus moving elsewhere, and on
// Escape (returning focus to the trigger).
//
// Trigger — the element that gives the trigger its shape (bounding box,
// border, background, hover). The <summary> is an unstyled wrapper around
// it, so it's always exactly one element either way:
//   - `slot="trigger"`: any shape, e.g. a circle with an icon inside. Use a
//     <span>/<div>, not a <button> — the <summary> is already the
//     interactive element, and interactive content can't nest inside it.
//   - the default, when nothing is slotted: a secondary `md` button with
//     `triggerLabel` and a morphing chevron, level with real buttons.
// The keyboard focus ring is drawn on the trigger element, so it follows
// its shape (a circle trigger gets a circular ring).
//
// Content — the default slot, inside a panel styled by `panel`: `menu` for
// a list of rows (pair with lib/layout-styles.ts's menuItemClasses), or
// `floating` for a small form. `panelClass` sets its offset and width.
import type { HTMLAttributes } from 'astro/types';
import MorphIcon from 'morphicons/astro';
import { baseClasses, sizeClasses, variantClasses } from '../../lib/button-styles';
import { dropdownChevron } from '../../lib/icon-nodes';
import { floatingPanelClasses, menuPanelClasses } from '../../lib/layout-styles';

interface Props extends HTMLAttributes<'details'> {
	triggerLabel?: string;
	/** Required whenever the trigger has no visible text. */
	ariaLabel?: string;
	align?: 'left' | 'right';
	panel?: 'menu' | 'floating';
	/** Offset and width of the panel. */
	panelClass?: string;
}

const {
	triggerLabel,
	ariaLabel,
	align = 'left',
	panel = 'menu',
	panelClass = 'mt-2 min-w-[10rem]',
	class: className,
	...rest
} = Astro.props;

const hasTriggerSlot = Astro.slots.has('trigger');
// `w-fit` so the summary hugs the trigger element rather than stretching to
// the <details>' width. Its own outline is suppressed in favour of one on
// the trigger element (its only child), which follows the trigger's shape.
const summaryClasses = [
	'block w-fit cursor-pointer list-none [&::-webkit-details-marker]:hidden',
	'focus-visible:outline-none [&:focus-visible>*]:outline-2 [&:focus-visible>*]:outline-offset-2 [&:focus-visible>*]:outline-focus-ring',
];
const defaultTriggerClasses = [baseClasses, sizeClasses.md, variantClasses.secondary];
---
<details data-dropdown class:list={['relative inline-block', className]} {...rest}>
	<summary class:list={summaryClasses} aria-label={ariaLabel}>
		{hasTriggerSlot ? (
			<slot name="trigger" />
		) : (
			<span class:list={defaultTriggerClasses}>
				{triggerLabel && <span>{triggerLabel}</span>}
				<MorphIcon icon={dropdownChevron.closed} size={14} class="dropdown-chevron text-text-muted" />
			</span>
		)}
	</summary>
	<div class:list={[
		'absolute z-10',
		align === 'right' ? 'right-0' : 'left-0',
		panel === 'menu' ? menuPanelClasses : floatingPanelClasses,
		panelClass,
	]}>
		<slot />
	</div>
</details>

<script>
	// Delegated (this script runs once per page, not once per Dropdown
	// instance) so it covers every <details data-dropdown> on the page.
	import type { MorphIconElement } from 'morphicons/element';
	import { dropdownChevron } from '../../lib/icon-nodes';

	const openDropdowns = () => document.querySelectorAll<HTMLDetailsElement>('details[data-dropdown][open]');

	// `toggle` doesn't bubble, so the listener has to sit on the capture
	// phase to see it at all.
	document.addEventListener(
		'toggle',
		(event) => {
			const details = event.target;
			if (!(details instanceof HTMLDetailsElement) || !details.hasAttribute('data-dropdown')) return;
			const chevron = details.querySelector<MorphIconElement>(':scope > summary .dropdown-chevron');
			if (!chevron) return;
			chevron.icon = details.open ? dropdownChevron.open : dropdownChevron.closed;
		},
		true,
	);

	// Outside click closes — which also means opening one dropdown closes
	// any other, since that click lands outside them.
	document.addEventListener('click', (event) => {
		const target = event.target as Node;
		openDropdowns().forEach((details) => {
			if (!details.contains(target)) details.removeAttribute('open');
		});
	});

	// Tabbing out closes, so the panel doesn't stay floating over the page.
	// A null `relatedTarget` (focus going nowhere, e.g. a click on the
	// panel's padding) is left to the click handler above.
	document.addEventListener('focusout', (event) => {
		const next = event.relatedTarget;
		if (!(next instanceof Node)) return;
		openDropdowns().forEach((details) => {
			if (details.contains(event.target as Node) && !details.contains(next)) details.removeAttribute('open');
		});
	});

	// Escape closes the innermost open dropdown containing focus (or all of
	// them if focus is elsewhere) and hands focus back to its trigger.
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		const focused = document.activeElement?.closest<HTMLDetailsElement>('details[data-dropdown][open]');
		const targets = focused ? [focused] : [...openDropdowns()];
		targets.forEach((details) => details.removeAttribute('open'));
		focused?.querySelector<HTMLElement>(':scope > summary')?.focus();
	});
</script>

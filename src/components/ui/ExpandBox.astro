---
// Inline expanding/collapsing panel primitive (introduced for issue #206;
// first real use is AddItemPanel.astro on /admin/items). Unlike Modal.astro's
// <dialog>, this stays in normal document flow — whatever sits below it
// smoothly slides down/up as it opens/closes, instead of a dialog appearing
// on top of everything. Reach for this whenever a section of a page should
// be collapsible/expandable in place (an inline form, an optional detail
// panel, an accordion-style row); reach for Modal.astro instead when the
// content should interrupt the page (focus-trapped, blocks interaction with
// the rest of the page until dismissed).
//
// Animates with the CSS grid-template-rows 0fr/1fr trick (see the
// `expand-box-panel` rules below) rather than <details>'s new
// calc-size()-driven animation or interpolate-size: both are Chrome-only
// today; the grid trick gets the same "auto height" animation everywhere
// without measuring anything in JS. Respects prefers-reduced-motion.
//
// --- Props ---
// id          (required) id of the collapsible panel — every trigger
//             targeting this box references this exact string.
// open        (default false) initial open/closed state, rendered
//             server-side so there's no flash-of-wrong-state on load.
// class       extra classes on the content wrapper (e.g. padding — see
//             AddItemPanel.astro, which puts px-3 pb-3 here since the
//             built-in trigger already carries its own horizontal padding).
// triggerClass extra classes on the built-in trigger button (only relevant
//             when the `trigger` slot is used — see below). ExpandBox
//             deliberately ships the trigger with no border/background/
//             padding opinions of its own beyond layout (flex row, full
//             width), so it can sit inside whatever card styling the
//             *caller* wraps it in without a clashing double border.
//
// --- Two ways to open/close it ---
// 1. Built-in header trigger: pass content into the `trigger` slot and
//    ExpandBox renders a full-width button (with an auto-morphing chevron)
//    that toggles the panel. This is the common case — an "Add item" /
//    "New message" style header the whole box collapses under.
//
//      <ExpandBox id="add-item-panel" triggerClass="px-3 py-3">
//        <span slot="trigger">Add item</span>
//        <form>...</form>
//      </ExpandBox>
//
// 2. External trigger(s) anywhere else on the page: omit the `trigger` slot
//    (or use it *and* add more triggers elsewhere — any number of elements
//    can target the same panel id, and all of them stay in sync) and wire
//    up an existing element with one of two data attributes, matching
//    Modal.astro's convention of a decoupled opener that doesn't need to be
//    inside or next to the thing it controls — though the attribute shape
//    is simpler here: the id lives directly on one attribute's value,
//    rather than Modal's pairing of a boolean data-modal-open flag with a
//    separate data-modal-target={id} attribute.
//
//      data-expand-target={id}  toggles the panel open/closed.
//      data-expand-open={id}    always opens it, never closes it — use this
//                                instead of data-expand-target for a
//                                "shortcut" trigger that must guarantee the
//                                panel ends up open (e.g. a link that jumps
//                                focus to a field inside it — see
//                                ButtonStrip.astro's "Add item" button,
//                                which uses data-expand-open so it still
//                                works whether the panel started open or
//                                closed, rather than potentially collapsing
//                                it shut).
//
//      <TextMorphButton href="#add-item-name" data-expand-open="add-item-panel">
//        Add item
//      </TextMorphButton>
//
// A single document-level click listener (see the <script> below) handles
// every ExpandBox on the page — no per-instance wiring needed, same as
// Modal.astro's script.
import MorphIcon from 'morphicons/astro';
import { dropdownChevron } from '../../lib/icon-nodes';

interface Props {
	id: string;
	open?: boolean;
	class?: string;
	triggerClass?: string;
}

const { id, open = false, class: className, triggerClass } = Astro.props;
const hasTrigger = Astro.slots.has('trigger');
---

{
	hasTrigger && (
		<button
			type="button"
			class:list={['expand-box-trigger flex w-full items-center justify-between gap-2 text-left text-sm font-medium text-text', triggerClass]}
			aria-expanded={open}
			aria-controls={id}
			data-expand-target={id}
		>
			<slot name="trigger" />
			<MorphIcon icon={open ? dropdownChevron.open : dropdownChevron.closed} size={17} class="expand-box-chevron shrink-0 text-text-muted" />
		</button>
	)
}

<div id={id} class="expand-box-panel" data-expand-panel data-open={open ? '' : undefined}>
	<div class:list={['expand-box-content min-h-0 overflow-hidden', className]} aria-hidden={!open} inert={!open}>
		<slot />
	</div>
</div>

<style>
	.expand-box-panel {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.25s ease-in-out;
	}

	.expand-box-panel[data-open] {
		grid-template-rows: 1fr;
	}

	@media (prefers-reduced-motion: reduce) {
		.expand-box-panel {
			transition: none;
		}
	}
</style>

<script>
	import type { MorphIconElement } from 'morphicons/element';
	import { dropdownChevron } from '../../lib/icon-nodes';

	function setOpen(id: string, open: boolean) {
		const panel = document.getElementById(id);
		if (!panel || !panel.hasAttribute('data-expand-panel')) return;

		panel.toggleAttribute('data-open', open);

		const content = panel.querySelector<HTMLElement>('.expand-box-content');
		if (content) {
			content.setAttribute('aria-hidden', String(!open));
			content.toggleAttribute('inert', !open);
		}

		document.querySelectorAll<HTMLElement>(`[data-expand-target="${id}"], [data-expand-open="${id}"]`).forEach((el) => {
			el.setAttribute('aria-expanded', String(open));
			const chevron = el.querySelector<MorphIconElement>('.expand-box-chevron');
			if (chevron) chevron.icon = open ? dropdownChevron.open : dropdownChevron.closed;
		});
	}

	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		const opener = target.closest<HTMLElement>('[data-expand-open]');
		if (opener?.dataset.expandOpen) {
			setOpen(opener.dataset.expandOpen, true);
			return;
		}

		const toggler = target.closest<HTMLElement>('[data-expand-target]');
		if (!toggler?.dataset.expandTarget) return;

		const panel = document.getElementById(toggler.dataset.expandTarget);
		if (!panel || !panel.hasAttribute('data-expand-panel')) return;
		setOpen(toggler.dataset.expandTarget, !panel.hasAttribute('data-open'));
	});
</script>

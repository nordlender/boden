---
// Native <dialog>-based modal primitive — nothing else in the app fills
// this role today (CalloutPopover.astro is a small `popover`-attribute
// tooltip, not a real dialog). showModal()/close() give focus-trapping and
// Escape-to-close for free; only open/close wiring is done by hand here.
interface Props {
	id: string;
	labelledBy?: string;
}

const { id, labelledBy } = Astro.props;
---

<dialog id={id} data-modal aria-labelledby={labelledBy} class="w-full max-w-md rounded-lg border border-border bg-surface p-0 text-text">
	<div class="flex flex-col gap-4 p-5">
		<slot />
	</div>
</dialog>

<style>
	dialog[data-modal]::backdrop {
		background: var(--color-overlay);
	}
</style>

<script>
	// One listener set covers every Modal instance on the page — triggers are
	// matched by `data-modal-target` pointing at a dialog's id, so multiple
	// modals (e.g. delete + reschedule) can coexist without id collisions in
	// the script itself.
	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		const opener = target.closest('[data-modal-open]');
		if (opener instanceof HTMLElement && opener.dataset.modalTarget) {
			const dialog = document.getElementById(opener.dataset.modalTarget);
			if (dialog instanceof HTMLDialogElement) dialog.showModal();
			return;
		}

		const closer = target.closest('[data-modal-close]');
		if (closer) {
			const dialog = closer.closest('dialog');
			if (dialog instanceof HTMLDialogElement) dialog.close();
			return;
		}

		// Backdrop click: a click landing directly on the <dialog> element
		// itself (not something inside it) is on the ::backdrop/padding area.
		if (target instanceof HTMLDialogElement && target.hasAttribute('data-modal')) {
			target.close();
		}
	});
</script>

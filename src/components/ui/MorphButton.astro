---
// Icon-only button/link for the general-purpose actions in
// src/lib/icon-nodes.ts's `actionIcons` (accept/cancel/delete/back/next).
// The icon morphs to its `hover` shape on pointer hover, keyboard focus, or
// tap — same interaction as ActionButton.astro's tile icons. For a version
// with a visible text label, see TextMorphButton.astro; for a static
// (non-morphing) icon button, see IconButton.astro.
import MorphIcon from 'morphicons/astro';
import { actionIcons, type ActionIconKey } from '../../lib/icon-nodes';
import { actionLabels, baseClasses, iconOnlyPixelSize, iconOnlySizeClasses, variantClasses, type ButtonSize, type ButtonVariant } from '../../lib/button-styles';

interface Props {
	action: ActionIconKey;
	label?: string;
	variant?: ButtonVariant;
	size?: ButtonSize;
	type?: 'button' | 'submit' | 'reset';
	href?: string;
	disabled?: boolean;
	class?: string;
	form?: string;
	formaction?: string;
	// Lets a MorphButton open a Popover.astro-based popup the same way
	// Button.astro can — see src/components/pickup-days/PickupDayDeleteButton.astro,
	// which slots one into ActionPopover.astro's `trigger` slot.
	popovertarget?: string;
	popovertargetaction?: 'show' | 'hide' | 'toggle';
}

const {
	action,
	label = actionLabels[action],
	variant = 'secondary',
	size = 'md',
	type = 'button',
	href,
	disabled = false,
	class: className,
	...rest
} = Astro.props;

const icons = actionIcons[action];
const classes = [baseClasses, iconOnlySizeClasses[size], variantClasses[variant], 'morph-action', className].filter(Boolean).join(' ');
---
{
	href ? (
		<a href={href} aria-label={label} class={classes} data-morph-action={action} aria-disabled={disabled || undefined} {...rest}>
			<MorphIcon icon={icons.default} size={iconOnlyPixelSize[size]} class="morph-action-icon" />
		</a>
	) : (
		<button type={type} aria-label={label} disabled={disabled} class={classes} data-morph-action={action} {...rest}>
			<MorphIcon icon={icons.default} size={iconOnlyPixelSize[size]} class="morph-action-icon" />
		</button>
	)
}

<script>
	import { wireMorphActions } from '../../lib/morph-actions';

	wireMorphActions();
</script>

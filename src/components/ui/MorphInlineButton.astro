---
// Bare, borderless icon button for actions that sit inline with a line of
// text (e.g. a unit note's delete in UnitNoteList.astro) — just the morphing
// icon, no border or background, in a fixed 20×20px box so it matches a
// text-sm line (20px line height) instead of making the line taller the way
// MorphButton's padded, bordered box does. Same `action` icons and hover
// morph as MorphButton/TextMorphButton (src/lib/icon-nodes.ts's
// actionIcons, wired by src/lib/morph-actions.ts).
//
// `tone="danger"` turns the icon red on hover/focus — for destructive
// actions such as delete.
import MorphIcon from 'morphicons/astro';
import { actionIcons, type ActionIconKey } from '../../lib/icon-nodes';
import { actionLabels } from '../../lib/button-styles';

interface Props {
	action: ActionIconKey;
	label?: string;
	tone?: 'neutral' | 'danger';
	type?: 'button' | 'submit' | 'reset';
	disabled?: boolean;
	class?: string;
	form?: string;
	formaction?: string;
	popovertarget?: string;
	popovertargetaction?: 'show' | 'hide' | 'toggle';
}

// 14px icon in the 20px box: the icon's own 24-unit viewBox carries ~2px of
// built-in padding, so this reads as a full-size icon on a 20px line.
const ICON_PIXEL_SIZE = 14;

const toneClasses = {
	neutral: 'hover:text-text focus-visible:text-text',
	danger: 'hover:text-error-text focus-visible:text-error-text',
} as const;

const { action, label = actionLabels[action], tone = 'neutral', type = 'button', disabled = false, class: className, ...rest } = Astro.props;

const classes = [
	'morph-action inline-grid size-5 shrink-0 place-items-center rounded text-text-muted transition-colors',
	'focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-border-interactive',
	'disabled:cursor-not-allowed disabled:text-disabled-text',
	toneClasses[tone],
	className,
]
	.filter(Boolean)
	.join(' ');
---
<button type={type} aria-label={label} disabled={disabled} class={classes} data-morph-action={action} {...rest}>
	<MorphIcon icon={actionIcons[action].default} size={ICON_PIXEL_SIZE} class="morph-action-icon" />
</button>

<script>
	import { wireMorphActions } from '../../lib/morph-actions';

	wireMorphActions();
</script>

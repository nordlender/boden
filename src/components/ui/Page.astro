---
// Standard page wrapper — use this as the outermost element inside a
// layout instead of hand-rolling `mx-auto max-w-* p-*`. Every page sits in
// the navbar's container (containerClasses), so its title lines up under
// the logo and nothing shifts as you move between pages. `width` only caps
// the content column inside that container, always left-aligned (see
// pageWidthClasses in lib/layout-styles.ts).
//
// Vertical rhythm comes from the spacing tokens in global.css (see
// docs/spacing.md): `gap-section` between the header and the body, and the
// smaller `gap-region` between the blocks in the body (the default slot's
// direct children) — so related panels, e.g. an add panel and the table it
// adds to, don't drift apart.
//
// Optional header: `title` renders the page's h1, `description` a muted
// line under it. Named slots:
//   - "before-title": above the h1 (e.g. a BackLink)
//   - "subtitle": extra lines under the title/description (e.g. a badge)
//   - "actions": right-aligned beside the title (e.g. a "New" button)
import { containerClasses, pageTitleClasses, pageWidthClasses, type PageWidth } from '../../lib/layout-styles';

interface Props {
	width?: PageWidth;
	title?: string;
	description?: string;
	class?: string;
}

const { width = 'full', title, description, class: className } = Astro.props;
const hasHeader = Boolean(title) || Astro.slots.has('before-title') || Astro.slots.has('actions');
---

<div class:list={[containerClasses, 'py-section', className]}>
	<div class:list={['flex flex-col gap-section', pageWidthClasses[width]]}>
		{
			hasHeader && (
				<header class="flex flex-wrap items-end justify-between gap-stack">
					<div class="flex min-w-0 flex-col gap-snug">
						<slot name="before-title" />
						{title && <h1 class={pageTitleClasses}>{title}</h1>}
						{description && <p class="text-sm leading-relaxed text-text-muted">{description}</p>}
						<slot name="subtitle" />
					</div>
					<slot name="actions" />
				</header>
			)
		}
		<div class="flex flex-col gap-region">
			<slot />
		</div>
	</div>
</div>

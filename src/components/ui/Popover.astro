---
// Non-modal popup primitive, built on the native Popover API
// (popover="auto"): unlike Modal.astro's <dialog>/showModal(), it has no
// backdrop and doesn't block the rest of the page — the page underneath
// stays visible and interactable. Outside-click-to-close ("light dismiss")
// is native browser behavior, free.
//
// Positioning is done in JS off the trigger's/container's bounding rect
// rather than CSS anchor positioning, since anchor positioning isn't yet
// supported everywhere Popover API is; this keeps behavior consistent
// across browsers without adding a dependency (this codebase hand-rolls
// its overlay primitives — see Modal.astro).
//
// Two placement modes:
// - "anchor" (default): appears over the trigger element itself, on the
//   `side` given (default "top" — layered on top of the button that opened
//   it, like an action confirm; use "right"/"left" for a hint that should
//   sit beside the thing it explains rather than cover it).
// - "fill-parent": spans the full width of the trigger's closest
//   [data-popover-container], positioned at that container's left edge,
//   still vertically over the trigger — the moderator accept/reject row
//   case, where the popup should fill the buttons' containing div rather
//   than float freely. The caller is responsible for putting
//   `data-popover-container` on the element that wraps the *whole* row
//   (e.g. the div wrapping both the Accept and Reject buttons) — not on
//   the trigger itself, since fill-parent's point is to span siblings the
//   trigger doesn't contain.
import { floatingPanelClasses } from '../../lib/layout-styles';

interface Props {
	id: string;
	placement?: 'anchor' | 'fill-parent';
	side?: 'top' | 'bottom' | 'left' | 'right';
	labelledBy?: string;
	// Set to false when the slotted content already supplies its own visual
	// box (e.g. HintPopover's Callout) — otherwise that content ends up
	// nested inside this card, rendering as two visibly stacked boxes.
	// false still keeps the positioning/sizing classes, just drops the
	// border/bg/padding/shadow.
	chrome?: boolean;
	class?: string;
}

const { id, placement = 'anchor', side = 'top', labelledBy, chrome = true, class: className } = Astro.props;
---

<div
	id={id}
	popover="auto"
	data-popover
	data-popover-placement={placement}
	data-popover-side={side}
	aria-labelledby={labelledBy}
	class:list={[
		'fixed inset-auto m-0 max-w-sm text-text',
		chrome && floatingPanelClasses,
		className,
	]}
>
	<slot />
</div>

<script>
	// Positioning listeners live in lib/popover.ts — see that file for why
	// they're a module rather than inline here.
	import '../../lib/popover';
</script>

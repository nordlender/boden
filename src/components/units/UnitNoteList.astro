---
// Compact list of a unit's notes, used under each row in UnitRow.astro —
// one line per note: "John A. 20/09/26  <note>", with a bare 20px delete
// icon at the far right (MorphInlineButton, so it never makes the line
// taller). Notes are messages (see src/db/schema.ts) with the same rules as
// the hub board: never edited, deletable by an admin or the note's own
// author (canDeleteMessage).
//
// The box spans the whole row, separated from it by a line and tinted like
// the row's "Edit details" panel. The three newest notes are visible; with
// more, the list scrolls and a fade over the third note shows there's more
// (hidden once scrolled to the end). The script sizes the box to end
// exactly at the third note; `max-h-20` is the no-JS fallback.
import MorphInlineButton from '../ui/MorphInlineButton.astro';
import { canDeleteMessage, shortAuthorName, type MessageRow } from '../../lib/messages';
import { formatDateDdMmYy, formatDateTimeDisplay } from '../../lib/dates';

interface Props {
	// Newest first (listUnitNotes).
	notes: MessageRow[];
	currentUserId: string | null;
	isAdmin: boolean;
	redirectTo: string;
}

const VISIBLE_NOTES = 3;
const { notes, currentUserId, isAdmin, redirectTo } = Astro.props;
const scrollable = notes.length > VISIBLE_NOTES;
// The same tint as the details panel (bg-bg-subtle/60 over the table's
// surface), as one solid colour so the fade can blend into it exactly.
// A hovered note mixes a little of the text colour into that tint: the text
// colour is near-black in light mode and near-white in dark mode, so the
// same value darkens the row in light mode and brightens it in dark mode.
const tint = [
	'--notes-bg: color-mix(in oklab, var(--color-bg-subtle) 60%, var(--color-surface))',
	'--notes-hover-bg: color-mix(in oklab, var(--notes-bg), var(--color-text) 6%)',
].join('; ');
---
<div class="relative border-t border-border bg-(--notes-bg)" style={tint}>
	<ul
		class:list={['flex flex-col py-1', scrollable && 'max-h-20 overflow-y-auto']}
		data-unit-note-list={scrollable ? VISIBLE_NOTES : undefined}
	>
		{notes.map((note) => (
			<li class="flex items-baseline gap-2 px-3 py-0.5 text-sm transition-colors hover:bg-(--notes-hover-bg)">
				<span class="shrink-0 text-xs tabular-nums text-text-muted" title={`${note.authorName}, ${formatDateTimeDisplay(note.createdAt)}`}>
					{shortAuthorName(note.authorName)} {formatDateDdMmYy(note.createdAt)}
				</span>
				<span class="min-w-0 flex-1 whitespace-pre-wrap text-text">{note.content}</span>
				{canDeleteMessage(note, currentUserId, isAdmin) && (
					<form method="post" action="/api/messages/delete" class="ml-auto flex shrink-0 self-start">
						<input type="hidden" name="id" value={note.id} />
						<input type="hidden" name="redirectTo" value={redirectTo} />
						<MorphInlineButton action="delete" tone="danger" type="submit" label="Delete note" />
					</form>
				)}
			</li>
		))}
	</ul>
	{scrollable && (
		<div class="pointer-events-none absolute inset-x-0 bottom-0 h-5 bg-linear-to-t from-(--notes-bg) to-transparent" data-unit-note-fade></div>
	)}
</div>

<script>
	const lists = [...document.querySelectorAll<HTMLElement>('[data-unit-note-list]')];

	// Ends the box exactly at the last visible note. offsetTop/offsetHeight
	// (layout positions) rather than on-screen rects, so a list that's already
	// scrolled measures the same.
	function fitToVisibleNotes(list: HTMLElement) {
		const visible = Number(list.dataset.unitNoteList);
		const lastVisible = list.querySelectorAll('li')[visible - 1];
		if (!lastVisible) return;
		// + the list's bottom padding, so the last visible note isn't flush against the edge.
		const bottomPadding = parseFloat(getComputedStyle(list).paddingBottom);
		list.style.maxHeight = `${lastVisible.offsetTop - list.offsetTop + lastVisible.offsetHeight + bottomPadding}px`;
	}

	// Notes wrap, so their heights change with the width (window resize,
	// tablet rotation) and once web fonts arrive — re-measure on both.
	const fitAll = () => lists.forEach(fitToVisibleNotes);
	fitAll();
	window.addEventListener('resize', fitAll);
	document.fonts?.ready.then(fitAll);

	for (const list of lists) {
		const fade = list.parentElement?.querySelector<HTMLElement>('[data-unit-note-fade]');
		list.addEventListener('scroll', () => {
			const atEnd = list.scrollTop + list.clientHeight >= list.scrollHeight - 1;
			fade?.classList.toggle('hidden', atEnd);
		});
	}
</script>

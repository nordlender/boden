---
// A unit's notes (only rendered when it has any) under its row in
// UnitRow.astro, rendered by the shared
// MessageTable (unit notes are messages — see src/db/schema.ts), so they look
// and behave like hub messages: author name and time, delete by an admin or
// the note's own author, never edited, never pinned.
//
// At most three notes are visible; with more, the list scrolls and a
// gradient over the third note shows there's more below (hidden once
// scrolled to the end). The script sizes the box to end exactly at the
// third note; `max-h-52` is the no-JS fallback. New notes are written via
// NewUnitNoteButton.astro.
import MessageTable from '../messages/MessageTable.astro';
import type { MessageRow } from '../../lib/messages';

interface Props {
	// Newest first (listUnitNotes).
	notes: MessageRow[];
	currentUserId: string | null;
	isAdmin: boolean;
	redirectTo: string;
}

const VISIBLE_NOTES = 3;
const { notes, currentUserId, isAdmin, redirectTo } = Astro.props;
const scrollable = notes.length > VISIBLE_NOTES;
---
<div class="relative">
	<div class:list={[scrollable && 'max-h-52 overflow-y-auto']} data-unit-notes-scroll={scrollable ? VISIBLE_NOTES : undefined}>
		<MessageTable messages={notes} title={null} pinnable={false} currentUserId={currentUserId} isAdmin={isAdmin} redirectTo={redirectTo} />
	</div>
	{scrollable && (
		<div class="pointer-events-none absolute inset-x-px bottom-px h-12 rounded-b-lg bg-linear-to-t from-surface to-transparent" data-unit-notes-fade></div>
	)}
</div>

<script>
	for (const scroller of document.querySelectorAll<HTMLElement>('[data-unit-notes-scroll]')) {
		const visible = Number(scroller.dataset.unitNotesScroll);
		const lastVisible = scroller.querySelectorAll('li')[visible - 1];
		const fade = scroller.parentElement?.querySelector<HTMLElement>('[data-unit-notes-fade]');
		if (lastVisible) {
			scroller.style.maxHeight = `${lastVisible.getBoundingClientRect().bottom - scroller.getBoundingClientRect().top}px`;
		}
		scroller.addEventListener('scroll', () => {
			const atEnd = scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 1;
			fade?.classList.toggle('hidden', atEnd);
		});
	}
</script>

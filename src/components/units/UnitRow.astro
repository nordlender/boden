---
// One unit in the /admin/items/[id]/units table — modelled on
// wizard/ItemRow.astro. Three separate menus per unit:
// - status: hover the status pill for a pencil → popover (UnitStatusControl)
// - notes: the message-plus button → new-note popover (NewUnitNoteButton);
//   the latest notes are listed under the row (UnitNoteList)
// - details: the shared DetailsToggle → panel with the unit's editable
//   fields and extra fields (finds [data-details-row]/[data-details-panel])
//
// `marking` is a plain description of how the unit is physically marked
// ("red and white tape"), shown as an ordinary column — not as the unit's
// title. A unit has no name; it's identified by its #id.
import TextMorphButton from '../ui/TextMorphButton.astro';
import DetailsToggle from '../wizard/DetailsToggle.astro';
import OptsFields from './OptsFields.astro';
import UnitNoteList from './UnitNoteList.astro';
import NewUnitNoteButton from './NewUnitNoteButton.astro';
import UnitStatusControl from './UnitStatusControl.astro';
import type { Unit } from '../../lib/units';
import type { MessageRow } from '../../lib/messages';
import { formatIsoDateDdMmYy } from '../../lib/dates';
import { DESKTOP_ONLY_CLASS, UNIT_FORM_FIELDS, UNIT_GRID_CLASS, UNIT_GRID_STYLE, inputClass, labelClass } from './unitTable';

interface Props {
	unit: Unit;
	// Newest first (listUnitNotes).
	notes: MessageRow[];
	currentUserId: string | null;
	isAdmin: boolean;
	today: string;
	redirectTo: string;
}

const { unit, notes, currentUserId, isAdmin, today, redirectTo } = Astro.props;
const brandModel = [unit.brand, unit.model].filter(Boolean).join(' ');
const opts = Object.entries(unit.opts);
---
<div class="border-b border-border last:border-b-0" data-details-row>
	<div class:list={[UNIT_GRID_CLASS, 'py-2 hover:bg-bg-subtle']} style={UNIT_GRID_STYLE}>
		<span class="font-mono text-xs text-text-muted">#{unit.id}</span>
		<div class="min-w-0">
			<p class="truncate text-sm text-text">{brandModel || <span class="text-text-muted">—</span>}</p>
			{unit.serialNumber && <p class="truncate font-mono text-xs text-text-muted">S/N {unit.serialNumber}</p>}
			{unit.marking && <p class="truncate text-xs text-text-muted sm:hidden">{unit.marking}</p>}
		</div>
		<span class:list={[DESKTOP_ONLY_CLASS, 'truncate text-sm text-text']}>{unit.marking ?? <span class="text-text-muted">—</span>}</span>
		<span class:list={[DESKTOP_ONLY_CLASS, 'whitespace-nowrap text-sm tabular-nums text-text-muted']}>{unit.manufacturedAt ? formatIsoDateDdMmYy(unit.manufacturedAt) : '—'}</span>
		<span class:list={[DESKTOP_ONLY_CLASS, 'whitespace-nowrap text-sm tabular-nums text-text-muted']}>{unit.purchasedAt ? formatIsoDateDdMmYy(unit.purchasedAt) : '—'}</span>
		{/* Just the count; the fields are listed (and added) in the details panel. The tooltip names them. */}
		<span
			class:list={[DESKTOP_ONLY_CLASS, 'text-sm tabular-nums', opts.length > 0 ? 'text-text' : 'text-text-muted']}
			title={opts.length > 0 ? opts.map(([key, value]) => `${key}: ${value}`).join('\n') : 'No extra fields'}
		>
			{opts.length || '—'}
		</span>
		<UnitStatusControl unit={unit} redirectTo={redirectTo} />
		<div class="flex items-center justify-end gap-1">
			<NewUnitNoteButton unitId={unit.id} redirectTo={redirectTo} />
			<DetailsToggle label={`Edit details of unit #${unit.id}`} />
		</div>
	</div>

	{notes.length > 0 && <UnitNoteList notes={notes} currentUserId={currentUserId} isAdmin={isAdmin} redirectTo={redirectTo} />}

	<div class="hidden border-t border-border bg-bg-subtle/60 px-4 py-4" data-details-panel>
		<p class="mb-3 text-xs text-text-muted sm:hidden">
			Made {unit.manufacturedAt ? formatIsoDateDdMmYy(unit.manufacturedAt) : '—'} · Bought {unit.purchasedAt ? formatIsoDateDdMmYy(unit.purchasedAt) : '—'} · {opts.length} extra field{opts.length === 1 ? '' : 's'}
		</p>
		<div class="flex flex-col gap-4">
			<form method="post" action="/api/wizard/units" class="flex flex-col gap-3">
				<input type="hidden" name="action" value="update" />
				<input type="hidden" name="unitId" value={unit.id} />
				<input type="hidden" name="redirectTo" value={redirectTo} />
				<p class="text-xs font-medium uppercase tracking-wide text-text-muted">Edit details</p>
				<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
					{UNIT_FORM_FIELDS.map((field) => (
						<div>
							<label class={labelClass} for={`unit-${unit.id}-${field.name}`}>{field.label}</label>
							<input
								id={`unit-${unit.id}-${field.name}`}
								class={inputClass}
								type={field.type}
								name={field.name}
								value={unit[field.name] ?? ''}
								placeholder={field.placeholder}
								max={field.type === 'date' ? today : undefined}
							/>
						</div>
					))}
				</div>
				<OptsFields opts={unit.opts} />
				<TextMorphButton type="submit" action="save" variant="primary" size="sm" class="self-start">Save details</TextMorphButton>
			</form>
		</div>
	</div>
</div>

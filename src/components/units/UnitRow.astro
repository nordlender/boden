---
// One unit in the /admin/items/[id]/units table — modelled on
// wizard/ItemRow.astro: a grid row, plus a details panel toggled by the
// shared DetailsToggle (which finds [data-details-row]/[data-details-panel]).
// Under the row sits the unit's notes dropdown (UnitNotes.astro), which
// always shows the latest note; the details panel holds change status and
// edit details.
//
// `marking` is a plain description of how the unit is physically marked
// ("red and white tape"), shown as an ordinary column — not as the unit's
// title. A unit has no name; it's identified by its #id.
import Badge from '../ui/Badge.astro';
import TextMorphButton from '../ui/TextMorphButton.astro';
import DetailsToggle from '../wizard/DetailsToggle.astro';
import OptsFields from './OptsFields.astro';
import UnitNotes from './UnitNotes.astro';
import { UNIT_STATUSES } from '../../db/schema';
import { UNIT_STATUS_LABELS, UNIT_STATUS_TONES, type Unit } from '../../lib/units';
import type { MessageRow } from '../../lib/messages';
import { DESKTOP_ONLY_CLASS, UNIT_FORM_FIELDS, UNIT_GRID_CLASS, UNIT_GRID_STYLE, inputClass, labelClass } from './unitTable';

interface Props {
	unit: Unit;
	// Newest first (listUnitNotes).
	notes: MessageRow[];
	today: string;
	redirectTo: string;
}

const { unit, notes, today, redirectTo } = Astro.props;
const brandModel = [unit.brand, unit.model].filter(Boolean).join(' ');
const opts = Object.entries(unit.opts);
---
<div class:list={['border-b border-border last:border-b-0', unit.status === 'retired' && 'text-text-muted']} data-details-row>
	<div class:list={[UNIT_GRID_CLASS, 'py-2 hover:bg-bg-subtle']} style={UNIT_GRID_STYLE}>
		<span class="font-mono text-xs text-text-muted">#{unit.id}</span>
		<div class="min-w-0">
			<p class="truncate text-sm text-text">{brandModel || <span class="text-text-muted">—</span>}</p>
			{unit.serialNumber && <p class="truncate font-mono text-xs text-text-muted">S/N {unit.serialNumber}</p>}
			{unit.marking && <p class="truncate text-xs text-text-muted sm:hidden">{unit.marking}</p>}
			{opts.length > 0 && (
				<p class="mt-1 flex flex-wrap gap-1">
					{opts.map(([key, value]) => <Badge tone="info">{key}: {value}</Badge>)}
				</p>
			)}
		</div>
		<span class:list={[DESKTOP_ONLY_CLASS, 'truncate text-sm text-text']}>{unit.marking ?? <span class="text-text-muted">—</span>}</span>
		<span class:list={[DESKTOP_ONLY_CLASS, 'text-sm tabular-nums text-text-muted']}>{unit.manufacturedAt ?? '—'}</span>
		<span class:list={[DESKTOP_ONLY_CLASS, 'text-sm tabular-nums text-text-muted']}>{unit.purchasedAt ?? '—'}</span>
		<span><Badge tone={UNIT_STATUS_TONES[unit.status]}>{UNIT_STATUS_LABELS[unit.status]}</Badge></span>
		<DetailsToggle label={`Show actions for unit #${unit.id}`} />
	</div>

	{/* Indented to line up with the unit column: px-3 + the 3rem id column + gap-3. */}
	<div class="pb-2 pl-[4.5rem] pr-3">
		<UnitNotes unitId={unit.id} notes={notes} redirectTo={redirectTo} />
	</div>

	<div class="hidden border-t border-border bg-bg-subtle/60 px-4 py-4" data-details-panel>
		<p class="mb-3 text-xs text-text-muted sm:hidden">
			Made {unit.manufacturedAt ?? '—'} · Bought {unit.purchasedAt ?? '—'}
		</p>
		<div class="flex flex-col gap-4">
			<form method="post" action="/api/wizard/units" class="flex flex-col gap-2">
				<input type="hidden" name="action" value="status" />
				<input type="hidden" name="unitId" value={unit.id} />
				<input type="hidden" name="redirectTo" value={redirectTo} />
				<p class="text-xs font-medium uppercase tracking-wide text-text-muted">Change status</p>
				<div class="flex flex-wrap items-center gap-2">
					<select class:list={[inputClass, 'w-[9.5rem]']} name="status" aria-label="Status">
						{UNIT_STATUSES.map((status) => (
							<option value={status} selected={status === unit.status}>{UNIT_STATUS_LABELS[status]}</option>
						))}
					</select>
					<input class:list={[inputClass, 'flex-1']} type="text" name="reason" placeholder="Reason (posted as a note)" aria-label="Reason" />
					<TextMorphButton type="submit" action="save" size="sm">Save status</TextMorphButton>
				</div>
			</form>


			<form method="post" action="/api/wizard/units" class="flex flex-col gap-3">
				<input type="hidden" name="action" value="update" />
				<input type="hidden" name="unitId" value={unit.id} />
				<input type="hidden" name="redirectTo" value={redirectTo} />
				<p class="text-xs font-medium uppercase tracking-wide text-text-muted">Edit details</p>
				<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
					{UNIT_FORM_FIELDS.map((field) => (
						<div>
							<label class={labelClass} for={`unit-${unit.id}-${field.name}`}>{field.label}</label>
							<input
								id={`unit-${unit.id}-${field.name}`}
								class={inputClass}
								type={field.type}
								name={field.name}
								value={unit[field.name] ?? ''}
								placeholder={field.placeholder}
								max={field.type === 'date' ? today : undefined}
							/>
						</div>
					))}
				</div>
				<OptsFields opts={unit.opts} />
				<TextMorphButton type="submit" action="save" variant="primary" size="sm" class="self-start">Save details</TextMorphButton>
			</form>
		</div>
	</div>
</div>

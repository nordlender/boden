---
// One titled table of units on /admin/items/[id]/units — the page renders
// two: the units in use (active, then out of service) and, below it,
// retired units, kept apart so a retired unit can't be mistaken for stock.
import UnitTableHeader from './UnitTableHeader.astro';
import UnitRow from './UnitRow.astro';
import type { Unit } from '../../lib/units';
import type { MessageRow } from '../../lib/messages';

interface Props {
	title: string;
	units: Unit[];
	emptyText: string;
	notesByUnit: Map<number, MessageRow[]>;
	currentUserId: string | null;
	isAdmin: boolean;
	today: string;
	redirectTo: string;
}

const { title, units, emptyText, notesByUnit, currentUserId, isAdmin, today, redirectTo } = Astro.props;
---
<section class="rounded-lg border border-border bg-surface">
	<h2 class="border-b border-border px-3 py-2 text-sm font-semibold text-text">{title}</h2>
	<UnitTableHeader />
	{units.length === 0 ? (
		<p class="px-3 py-8 text-center text-sm text-text-muted">{emptyText}</p>
	) : (
		<div class="overflow-hidden rounded-b-lg">
			{units.map((unit) => (
				<UnitRow unit={unit} notes={notesByUnit.get(unit.id) ?? []} currentUserId={currentUserId} isAdmin={isAdmin} today={today} redirectTo={redirectTo} />
			))}
		</div>
	)}
</section>

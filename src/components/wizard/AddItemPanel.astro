---
// Spawns beneath the Unassigned button strip when "Add item" is clicked.
// The id shown here is a preview only — per the doc, the incremental
// counter in the DB must not advance until the item is actually saved.
//
// Description and Type/Category both used to be fields here. Both are now
// inherited from whichever product the item ends up assigned to, so there's
// nothing product-dependent left to set at creation — just image, id, name.
import AppIcon from '../icons/AppIcon.astro';
import Thumbnail from './Thumbnail.astro';

interface Props {
	nextItemId: string | number;
}

const { nextItemId } = Astro.props;
---
<div class="border-b border-slate-200 bg-amber-50/60 px-3 py-3">
	<div class="mb-2 flex items-center gap-2 text-sm font-medium text-slate-700">
		<AppIcon name="product" size={16} class="text-slate-400" />
		Add item
	</div>
	<div class="grid grid-cols-[2.75rem_5rem_1fr] items-end gap-3">
		<div>
			<span class="mb-1 block text-xs text-slate-500">Image</span>
			<Thumbnail alt="New item" />
		</div>
		<div>
			<span class="mb-1 block text-xs text-slate-500">Item ID</span>
			<p class="rounded border border-dashed border-slate-300 bg-white px-2 py-1.5 font-mono text-xs text-slate-400">#{nextItemId}</p>
		</div>
		<div>
			<label class="mb-1 block text-xs text-slate-500" for="add-item-name">Item name</label>
			<input id="add-item-name" type="text" required class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" />
		</div>
	</div>
	<div class="mt-3 flex justify-end gap-2">
		<button type="button" class="rounded border border-slate-300 px-3 py-1.5 text-sm text-slate-600 hover:bg-white">Cancel</button>
		<button type="button" class="rounded bg-slate-800 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700">Save item</button>
	</div>
</div>

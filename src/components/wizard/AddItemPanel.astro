---
// The doc calls for showing the auto-generated id here without advancing
// the DB's counter until save — satisfied for free by the schema's
// autoincrement PK (nothing increments until an INSERT actually commits),
// but that also means there's no safe way to preview the exact number in
// advance, so this just says "auto-generated" rather than guessing one.
//
// Description and Type/Category both used to be fields here. Both are now
// inherited from whichever product the item ends up assigned to, so there's
// nothing product-dependent left to set at creation — just image, id, name.
//
// Collapsed by default (issue #206-style inline expand/collapse rather than
// always-open) — ButtonStrip.astro's "Add item" shortcut opens this via
// data-expand-open="add-item-panel" before jumping focus to #add-item-name,
// so that link still works whether this is already open or not.
import AppIcon from '../icons/AppIcon.astro';
import TextMorphButton from '../ui/TextMorphButton.astro';
import ExpandBox from '../ui/ExpandBox.astro';

interface Props {
	redirectTo: string;
}

const { redirectTo } = Astro.props;
---
<!-- TODO: Style later — amber/warning-subtle is just the closest existing
     token hue-wise; this panel isn't really warning about anything, it's
     highlighting an inline "add new item" row. May want a dedicated
     highlight/draft token instead. -->
<div class="rounded-lg border border-border bg-warning-subtle/60">
	<ExpandBox id="add-item-panel" triggerClass="px-3 py-3">
		<span slot="trigger" class="flex items-center gap-2">
			<AppIcon name="product" size={16} class="text-text-muted" />
			Add item
		</span>
		<form method="post" action="/api/wizard/items" class="px-3 pb-3">
			<input type="hidden" name="redirectTo" value={redirectTo} />
			<div class="grid grid-cols-[10rem_5rem_1fr] items-end gap-3">
				<div>
					<label class="mb-1 block text-xs text-text-muted" for="add-item-image">Image (optional)</label>
					<input id="add-item-image" name="imageUrl" type="text" placeholder="https://…" class="w-full rounded border border-border-interactive px-2 py-1.5 text-sm" />
				</div>
				<div>
					<span class="mb-1 block text-xs text-text-muted">Item ID</span>
					<p class="rounded border border-dashed border-border-strong bg-surface px-2 py-1.5 font-mono text-xs text-text-muted">auto</p>
				</div>
				<div>
					<label class="mb-1 block text-xs text-text-muted" for="add-item-name">Item name</label>
					<input id="add-item-name" name="name" type="text" required class="w-full rounded border border-border-interactive px-2 py-1.5 text-sm" />
				</div>
			</div>
			<div class="mt-3 flex justify-end gap-2">
				<TextMorphButton type="reset" action="cancel" />
				<TextMorphButton type="submit" action="save" variant="primary">Save item</TextMorphButton>
			</div>
		</form>
	</ExpandBox>
</div>

---
// The Set dropdown's items are no longer simple buttons (see Dropdown.astro)
// — "Set product" needs real form controls, and everything here targets the
// panel's selection form by id (`form={formId}`) rather than nesting, since
// form elements can't nest and ItemRow.astro's per-attribute edit forms
// already live inside the row list.
//
// Assign/Unassign are gone — "Set product" now handles both assigning an
// unassigned item and reassigning an already-assigned one.
// Unassigned: | Set | ---- | Add item | Delete n item(s) |
// Assigned:   | Set | ---- | Delete n item(s)
import MorphIcon from 'morphicons/astro';
import { dropdownChevron } from '../../lib/icon-nodes';
import AppIcon from '../icons/AppIcon.astro';
import Button from '../ui/Button.astro';
import TextMorphButton from '../ui/TextMorphButton.astro';
import type { PanelVariant } from './grid';

interface Props {
	variant: PanelVariant;
	formId: string;
	products: { id: number; title: string }[];
	redirectTo: string;
}

const { variant, formId, products, redirectTo } = Astro.props;
---
<div class="flex items-center gap-2 border-b border-border bg-bg-subtle px-3 py-2">
	<details class="set-dropdown relative inline-block">
		<summary class="flex cursor-pointer list-none items-center gap-1 rounded border border-border-strong px-2.5 py-1.5 text-sm text-text hover:bg-bg-subtle [&::-webkit-details-marker]:hidden">
			<span>Set</span>
			<MorphIcon icon={dropdownChevron.closed} size={14} class="dropdown-chevron text-text-muted" />
		</summary>
		<div class="absolute left-0 z-10 mt-1 w-80 rounded-md border border-border bg-surface p-3 shadow-lg">
			<input type="hidden" name="redirectTo" value={redirectTo} form={formId} />
			<section class="border-b border-border pb-3">
				<p class="mb-1.5 flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-text-muted">
					<AppIcon name="image" size={13} /> Set image
				</p>
				<div class="flex items-center gap-2">
					<input type="text" name="imageUrl" form={formId} placeholder="https://…" class="min-w-0 flex-1 rounded border border-border-interactive px-2 py-1 text-sm" />
					<Button type="submit" size="sm" form={formId} formaction="/api/wizard/set-image" class="shrink-0">
						Apply
					</Button>
				</div>
			</section>

			<section class="py-3">
				<p class="mb-1.5 flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-text-muted">
					<AppIcon name="product" size={13} /> Set product
				</p>
				<div class="flex items-center gap-2">
					<select name="productId" form={formId} class="min-w-0 flex-1 rounded border border-border-interactive px-2 py-1 text-sm">
						<option value="" disabled selected>Choose a product…</option>
						{products.map((p) => (
							<option value={p.id}>{p.title}</option>
						))}
					</select>
					<Button type="submit" size="sm" form={formId} formaction="/api/wizard/set-product" class="shrink-0">
						Apply
					</Button>
				</div>
				<p class="mt-1 text-xs text-text-muted">Also how you reassign an already-assigned item to a <em>different</em> product — clears its old attribute values and stubs in the new product's fields. Re-applying the item's current product leaves its values untouched.</p>
			</section>
		</div>
	</details>

	<div class="flex-1"></div>

	{variant === 'unassigned' && (
		<TextMorphButton variant="primary" action="add" href="#add-item-name">
			Add item
		</TextMorphButton>
	)}
	<TextMorphButton variant="danger-filled" action="delete" type="submit" form={formId} formaction="/api/wizard/archive" data-archive-trigger={formId}>
		Delete <span class="selected-count" data-form-id={formId}>0</span> item(s)
	</TextMorphButton>
</div>

<script>
	// Same chevron-morph pattern as Dropdown.astro, duplicated rather than
	// reused because this trigger's menu content isn't a simple item list.
	import type { MorphIconElement } from 'morphicons/element';
	import { dropdownChevron } from '../../lib/icon-nodes';

	document.addEventListener(
		'toggle',
		(event) => {
			const details = event.target;
			if (!(details instanceof HTMLDetailsElement) || !details.classList.contains('set-dropdown')) return;
			const chevron = details.querySelector<MorphIconElement>('.dropdown-chevron');
			if (!chevron) return;
			chevron.icon = details.open ? dropdownChevron.open : dropdownChevron.closed;
		},
		true,
	);

	// Selection is client-only state (nothing persists it across the
	// full-page reload every wizard action does), so this count starts at 0
	// on every render and stays live via delegated `change` events rather
	// than being computed server-side.
	document.addEventListener('change', (event) => {
		const input = event.target;
		if (!(input instanceof HTMLInputElement) || !input.classList.contains('select-checkbox-input')) return;
		const formId = input.getAttribute('form');
		if (!formId) return;
		const count = document.querySelectorAll(`input.select-checkbox-input[form="${formId}"]:checked`).length;
		document.querySelectorAll(`.selected-count[data-form-id="${formId}"]`).forEach((el) => {
			el.textContent = String(count);
		});
	});

	// Guard against archiving with nothing selected — without this the form
	// still submits to /api/wizard/archive with an empty selection, which
	// just redirects back with no visible effect (see issue #200).
	document.querySelectorAll<HTMLElement>('[data-archive-trigger]').forEach((trigger) => {
		trigger.addEventListener('click', (event) => {
			const formId = trigger.getAttribute('data-archive-trigger');
			if (!formId) return;
			const count = document.querySelectorAll(`input.select-checkbox-input[form="${formId}"]:checked`).length;
			if (count === 0) {
				event.preventDefault();
				window.alert('Select at least one item to delete.');
			}
		});
	});
</script>

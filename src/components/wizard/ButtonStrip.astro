---
// The Set dropdown's panel holds real form controls ("Set product" needs a
// select), and everything here targets the
// panel's selection form by id (`form={formId}`) rather than nesting, since
// form elements can't nest and ItemRow.astro's per-attribute edit forms
// already live inside the row list.
//
// Assign/Unassign are gone — "Set product" now handles both assigning an
// unassigned item and reassigning an already-assigned one.
// | Set | ---- | (trash)
// Delete is icon-only and asks for confirmation via a popover. Adding items
// is done from AddItemPanel above, not from this strip.
import { eyebrowClasses } from '../../lib/layout-styles';
import { hintClasses, inputSmClasses } from '../../lib/form-styles';
import { tableToolbarClasses } from '../../lib/table-styles';
import AppIcon from '../icons/AppIcon.astro';
import Button from '../ui/Button.astro';
import Callout from '../ui/Callout.astro';
import Dropdown from '../ui/Dropdown.astro';
import Popover from '../ui/Popover.astro';
import ActionPopover from '../ui/ActionPopover.astro';
import MorphButton from '../ui/MorphButton.astro';
import AssignWarning from './AssignWarning.astro';
import ImageMenu from './ImageMenu.astro';
import type { PanelVariant } from './grid';

interface Props {
	variant: PanelVariant;
	formId: string;
	products: { id: number; title: string }[];
	redirectTo: string;
}

const { variant, formId, products, redirectTo } = Astro.props;

const archiveHintId = `archive-hint-${formId}`;
const confirmId = `archive-confirm-${formId}`;
---
<div class={tableToolbarClasses}>
	<div class="relative inline-block">
	<AssignWarning variant={variant} reason="product_has_sets">
		Product can only be assigned items or sets.
	</AssignWarning>
	{/* Width tracks the viewport (never wider than the screen minus the
	    page gutter); height is left to the content — ImageMenu's explorer
	    box caps and scrolls itself as folders expand. */}
	<Dropdown triggerLabel="Set" panel="floating" panelClass="mt-2 w-[min(28rem,calc(100vw-2rem))]">
		<input type="hidden" name="redirectTo" value={redirectTo} form={formId} />
		<input type="hidden" name="panel" value={variant} form={formId} />
		<section class="border-b border-border pb-5">
			<p class:list={[eyebrowClasses, 'mb-snug flex items-center gap-1.5']}>
				<AppIcon name="image" size={14} /> Set image
			</p>
			<ImageMenu formId={formId} />
		</section>

		<section class="pt-5">
			<p class:list={[eyebrowClasses, 'mb-snug flex items-center gap-1.5']}>
				<AppIcon name="product" size={14} /> Set product
			</p>
			<div class="flex items-center gap-2">
				<select name="productId" form={formId} class:list={['min-w-0 flex-1', inputSmClasses]}>
					<option value="" disabled selected>Choose a product…</option>
					{products.map((p) => (
						<option value={p.id}>{p.title}</option>
					))}
				</select>
				<Button type="submit" size="sm" form={formId} formaction="/api/wizard/items/set-product" class="shrink-0">
					Apply
				</Button>
			</div>
			<p class:list={['mt-2', hintClasses]}>Also how you reassign an already-assigned item to a <em>different</em> product — clears its old attribute values and stubs in the new product's fields. Re-applying the item's current product leaves its values untouched.</p>
		</section>
	</Dropdown>
	</div>

	<div class="flex-1"></div>

	{/* Trigger stays a plain type="button" with `popovertarget` — the click
	    handler below cancels the popover's native open when nothing is
	    selected (showing the hint instead). Variant flips secondary →
	    danger-filled once something is selected. */}
	<ActionPopover id={confirmId} title="Delete selected items?" confirmLabel="Delete" confirmVariant="danger" side="bottom">
		<Fragment slot="trigger">
			<MorphButton
				variant="secondary"
				action="delete"
				label="Delete selected items"
				popovertarget={confirmId}
				data-archive-trigger={formId}
			/>
		</Fragment>
		<p class="text-sm text-text-muted">
			<span class="selected-count" data-form-id={formId}>0</span> item(s) will be deleted.
		</p>
	</ActionPopover>
</div>

{/* No `popovertarget` invoker element points at this — the archive button below
	must stay a plain submit button (see the click handler) — so it's shown via
	`showPopover()` and positioned manually in the click handler rather than by
	lib/popover.ts's own trigger lookup. */}
<Popover id={archiveHintId} placement="anchor" side="bottom" class="p-0 shadow-lg">
	<Callout variant="warning">Select at least one item to delete.</Callout>
</Popover>

<script>
	import { variantClasses } from '../../lib/button-styles';

	function countSelected(formId: string) {
		return document.querySelectorAll(`input.select-checkbox-input[form="${formId}"]:checked`).length;
	}

	// Selection is client-only state (nothing persists it across the
	// full-page reload every wizard action does), so this count starts at 0
	// on every render and stays live via delegated `change` events rather
	// than being computed server-side.
	document.addEventListener('change', (event) => {
		const input = event.target;
		if (!(input instanceof HTMLInputElement) || !input.classList.contains('select-checkbox-input')) return;
		const formId = input.getAttribute('form');
		if (!formId) return;
		const count = countSelected(formId);
		document.querySelectorAll(`.selected-count[data-form-id="${formId}"]`).forEach((el) => {
			el.textContent = String(count);
		});
		// Secondary when nothing is selected, filled once something is.
		document.querySelectorAll<HTMLElement>(`[data-archive-trigger="${formId}"]`).forEach((btn) => {
			const [off, on] = count > 0 ? ['secondary', 'danger-filled'] : ['danger-filled', 'secondary'];
			btn.classList.remove(...variantClasses[off as 'secondary'].split(' '));
			btn.classList.add(...variantClasses[on as 'secondary'].split(' '));
		});
		// The hint is only relevant while the selection is empty — dismiss it
		// as soon as the user checks an item, per HintPopover.astro's guidance
		// for hints shown in response to a transient condition.
		if (count > 0) {
			document.getElementById(`archive-hint-${formId}`)?.hidePopover();
		}
	});

	// Empty selection: cancel the trigger's native `popovertarget` open and
	// show the hint instead (see issue #200). Otherwise the confirm popover
	// opens natively and its Delete button submits the selection form.
	document.querySelectorAll<HTMLElement>('[data-archive-trigger]').forEach((trigger) => {
		const formId = trigger.getAttribute('data-archive-trigger');
		if (!formId) return;
		trigger.addEventListener('click', (event) => {
			if (countSelected(formId) > 0) return;
			event.preventDefault();
			const hint = document.getElementById(`archive-hint-${formId}`);
			if (!hint) return;
			const rect = trigger.getBoundingClientRect();
			hint.style.left = `${rect.left}px`;
			hint.style.top = `${rect.bottom + 8}px`;
			hint.showPopover();
		});

		const confirmPopover = document.getElementById(`archive-confirm-${formId}`);
		confirmPopover?.querySelector('[data-action-popover-confirm]')?.addEventListener('click', () => {
			confirmPopover.hidePopover();
			(document.getElementById(formId) as HTMLFormElement | null)?.requestSubmit();
		});
	});
</script>

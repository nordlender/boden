---
// Generic dropdown/menu primitive, built on <details>/<summary> so it needs
// no client-side JS beyond animating its own chevron. Backs the Set (Set
// image / Set product) button.
import AppIcon from '../icons/AppIcon.astro';
import { summaryButtonClasses } from '../../lib/button-styles';
import { menuItemClasses, menuPanelClasses } from '../../lib/layout-styles';
import MorphIcon from 'morphicons/astro';
import type { IconName } from '../../lib/icons';
import { dropdownChevron } from '../../lib/icon-nodes';

interface MenuItem {
	label: string;
	icon?: IconName;
}

interface Props {
	triggerLabel?: string;
	triggerIcon?: IconName;
	items: MenuItem[];
	align?: 'left' | 'right';
}

const { triggerLabel, triggerIcon, items, align = 'left' } = Astro.props;
---
<details class="relative inline-block">
	<summary class={summaryButtonClasses}>
		{triggerIcon && <AppIcon name={triggerIcon} size={16} />}
		{triggerLabel && <span>{triggerLabel}</span>}
		<MorphIcon icon={dropdownChevron.closed} size={14} class="dropdown-chevron text-text-muted" />
	</summary>
	<div class:list={['absolute z-10 mt-2 min-w-[12rem]', menuPanelClasses, align === 'right' ? 'right-0' : 'left-0']}>
		{items.map((item) => (
			<button type="button" class={menuItemClasses}>
				{item.icon && <AppIcon name={item.icon} size={16} class="text-text-muted" />}
				<span>{item.label}</span>
			</button>
		))}
	</div>
</details>

<script>
	// Delegated (this script runs once per page, not once per Dropdown
	// instance) so it covers every <details> this component renders.
	// `toggle` doesn't bubble, so the listener has to sit on the capture
	// phase to see it at all.
	import type { MorphIconElement } from 'morphicons/element';
	import { dropdownChevron } from '../../lib/icon-nodes';

	document.addEventListener(
		'toggle',
		(event) => {
			const details = event.target;
			if (!(details instanceof HTMLDetailsElement)) return;
			const chevron = details.querySelector<MorphIconElement>('.dropdown-chevron');
			if (!chevron) return;
			chevron.icon = details.open ? dropdownChevron.open : dropdownChevron.closed;
		},
		true,
	);
</script>

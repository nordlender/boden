---
import SelectIcon from './SelectIcon.astro';
import Thumbnail from './Thumbnail.astro';
import SubCategoryTag from './SubCategoryTag.astro';
import ProductTag from './ProductTag.astro';
import StockIndicator from './StockIndicator.astro';
import DetailsToggle from './DetailsToggle.astro';
import AppIcon from '../icons/AppIcon.astro';
import { GRID_TEMPLATE, type PanelVariant } from './grid';

interface AttributeEntry {
	key: string;
	value: string;
}

interface Props {
	variant: PanelVariant;
	formId: string;
	itemId: number;
	selected?: boolean;
	image?: string | null;
	name: string;
	subCategory?: string;
	product?: string;
	inStock: number;
	totalStock: number;
	// Description and attributes are inherited from the item's product, so
	// both are absent until the item is assigned — see dynamic_wizard.md's
	// "What's inherited from the product" notes.
	description?: string | null;
	attributes?: AttributeEntry[];
	missingAttributeTemplate?: boolean;
}

const {
	variant,
	formId,
	itemId,
	selected = false,
	image,
	name,
	subCategory,
	product,
	inStock,
	totalStock,
	description,
	attributes = [],
	missingAttributeTemplate = false,
} = Astro.props;
---
<div class="item-row border-b border-slate-100 last:border-b-0">
	<div
		class:list={["grid items-center gap-3 px-3 py-2 hover:bg-slate-50", selected && 'bg-blue-50/60 hover:bg-blue-50']}
		style={`grid-template-columns: ${GRID_TEMPLATE[variant]}`}
	>
		<SelectIcon itemId={itemId} formId={formId} checked={selected} label={`Select ${name}`} />
		<Thumbnail src={image} alt={name} />
		<div class="min-w-0">
			<p class="truncate text-sm font-medium text-slate-800">{name}</p>
			<p class="font-mono text-xs text-slate-400">#{itemId}</p>
		</div>
		{variant === 'assigned' && (subCategory ? <SubCategoryTag name={subCategory} /> : <span></span>)}
		{variant === 'assigned' && product && <ProductTag name={product} />}
		<StockIndicator inStock={inStock} total={totalStock} />
		<DetailsToggle label={`Show details for ${name}`} warning={missingAttributeTemplate} />
	</div>
	<div class="item-details hidden border-t border-slate-100 bg-slate-50/60 px-4 py-4">
		<div class="flex gap-4">
			<Thumbnail src={image} alt={name} size={112} />
			<div class="min-w-0 flex-1">
				{description ? (
					<p class="text-sm text-slate-600">{description}</p>
				) : (
					<p class="text-sm italic text-slate-400">No description yet — inherited from the assigned product.</p>
				)}
				<div class="mt-3 flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-slate-400">
					<AppIcon name="attribute" size={14} />
					Attributes
				</div>
				{variant === 'assigned' ? (
					<div class="mt-1 flex flex-col gap-1">
						{attributes.map((attribute) => (
							<details class="attribute-row group/edit">
								<summary class="flex cursor-pointer list-none items-center gap-3 py-0.5 text-sm [&::-webkit-details-marker]:hidden">
									<span class="w-28 shrink-0 text-slate-500">{attribute.key}</span>
									<span class="min-w-0 flex-1 truncate text-slate-700">{attribute.value || '—'}</span>
									<AppIcon name="edit" size={13} class="shrink-0 text-slate-300 group-hover/edit:text-slate-500" />
								</summary>
								<form method="post" action="/api/wizard/attributes" class="ml-[7.75rem] mt-1 flex items-center gap-2">
									<input type="hidden" name="itemId" value={itemId} />
									<input type="hidden" name="key" value={attribute.key} />
									<input type="hidden" name="redirectTo" value={Astro.url.pathname} />
									<input
										type="text"
										name="value"
										value={attribute.value}
										class="min-w-0 flex-1 rounded border border-slate-300 px-2 py-1 text-sm"
									/>
									<button type="submit" class="rounded border border-slate-300 px-2 py-1 text-xs text-slate-600 hover:bg-white">Save</button>
								</form>
							</details>
						))}
						<form method="post" action="/api/wizard/attributes" class="mt-1 flex items-center gap-2">
							<input type="hidden" name="itemId" value={itemId} />
							<input type="hidden" name="redirectTo" value={Astro.url.pathname} />
							<input
								type="text"
								name="key"
								placeholder="New attribute"
								class="w-28 shrink-0 rounded border border-slate-300 px-2 py-1 text-sm"
							/>
							<input
								type="text"
								name="value"
								placeholder="Value"
								class="min-w-0 flex-1 rounded border border-slate-300 px-2 py-1 text-sm"
							/>
							<button type="submit" class="rounded border border-slate-300 px-2 py-1 text-xs text-slate-600 hover:bg-white">Add</button>
						</form>
					</div>
				) : (
					<p class="mt-1 text-sm italic text-slate-400">No attributes yet — inherited from the assigned product.</p>
				)}
			</div>
		</div>
	</div>
</div>

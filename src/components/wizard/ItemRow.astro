---
import SelectIcon from './SelectIcon.astro';
import Thumbnail from './Thumbnail.astro';
import SubCategoryTag from './SubCategoryTag.astro';
import ProductTag from './ProductTag.astro';
import StockIndicator from './StockIndicator.astro';
import DetailsToggle from './DetailsToggle.astro';
import AppIcon from '../icons/AppIcon.astro';
import { GRID_TEMPLATE, type PanelVariant } from './grid';

interface AttributeEntry {
	key: string;
	value: string;
}

interface Props {
	variant: PanelVariant;
	selected?: boolean;
	image?: string | null;
	itemId: string | number;
	name: string;
	subCategory?: string;
	product?: string;
	inStock: number;
	totalStock: number;
	// Description and attributes are inherited from the item's product, so
	// both are absent until the item is assigned — see dynamic_wizard.md's
	// "Type vs Attributes" (now "Category vs Attributes") notes.
	description?: string;
	attributes?: AttributeEntry[];
}

const {
	variant,
	selected = false,
	image,
	itemId,
	name,
	subCategory,
	product,
	inStock,
	totalStock,
	description,
	attributes = [],
} = Astro.props;
---
<div class="item-row border-b border-slate-100 last:border-b-0">
	<div
		class:list={["grid items-center gap-3 px-3 py-2 hover:bg-slate-50", selected && 'bg-blue-50/60 hover:bg-blue-50']}
		style={`grid-template-columns: ${GRID_TEMPLATE[variant]}`}
	>
		<SelectIcon state={selected ? 'checked' : 'unchecked'} label={`Select ${name}`} />
		<Thumbnail src={image} alt={name} />
		<div class="min-w-0">
			<p class="truncate text-sm font-medium text-slate-800">{name}</p>
			<p class="font-mono text-xs text-slate-400">#{itemId}</p>
		</div>
		{variant === 'assigned' && subCategory && <SubCategoryTag name={subCategory} />}
		{variant === 'assigned' && product && <ProductTag name={product} />}
		<StockIndicator inStock={inStock} total={totalStock} />
		<DetailsToggle label={`Show details for ${name}`} />
	</div>
	<div class="item-details hidden border-t border-slate-100 bg-slate-50/60 px-4 py-4">
		<div class="flex gap-4">
			<Thumbnail src={image} alt={name} size={112} />
			<div class="min-w-0 flex-1">
				{description ? (
					<p class="text-sm text-slate-600">{description}</p>
				) : (
					<p class="text-sm italic text-slate-400">No description yet — inherited from the assigned product.</p>
				)}
				<div class="mt-3 flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-slate-400">
					<AppIcon name="attribute" size={14} />
					Attributes
				</div>
				{attributes.length > 0 ? (
					<dl class="mt-1 grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1 text-sm">
						{attributes.map((attribute) => (
							<>
								<dt class="text-slate-500">{attribute.key}</dt>
								<dd class="text-slate-700">{attribute.value}</dd>
							</>
						))}
					</dl>
				) : (
					<p class="mt-1 text-sm italic text-slate-400">No attributes yet — inherited from the assigned product.</p>
				)}
			</div>
		</div>
	</div>
</div>

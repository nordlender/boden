---
import SelectIcon from './SelectIcon.astro';
import Thumbnail from './Thumbnail.astro';
import SubCategoryTag from './SubCategoryTag.astro';
import ProductTag from './ProductTag.astro';
import StockIndicator from './StockIndicator.astro';
import DetailsToggle from './DetailsToggle.astro';
import AppIcon from '../icons/AppIcon.astro';
import { GRID_TEMPLATE, type PanelVariant } from './grid';

interface AttributeEntry {
	key: string;
	value: string;
}

interface Props {
	variant: PanelVariant;
	formId: string;
	itemId: number;
	selected?: boolean;
	image?: string | null;
	name: string;
	subCategory?: string;
	product?: string;
	inStock: number;
	totalStock: number;
	// Description and attributes are inherited from the item's product, so
	// both are absent until the item is assigned — see docs/wizard.md's
	// "What's inherited from the product" notes.
	description?: string | null;
	attributes?: AttributeEntry[];
	missingAttributeTemplate?: boolean;
	serviceQuantity?: number;
}

const {
	variant,
	formId,
	itemId,
	selected = false,
	image,
	name,
	subCategory,
	product,
	inStock,
	totalStock,
	description,
	attributes = [],
	missingAttributeTemplate = false,
	serviceQuantity = 0,
} = Astro.props;
---
<div class="item-row border-b border-border last:border-b-0">
	<div
		class:list={["grid items-center gap-3 px-3 py-2 hover:bg-bg-subtle", selected && 'bg-selected-subtle/60 hover:bg-selected-subtle']}
		style={`grid-template-columns: ${GRID_TEMPLATE[variant]}`}
	>
		<SelectIcon itemId={itemId} formId={formId} checked={selected} label={`Select ${name}`} />
		<Thumbnail src={image} alt={name} />
		<div class="min-w-0">
			<p class="flex items-center gap-1.5 truncate text-sm font-medium text-text">
				{name}
				{serviceQuantity > 0 && (
					<span class="shrink-0 rounded border border-warning-border bg-warning-subtle px-1 py-px text-[10px] font-normal uppercase tracking-wide text-warning-text">
						{serviceQuantity} in service
					</span>
				)}
			</p>
			<p class="font-mono text-xs text-text-muted">#{itemId}</p>
		</div>
		{variant === 'assigned' && (subCategory ? <SubCategoryTag name={subCategory} /> : <span></span>)}
		{variant === 'assigned' && product && <ProductTag name={product} />}
		<StockIndicator inStock={inStock} total={totalStock} />
		<DetailsToggle label={`Show details for ${name}`} warning={missingAttributeTemplate} />
	</div>
	<div class="item-details hidden border-t border-border bg-bg-subtle/60 px-4 py-4">
		<div class="flex gap-4">
			<Thumbnail src={image} alt={name} size={112} />
			<div class="min-w-0 flex-1">
				{description ? (
					<p class="text-sm text-text-muted">{description}</p>
				) : (
					<p class="text-sm italic text-text-muted">No description yet — inherited from the assigned product.</p>
				)}
				<div class="mt-3 flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-text-muted">
					<AppIcon name="attribute" size={14} />
					Attributes
				</div>
				{variant === 'assigned' ? (
					<div class="mt-1 flex flex-col gap-1">
						{attributes.map((attribute) => (
							<details class="attribute-row group/edit">
								<summary class="flex cursor-pointer list-none items-center gap-3 py-0.5 text-sm [&::-webkit-details-marker]:hidden">
									<span class="w-28 shrink-0 text-text-muted">{attribute.key}</span>
									<span class="min-w-0 flex-1 truncate text-text">{attribute.value || '—'}</span>
									<AppIcon name="edit" size={13} class="shrink-0 text-disabled-text group-hover/edit:text-text-muted" />
								</summary>
								<form method="post" action="/api/wizard/attributes" class="ml-[7.75rem] mt-1 flex items-center gap-2">
									<input type="hidden" name="itemId" value={itemId} />
									<input type="hidden" name="key" value={attribute.key} />
									<input type="hidden" name="redirectTo" value={Astro.url.pathname} />
									<input
										type="text"
										name="value"
										value={attribute.value}
										class="min-w-0 flex-1 rounded border border-border-interactive px-2 py-1 text-sm"
									/>
									<button type="submit" class="rounded border border-border-strong px-2 py-1 text-xs text-text-muted hover:bg-surface">Save</button>
								</form>
							</details>
						))}
						<form method="post" action="/api/wizard/attributes" class="mt-1 flex items-center gap-2">
							<input type="hidden" name="itemId" value={itemId} />
							<input type="hidden" name="redirectTo" value={Astro.url.pathname} />
							<input
								type="text"
								name="key"
								placeholder="New attribute"
								class="w-28 shrink-0 rounded border border-border-interactive px-2 py-1 text-sm"
							/>
							<input
								type="text"
								name="value"
								placeholder="Value"
								class="min-w-0 flex-1 rounded border border-border-interactive px-2 py-1 text-sm"
							/>
							<button type="submit" class="rounded border border-border-strong px-2 py-1 text-xs text-text-muted hover:bg-surface">Add</button>
						</form>
					</div>
				) : (
					<p class="mt-1 text-sm italic text-text-muted">No attributes yet — inherited from the assigned product.</p>
				)}

				<div class="mt-3 flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-text-muted">
					<AppIcon name="warning" size={14} />
					Service / quarantine
				</div>
				<p class="mt-0.5 text-xs text-text-muted">
					Quantity pulled out for repair or inspection — excluded from stock everywhere until an admin sets this back to 0. Doesn't affect past orders.
				</p>
				<form
					method="post"
					action="/api/wizard/service"
					class="service-quantity-form mt-1.5 flex flex-col gap-1"
					data-in-stock={inStock}
					data-service-quantity={serviceQuantity}
				>
					<input type="hidden" name="itemId" value={itemId} />
					<input type="hidden" name="redirectTo" value={Astro.url.pathname} />
					<div class="flex items-center gap-2">
						<input
							type="number"
							name="quantity"
							min="0"
							max={totalStock}
							value={serviceQuantity}
							class="service-quantity-input w-20 shrink-0 rounded border border-border-interactive px-2 py-1 text-sm"
						/>
						<span class="text-xs text-text-muted">of {totalStock} total</span>
						<button type="submit" class="rounded border border-border-strong px-2 py-1 text-xs text-text-muted hover:bg-surface">Save</button>
					</div>
					<p class="service-quantity-warning hidden text-xs text-warning-text" role="alert"></p>
				</form>
			</div>
		</div>
	</div>
</div>

<script>
	// Real-time client-side warning (issue #88): as the admin edits the
	// service-quantity input, project what inStock would become and flag it
	// if that's negative — reserved units already committed beyond what's
	// left after pulling this many out for service. Doesn't block submit;
	// the server-side setItemServiceQuantity check (stockCount bounds only)
	// still applies separately.
	document.addEventListener('input', (event) => {
		const input = (event.target as Element).closest<HTMLInputElement>('.service-quantity-input');
		if (!input) return;
		const form = input.closest<HTMLFormElement>('.service-quantity-form');
		const warning = form?.querySelector<HTMLElement>('.service-quantity-warning');
		if (!form || !warning) return;

		const inStock = Number(form.dataset.inStock);
		const serviceQuantity = Number(form.dataset.serviceQuantity);
		const newQuantity = Number(input.value);
		if (!Number.isFinite(newQuantity)) {
			warning.classList.add('hidden');
			return;
		}

		// inStock already has the current serviceQuantity subtracted out, so
		// re-add it and subtract the value the admin is about to submit.
		const projectedInStock = inStock + serviceQuantity - newQuantity;
		if (projectedInStock < 0) {
			warning.textContent = `This would leave stock at ${projectedInStock} — more is already reserved than would be left.`;
		}
		warning.classList.toggle('hidden', projectedInStock >= 0);
	});
</script>

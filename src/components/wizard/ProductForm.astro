---
// Shared create/edit form for /admin/products/new and
// /admin/products/[id]/edit — same field shape either way (see
// lib/productForm.ts's parseProductForm, which both API routes share).
//
// Attribute keys are additive-only in edit mode (see products.ts's
// updateProduct comment): an existing key can't be renamed or removed from
// this form, only new ones added. Reconciling/removing a key that already
// has real item values is a separate, larger piece of work — this form
// deliberately doesn't attempt it.
import AppIcon from '../icons/AppIcon.astro';
import { actionRowClasses, cardClasses, sectionTitleClasses } from '../../lib/layout-styles';
import { compactLabelClasses, hintClasses, inputClasses } from '../../lib/form-styles';
import { chipBaseClasses } from '../../lib/button-styles';
import TextMorphButton from '../ui/TextMorphButton.astro';
import MorphButton from '../ui/MorphButton.astro';
import type { CategoryOption, SubcategoryOption, ProductForEdit } from '../../lib/products';

interface Props {
	mode: 'create' | 'edit';
	product?: ProductForEdit;
	categories: CategoryOption[];
	subcategories: SubcategoryOption[];
	redirectTo: string;
}

const { mode, product, categories, subcategories, redirectTo } = Astro.props;

const action = mode === 'create' ? '/api/products/create' : `/api/products/${product!.id}/update`;
const links = product?.links ?? [];
const existingAttributeKeys = product?.attributeKeys ?? [];
---

<form method="post" action={action} class="flex flex-col gap-block">
	<input type="hidden" name="redirectTo" value={redirectTo} />

	<section class:list={[cardClasses, 'flex flex-col gap-stack p-card']}>
		<h2 class={sectionTitleClasses}>Basics</h2>

		<div>
			<label class={compactLabelClasses} for="product-title">Title</label>
			<input
				id="product-title"
				name="title"
				type="text"
				required
				value={product?.title}
				class:list={['w-full', inputClasses]}
			/>
		</div>

		<div>
			<label class={compactLabelClasses} for="product-description">Description</label>
			<textarea
				id="product-description"
				name="description"
				rows="3"
				class:list={['w-full', inputClasses]}
				set:text={product?.description ?? ''}
			/>
		</div>

		<div class="grid grid-cols-2 gap-stack">
			<div>
				<label class={compactLabelClasses} for="product-category">Category</label>
				<select id="product-category" name="categoryId" data-category-select class:list={['w-full', inputClasses]}>
					<option value="">None</option>
					{categories.map((category) => (
						<option value={category.id} selected={category.id === product?.categoryId}>
							{category.name}
						</option>
					))}
				</select>
			</div>
			<div>
				<label class={compactLabelClasses} for="product-subcategory">Sub-category</label>
				<select id="product-subcategory" name="subcategoryId" data-subcategory-select class:list={['w-full', inputClasses]}>
					<option value="">None</option>
					{subcategories.map((subcategory) => (
						<option value={subcategory.id} data-category-id={subcategory.categoryId} selected={subcategory.id === product?.subcategoryId}>
							{subcategory.name}
						</option>
					))}
				</select>
			</div>
		</div>

		<div class="grid grid-cols-2 gap-stack">
			<div>
				<label class={compactLabelClasses} for="product-status">Status</label>
				<select id="product-status" name="status" class:list={['w-full', inputClasses]}>
					<option value="hidden" selected={(product?.status ?? 'hidden') === 'hidden'}>Hidden</option>
					<option value="published" selected={product?.status === 'published'}>Published</option>
				</select>
			</div>
			<div>
				<label class={compactLabelClasses} for="product-thumbnail">Thumbnail image URL</label>
				<input
					id="product-thumbnail"
					name="thumbnailImageUrl"
					type="text"
					placeholder="https://…"
					value={product?.thumbnailImageUrl ?? ''}
					class:list={['w-full', inputClasses]}
				/>
			</div>
		</div>
	</section>

	<section class:list={[cardClasses, 'flex flex-col gap-stack p-card']}>
		<div class="flex items-center justify-between">
			<h2 class={sectionTitleClasses}>Links</h2>
			<TextMorphButton action="add" size="sm" data-add-row="links">Add link</TextMorphButton>
		</div>
		<p class={hintClasses}>External links shown on the product page — manufacturer page, manual PDF, etc.</p>

		<div data-row-list="links" class="flex flex-col gap-3">
			{links.map((link) => (
				<div class="flex items-center gap-2" data-row>
					<input name="linkLabel[]" type="text" placeholder="Label" value={link.label} class:list={['w-40', inputClasses]} />
					<input name="linkUrl[]" type="text" placeholder="https://…" value={link.url} class:list={['min-w-0 flex-1', inputClasses]} />
					<MorphButton action="delete" variant="danger" label="Remove link" data-remove-row />
				</div>
			))}
		</div>

		<template data-row-template="links">
			<div class="flex items-center gap-2" data-row>
				<input name="linkLabel[]" type="text" placeholder="Label" class:list={['w-40', inputClasses]} />
				<input name="linkUrl[]" type="text" placeholder="https://…" class:list={['min-w-0 flex-1', inputClasses]} />
				<MorphButton action="delete" variant="danger" label="Remove link" data-remove-row />
			</div>
		</template>
	</section>

	<section class:list={[cardClasses, 'flex flex-col gap-stack p-card']}>
		<div class="flex items-center gap-2">
			<AppIcon name="attribute" size={16} class="text-text-muted" />
			<h2 class={sectionTitleClasses}>Attributes</h2>
		</div>
		<p class={hintClasses}>
		The field template every item under this product will have (e.g. "Weight", "Size", "Color") — each item fills in its own value per key. {mode === 'edit' && 'Existing keys can\'t be renamed or removed from here, only added to.'}
		</p>

		<p class={hintClasses}>
			{mode === 'create' ? (
				<>
					Once saved, you can click a key to make it the <span class="font-medium text-text">variant</span> — shoppers choose between its values as buttons on the product page.
				</>
			) : (
				<>
					Click a key to make it the <span class="font-medium text-text">variant</span> — shoppers choose between its values as buttons on the product page, and it's left out of the attribute list. Click it again to unset. Newly added keys can be set as the variant after saving.
				</>
			)}
		</p>

		<input type="hidden" name="variantAttributeKey" value={existingAttributeKeys.find((key) => key.isVariant)?.name ?? ''} autocomplete="off" data-variant-input />

		{existingAttributeKeys.length > 0 && (
			<div class="flex flex-wrap gap-2">
				{existingAttributeKeys.map((key) => (
					<button type="button" data-variant-toggle data-name={key.name} aria-pressed={key.isVariant ? 'true' : 'false'} class:list={[chipBaseClasses, 'border-border-strong text-text-muted hover:bg-bg-subtle hover:text-text aria-pressed:border-accent aria-pressed:bg-transparent aria-pressed:text-accent-text aria-pressed:hover:bg-accent-subtle']}>
						{key.name}
					</button>
				))}
			</div>
		)}

		<div class="flex items-center justify-between">
			<span class="text-xs font-medium text-text-muted">{mode === 'edit' ? 'Add attribute key' : 'Attribute keys'}</span>
			<TextMorphButton action="add" size="sm" data-add-row="attributes">Add key</TextMorphButton>
		</div>

		<div data-row-list="attributes" class="flex flex-col gap-3">
			{mode === 'create' && (
				<div class="flex items-center gap-2" data-row>
					<input name="attributeKey[]" type="text" placeholder="e.g. Size" class:list={['min-w-0 flex-1', inputClasses]} />
					<MorphButton action="delete" variant="danger" label="Remove attribute key" data-remove-row />
				</div>
			)}
		</div>

		<template data-row-template="attributes">
			<div class="flex items-center gap-2" data-row>
				<input name="attributeKey[]" type="text" placeholder="e.g. Size" class:list={['min-w-0 flex-1', inputClasses]} />
				<MorphButton action="delete" variant="danger" label="Remove attribute key" data-remove-row />
			</div>
		</template>
	</section>

	<div class={actionRowClasses}>
		<TextMorphButton href={redirectTo} action="cancel" />
		<TextMorphButton type="submit" action="save" variant="primary">{mode === 'create' ? 'Create product' : 'Save changes'}</TextMorphButton>
	</div>
</form>

<script>
	// Repeatable-row add/remove for the Links and Attributes sections above —
	// both lists are plain form fields (linkLabel[]/linkUrl[]/attributeKey[]),
	// so removing a row's DOM node is enough to drop it from submission; no
	// index bookkeeping needed.
	document.querySelectorAll<HTMLButtonElement>('[data-add-row]').forEach((button) => {
		button.addEventListener('click', () => {
			const key = button.dataset.addRow;
			const template = document.querySelector<HTMLTemplateElement>(`template[data-row-template="${key}"]`);
			const list = document.querySelector<HTMLElement>(`[data-row-list="${key}"]`);
			if (!template || !list) return;
			const row = template.content.cloneNode(true);
			list.appendChild(row);
		});
	});

	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;
		const removeButton = target.closest<HTMLElement>('[data-remove-row]');
		if (!removeButton) return;
		removeButton.closest('[data-row]')?.remove();
	});

	// Variant toggle: at most one existing key is the variant (the hidden
	// input holds its name; empty means none). Clicking the pressed key unsets
	// it. Keys added in this same save have no pill yet — set the variant
	// after saving.
	const variantInput = document.querySelector<HTMLInputElement>('[data-variant-input]');

	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element) || !variantInput) return;
		const toggle = target.closest<HTMLElement>('[data-variant-toggle]');
		if (!toggle) return;
		const wasPressed = toggle.getAttribute('aria-pressed') === 'true';
		document.querySelectorAll('[data-variant-toggle]').forEach((other) => other.setAttribute('aria-pressed', 'false'));
		toggle.setAttribute('aria-pressed', String(!wasPressed));
		variantInput.value = wasPressed ? '' : (toggle.dataset.name ?? '');
	});

	// Sub-category options are filtered to the currently selected category —
	// all options are rendered server-side (small table) with a
	// data-category-id tag. The list is rebuilt from a snapshot rather than
	// toggling [hidden] on options, which Safari ignores. Runs once on load
	// (so an edit page's pre-selected subcategory is kept) and on every
	// category change; a selection that no longer matches resets to "None".
	const categorySelect = document.querySelector<HTMLSelectElement>('[data-category-select]');
	const subcategorySelect = document.querySelector<HTMLSelectElement>('[data-subcategory-select]');
	const allSubcategoryOptions = Array.from(subcategorySelect?.querySelectorAll<HTMLOptionElement>('option[data-category-id]') ?? []);
	const noneOption = subcategorySelect?.querySelector<HTMLOptionElement>('option:not([data-category-id])');

	function filterSubcategories() {
		if (!categorySelect || !subcategorySelect || !noneOption) return;
		const selectedId = subcategorySelect.value;
		const matching = allSubcategoryOptions.filter((option) => option.dataset.categoryId === categorySelect.value);
		subcategorySelect.replaceChildren(noneOption, ...matching);
		subcategorySelect.value = matching.some((option) => option.value === selectedId) ? selectedId : '';
	}

	categorySelect?.addEventListener('change', filterSubcategories);
	filterSubcategories();
</script>

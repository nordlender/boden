---
// "on shelf / total owned" — real availability (src/lib/availability.ts),
// right-aligned with tabular figures so the digits line up down the column;
// red when nothing is on the shelf.
interface Props {
	inStock: number;
	total: number;
}

const { inStock, total } = Astro.props;
---
<span class:list={["tabular-nums text-sm text-right", inStock <= 0 ? 'text-error' : 'text-text']} title={`${inStock} on the shelf now, ${total} owned`}>
	<span class="font-medium">{inStock}</span>
	<span class="text-text-muted"> / {total}</span>
</span>

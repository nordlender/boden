---
// Inherited from the item's product, same as ProductTag — only rendered in
// the Assigned panel (see ItemRow.astro).
import AppIcon from '../icons/AppIcon.astro';

interface Props {
	name: string;
}

const { name } = Astro.props;
---
<span class="inline-flex max-w-full items-center gap-1 truncate rounded-full bg-warning-subtle px-2 py-0.5 text-xs text-warning-text" title={name}>
	<AppIcon name="subCategory" size={14} class="shrink-0 text-warning" />
	<span class="truncate">{name}</span>
</span>

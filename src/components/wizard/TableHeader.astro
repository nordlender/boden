---
// Column labels, sharing ItemRow's exact grid so SelectMenu lands directly
// above every row's select icon.
import SelectMenu from './SelectMenu.astro';
import { GRID_TEMPLATE, type PanelVariant } from './grid';

interface Props {
	variant: PanelVariant;
	formId: string;
}

const { variant, formId } = Astro.props;
---
<div
	class="grid items-center gap-3 border-b border-border px-3 py-1.5 text-xs font-medium uppercase tracking-wide text-text-muted"
	style={`grid-template-columns: ${GRID_TEMPLATE[variant]}`}
>
	<SelectMenu formId={formId} />
	<span></span>
	<span>Item</span>
	{variant === 'assigned' && <span>Sub-category</span>}
	{variant === 'assigned' && <span>Product</span>}
	<span class="text-right">Stock</span>
	<span></span>
</div>

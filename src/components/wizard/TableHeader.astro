---
// Column labels, sharing ItemRow's exact grid so SelectMenu lands directly
// above every row's select icon.
import SelectMenu from './SelectMenu.astro';
import { gridTableHeaderClasses } from '../../lib/table-styles';
import { DESKTOP_ONLY_CLASS, GRID_COLUMNS_CLASS, gridColumnsStyle, type PanelVariant } from './grid';

interface Props {
	variant: PanelVariant;
	formId: string;
}

const { variant, formId } = Astro.props;
---
<div
	class:list={['grid', gridTableHeaderClasses, GRID_COLUMNS_CLASS]}
	style={gridColumnsStyle(variant)}
>
	<SelectMenu formId={formId} />
	<span></span>
	<span>Item</span>
	{variant === 'assigned' && <span class={DESKTOP_ONLY_CLASS}>Sub-category</span>}
	{variant === 'assigned' && <span class={DESKTOP_ONLY_CLASS}>Product</span>}
	<span class="text-right" title="Real availability: on the shelf now / total owned">On shelf</span>
	<span></span>
</div>

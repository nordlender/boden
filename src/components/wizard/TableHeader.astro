---
// Column labels, sharing ItemRow's exact grid so the select-all icon lands
// directly above every row's select icon.
import SelectIcon from './SelectIcon.astro';
import { GRID_TEMPLATE, type PanelVariant } from './grid';

interface Props {
	variant: PanelVariant;
	selectState?: 'unchecked' | 'checked' | 'indeterminate';
}

const { variant, selectState = 'unchecked' } = Astro.props;
---
<div
	class="grid items-center gap-3 border-b border-slate-200 px-3 py-1.5 text-xs font-medium uppercase tracking-wide text-slate-400"
	style={`grid-template-columns: ${GRID_TEMPLATE[variant]}`}
>
	<SelectIcon state={selectState} label="Select all" />
	<span></span>
	<span>Item</span>
	{variant === 'assigned' && <span>Product</span>}
	<span class="text-right">Stock</span>
	<span class="justify-self-center">Attrs</span>
</div>

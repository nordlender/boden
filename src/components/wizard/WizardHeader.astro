---
import AppIcon from '../icons/AppIcon.astro';
import { pageTitleClasses } from '../../lib/layout-styles';
import { inputClasses } from '../../lib/form-styles';

interface Props {
	title: string;
}

const { title } = Astro.props;
---
<div class="flex flex-wrap items-center justify-between gap-stack">
	<h1 class={pageTitleClasses}>{title}</h1>
	<div class="relative w-full sm:w-80">
		<AppIcon name="search" size={16} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-text-muted" />
		<input
			type="search"
			placeholder="Search items..."
			class:list={[inputClasses, 'w-full pl-9']}
		/>
	</div>
</div>

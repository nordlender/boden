---
// Collapsed by default, same ui/AddPanel.astro shell and AddRecordFields
// as /admin/items' AddItemPanel.astro. Label isn't collected here — it's
// meaningless until the set exists (same reasoning AddItemPanel gives for
// dropping product-dependent fields at creation time).
import AddPanel from '../../ui/AddPanel.astro';
import AddRecordFields from '../AddRecordFields.astro';

interface Props {
	redirectTo: string;
}

const { redirectTo } = Astro.props;
---
<AddPanel id="add-set-panel" label="Add set" icon="set" action="/api/wizard/sets" submitLabel="Save set">
	<input type="hidden" name="redirectTo" value={redirectTo} />
	<AddRecordFields noun="set" />
</AddPanel>

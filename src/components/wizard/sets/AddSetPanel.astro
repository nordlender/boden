---
// Collapsed by default, same issue #206-style ExpandBox pattern as
// /admin/items' AddItemPanel.astro. Label isn't collected here — it's
// meaningless until the set exists (same reasoning AddItemPanel gives for
// dropping product-dependent fields at creation time).
import AppIcon from '../../icons/AppIcon.astro';
import TextMorphButton from '../../ui/TextMorphButton.astro';
import ExpandBox from '../../ui/ExpandBox.astro';

interface Props {
	redirectTo: string;
}

const { redirectTo } = Astro.props;
---
<!-- TODO: Style later — see AddItemPanel.astro's identical TODO on the
     warning-subtle background. -->
<div class="rounded-lg border border-border bg-warning-subtle/60">
	<ExpandBox id="add-set-panel" triggerClass="px-3 py-3">
		<span slot="trigger" class="flex items-center gap-2">
			<AppIcon name="set" size={16} class="text-text-muted" />
			Add set
		</span>
		<form method="post" action="/api/wizard/sets" class="px-3 pb-3">
			<input type="hidden" name="redirectTo" value={redirectTo} />
			<div class="grid grid-cols-[10rem_5rem_1fr] items-end gap-3">
				<div>
					<label class="mb-1 block text-xs text-text-muted" for="add-set-image">Image (optional)</label>
					<input id="add-set-image" name="imageUrl" type="text" placeholder="https://…" class="w-full rounded border border-border-interactive px-2 py-1.5 text-sm" />
				</div>
				<div>
					<span class="mb-1 block text-xs text-text-muted">Set ID</span>
					<p class="rounded border border-dashed border-border-strong bg-surface px-2 py-1.5 font-mono text-xs text-text-muted">auto</p>
				</div>
				<div>
					<label class="mb-1 block text-xs text-text-muted" for="add-set-name">Set name</label>
					<input id="add-set-name" name="name" type="text" required class="w-full rounded border border-border-interactive px-2 py-1.5 text-sm" />
				</div>
			</div>
			<div class="mt-3 flex justify-end gap-2">
				<TextMorphButton type="reset" action="cancel" />
				<TextMorphButton type="submit" action="save" variant="primary">Save set</TextMorphButton>
			</div>
		</form>
	</ExpandBox>
</div>

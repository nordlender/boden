---
// Read-only rendering of src/lib/sets.ts's getSetComponentDisplay output —
// there is nothing here for an admin to edit (see schema.ts's `sets.label`
// comment: a set's contents are always derived from its components' own
// attribute values, never entered separately). Components sharing an
// identical attribute-key signature render as one shared table; anything
// else is a plain line.
import type { SetComponentDisplay } from '../../../lib/sets';
import { tbodyRowClasses, tdClasses, thClasses } from '../../../lib/table-styles';

interface Props {
	display: SetComponentDisplay[];
}

const { display } = Astro.props;
---
{display.length === 0 ? (
	<p class="text-sm italic text-text-muted">No components yet.</p>
) : (
	<div class="flex flex-col gap-3">
		{display.map((group) =>
			group.kind === 'table' ? (
				<table class="w-full text-sm">
					<thead>
						<tr class="text-left text-xs uppercase tracking-wide text-text-muted">
							<th class={thClasses.dense}>Item</th>
							{group.keys.map((key) => <th class={thClasses.dense}>{key}</th>)}
							<th class="py-2 text-right font-medium">Qty</th>
						</tr>
					</thead>
					<tbody>
						{group.rows.map((row) => (
							<tr class:list={[tbodyRowClasses, 'border-t']}>
								<td class:list={[tdClasses.dense, 'text-text']}>{row.productTitle}</td>
								{row.values.map((value) => <td class:list={[tdClasses.dense, 'text-text-muted']}>{value ?? '—'}</td>)}
								<td class="py-2 text-right tabular-nums text-text">{row.quantity}</td>
							</tr>
						))}
					</tbody>
				</table>
			) : (
				<p class="text-sm text-text">
					{group.productTitle}
					{group.attributes.length > 0 && (
						<span class="text-text-muted"> ({group.attributes.map((a) => `${a.key}: ${a.value}`).join(', ')})</span>
					)}
					<span class="text-text-muted"> × {group.quantity}</span>
				</p>
			),
		)}
	</div>
)}

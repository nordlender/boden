---
// Column labels, sharing SetRow's exact grid — see ../TableHeader.astro
// (items) for the identical pattern.
import SelectMenu from '../SelectMenu.astro';
import { gridTableHeaderClasses } from '../../../lib/table-styles';
import { SET_GRID_TEMPLATE, type SetPanelVariant } from './grid';

interface Props {
	variant: SetPanelVariant;
	formId: string;
}

const { variant, formId } = Astro.props;
---
<div
	class:list={['grid', gridTableHeaderClasses]}
	style={`grid-template-columns: ${SET_GRID_TEMPLATE[variant]}`}
>
	<SelectMenu formId={formId} />
	<span></span>
	<span>Set</span>
	<span>Label</span>
	{variant === 'assigned' && <span>Product</span>}
	<span class="text-right" title="Real availability: sets that could be assembled from what is on the shelf now / most ever">On shelf</span>
	<span></span>
</div>

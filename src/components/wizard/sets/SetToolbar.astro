---
// Sets' equivalent of ../ButtonStrip.astro. Labeled "Assign" rather than
// "Set" — ButtonStrip's dropdown trigger is already named "Set" (the verb,
// "Set image"/"Set product") on /admin/items, and reusing that label here
// right next to actual *sets* (the noun) would be confusing. Worth applying
// the same rename to ButtonStrip itself at some point, but that's an
// /admin/items change, out of scope for this PR.
import { eyebrowClasses } from '../../../lib/layout-styles';
import { hintClasses, inputSmClasses } from '../../../lib/form-styles';
import { tableToolbarClasses } from '../../../lib/table-styles';
import AppIcon from '../../icons/AppIcon.astro';
import Button from '../../ui/Button.astro';
import Dropdown from '../../ui/Dropdown.astro';
import TextMorphButton from '../../ui/TextMorphButton.astro';
import AssignWarning from '../AssignWarning.astro';
import type { SetPanelVariant } from './grid';

interface Props {
	variant: SetPanelVariant;
	formId: string;
	products: { id: number; title: string }[];
	redirectTo: string;
}

const { variant, formId, products, redirectTo } = Astro.props;
---
<div class={tableToolbarClasses}>
	<div class="relative inline-block">
	<AssignWarning variant={variant} reason="product_has_items">
		Product can only be assigned items or sets.
	</AssignWarning>
	<Dropdown triggerLabel="Assign" panel="floating" panelClass="mt-2 w-[min(24rem,calc(100vw-2rem))]">
		<input type="hidden" name="redirectTo" value={redirectTo} form={formId} />
		<input type="hidden" name="panel" value={variant} form={formId} />
		<section class="border-b border-border pb-5">
			<p class:list={[eyebrowClasses, 'mb-snug flex items-center gap-1.5']}>
				<AppIcon name="image" size={14} /> Set image
			</p>
			<div class="flex items-center gap-2">
				<input type="text" name="imageUrl" form={formId} placeholder="https://…" class:list={['min-w-0 flex-1', inputSmClasses]} />
				<Button type="submit" size="sm" form={formId} formaction="/api/wizard/sets/set-image" class="shrink-0">
					Apply
				</Button>
			</div>
		</section>

		<section class="pt-5">
			<p class:list={[eyebrowClasses, 'mb-snug flex items-center gap-1.5']}>
				<AppIcon name="product" size={14} /> Set product
			</p>
			<div class="flex items-center gap-2">
				<select name="productId" form={formId} class:list={['min-w-0 flex-1', inputSmClasses]}>
					<option value="" disabled selected>Choose a product…</option>
					{products.map((p) => (
						<option value={p.id}>{p.title}</option>
					))}
				</select>
				<Button type="submit" size="sm" form={formId} formaction="/api/wizard/sets/set-product" class="shrink-0">
					Apply
				</Button>
			</div>
			<p class:list={['mt-2', hintClasses]}>Also how you reassign an already-assigned set to a <em>different</em> product. Unlike items, there's no attribute template to fan out — the set's own <code>label</code> and components are untouched.</p>
		</section>
	</Dropdown>
	</div>

	<div class="flex-1"></div>

	{variant === 'unassigned' && (
		<TextMorphButton variant="primary" action="add" href="#add-set-name" data-expand-open="add-set-panel">
			Add set
		</TextMorphButton>
	)}
	<TextMorphButton variant="danger-filled" action="delete" type="submit" form={formId} formaction="/api/wizard/sets/archive">
		Delete <span class="selected-count" data-form-id={formId}>0</span> set(s)
	</TextMorphButton>
</div>

<script>
	// Selection count — identical logic to ../ButtonStrip.astro's, scoped to
	// this panel's own formId so the two wizards' counts never cross-talk.
	document.addEventListener('change', (event) => {
		const input = event.target;
		if (!(input instanceof HTMLInputElement) || !input.classList.contains('select-checkbox-input')) return;
		const formId = input.getAttribute('form');
		if (!formId) return;
		const count = document.querySelectorAll(`input.select-checkbox-input[form="${formId}"]:checked`).length;
		document.querySelectorAll(`.selected-count[data-form-id="${formId}"]`).forEach((el) => {
			el.textContent = String(count);
		});
	});
</script>

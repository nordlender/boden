---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<ThemeInit />
	</head>
	<body class="min-h-screen bg-bg-subtle">
		<slot />
	</body>
</html>

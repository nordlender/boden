---
import HtmlShell from './HtmlShell.astro';
import AdminNavbar from '../components/AdminNavbar.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<HtmlShell title={title} bodyClass="min-h-screen bg-bg-subtle">
	<AdminNavbar slot="navbar" />
	<!-- Delete/archive controls throughout: azure accent, not org red (see .accent-alt in global.css). -->
	<div class="accent-alt">
		<slot />
	</div>
</HtmlShell>

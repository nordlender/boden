---
import HtmlShell from './HtmlShell.astro';
import Navbar from '../components/Navbar.astro';
import CartSidebar from '../components/cart/CartSidebar.astro';

interface Props {
	title?: string;
}

const { title = 'Boden' } = Astro.props;
---

<HtmlShell title={title}>
	<Navbar slot="navbar" />
	<main>
		<slot />
	</main>
	<CartSidebar slot="after" />
</HtmlShell>

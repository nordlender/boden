---
// Moderator-section equivalent of BaseLayout.astro — same HtmlShell, but
// ModeratorNavbar in place of the member-facing Navbar, and no CartSidebar
// (irrelevant here).
import HtmlShell from './HtmlShell.astro';
import ModeratorNavbar from '../components/ModeratorNavbar.astro';

interface Props {
	title?: string;
}

const { title = 'Boden — Moderator' } = Astro.props;
---

<HtmlShell title={title}>
	<ModeratorNavbar slot="navbar" />
	<main>
		<slot />
	</main>
</HtmlShell>

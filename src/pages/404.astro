---
// Served for unknown routes and whenever a page returns an empty 404
// Response (e.g. /products/<slug> for an unknown or unpublished product).
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Page from '../components/ui/Page.astro';
---

<BaseLayout title="Page not found">
	<Page width="narrow" title="Page not found" description="This page doesn't exist, or the product is no longer available." class="sm:py-24">
		<div>
			<Button href="/" variant="primary" size="lg">Browse gear</Button>
		</div>
	</Page>
</BaseLayout>

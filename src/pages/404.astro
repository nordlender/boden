---
// Served for unknown routes and whenever a page returns an empty 404
// Response (e.g. /products/<slug> for an unknown or unpublished product).
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page not found">
	<div class="mx-auto flex max-w-xl flex-col items-start gap-4 px-4 py-16">
		<h1 class="text-2xl font-semibold tracking-tight text-text">Page not found</h1>
		<p class="text-sm text-text-muted">This page doesn't exist, or the product is no longer available.</p>
		<Button href="/" variant="primary">Browse gear</Button>
	</div>
</BaseLayout>

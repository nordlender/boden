---
// Admin hub — landing page for the /admin/* section, mirroring
// /moderator/index.astro's role as a landing page. Gated by
// src/middleware/prefixes.ts (ROUTE_RULES via /admin). The message
// board here is the same shared MessageTable moderators also post to and
// see (see issue #151, #225) — this page adds `isAdmin` (pin/delete any
// message) plus its own "Message" trigger + modal for posting.
import AdminLayout from '../../layouts/AdminLayout.astro';
import Page from '../../components/ui/Page.astro';
import Callout from '../../components/ui/Callout.astro';
import { actionRowClasses, sectionTitleClasses } from '../../lib/layout-styles';
import { formClasses, textareaClasses } from '../../lib/form-styles';
import MessageTable from '../../components/messages/MessageTable.astro';
import Modal from '../../components/ui/Modal.astro';
import Button from '../../components/ui/Button.astro';
import TextMorphButton from '../../components/ui/TextMorphButton.astro';
import ActionButton from '../../components/admin/ActionButton.astro';
import { listMessages } from '../../lib/messages';

const redirectTo = Astro.url.pathname;
const error = Astro.url.searchParams.get('error');
const messages = await listMessages();
const modalId = 'add-message-modal';
---

<AdminLayout title="Admin">
		<Page title="Admin">
			{
				error === 'empty_message' && (
					<Callout variant="error">
						<p>Message can't be blank.</p>
					</Callout>
				)
			}
			<MessageTable messages={messages} currentUserId={Astro.locals.user?.id ?? null} isAdmin redirectTo={redirectTo}>
				<TextMorphButton
					slot="actions"
					action="message"
					variant="primary"
					data-modal-open
					data-modal-target={modalId}
				/>
			</MessageTable>

			<div class="flex flex-col gap-stack sm:flex-row">
				<ActionButton
					href="/admin/items"
					iconKey="items"
					label="Items"
					description="Manage item stock and assign them to products."
				/>
				<ActionButton
					href="/admin/products"
					iconKey="products"
					label="Products"
					description="Manage the shop's product listings."
				/>
				<ActionButton
					href="/admin/orders"
					iconKey="orders"
					label="Orders"
					description="Review and manage member rental orders."
				/>
			</div>
		</Page>

		{/* TODO(#206): replace this Modal with an inline expanding box — other page
			elements below it should smoothly slide down/out of the way as it opens,
			rather than the current dialog overlay. See issue #206. */}
		<Modal id={modalId} labelledBy={`${modalId}-title`}>
			<h2 id={`${modalId}-title`} class={sectionTitleClasses}>
				New message
			</h2>
			<form method="post" action="/api/messages/add" class={formClasses}>
				<input type="hidden" name="redirectTo" value={redirectTo} />
				<textarea
					name="content"
					rows="4"
					required
					placeholder="Shift notes, stock issues, closures…"
					class:list={['min-w-0', textareaClasses]}
				></textarea>
				<div class={actionRowClasses}>
					<Button type="button" data-modal-close>Cancel</Button>
					<Button type="submit" variant="primary">Post</Button>
				</div>
			</form>
		</Modal>
</AdminLayout>

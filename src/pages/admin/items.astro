---
export const prerender = false;

// Gated by src/middleware/prefixes.ts (ROUTE_RULES via /admin) —
// reached only when logged in with role === 'admin'.
import AdminLayout from '../../layouts/AdminLayout.astro';
import WizardHeader from '../../components/wizard/WizardHeader.astro';
import ItemPanel from '../../components/wizard/ItemPanel.astro';
import AddItemPanel from '../../components/wizard/AddItemPanel.astro';
import { getWizardItems, listProductOptions } from '../../lib/wizard';
import { getDailyAvailability } from '../../lib/availability';
import { CALENDAR_DAYS } from '../../lib/availabilityCalendar';
import { todayIsoInOslo } from '../../lib/dates';

const redirectTo = Astro.url.pathname;
const [{ unassigned, assigned }, products] = await Promise.all([getWizardItems(), listProductOptions()]);
const today = todayIsoInOslo();
const dailyByItem = getDailyAvailability([...unassigned, ...assigned].map((item) => item.id), today, CALENDAR_DAYS, { today });

const toItemView = (item: Awaited<ReturnType<typeof getWizardItems>>['unassigned'][number]) => ({
	itemId: item.id,
	name: item.name,
	image: item.imageUrl,
	subCategory: item.subCategory,
	product: item.productTitle,
	inStock: item.inStock,
	totalStock: item.totalStock,
	description: item.description,
	attributes: item.attributes,
	missingAttributeTemplate: item.missingAttributeTemplate,
	availability: { start: today, daily: dailyByItem.get(item.id) ?? [] },
});
---
<AdminLayout title="Items">
	<div class="mx-auto flex max-w-4xl flex-col gap-6 p-8">
		<WizardHeader title="Items" />

		<AddItemPanel redirectTo={redirectTo} />

		<ItemPanel
			variant="unassigned"
			title="Unassigned items"
			items={unassigned.map(toItemView)}
			products={products}
			redirectTo={redirectTo}
		/>
		<ItemPanel
			variant="assigned"
			title="Assigned items"
			items={assigned.map(toItemView)}
			products={products}
			redirectTo={redirectTo}
		/>
	</div>
</AdminLayout>

---
export const prerender = false;

// Gated by src/middleware/prefixes.ts (ROUTE_RULES via /admin).
// The physical units behind one item (src/db/schema.ts's `units`), as a
// table modelled on /admin/items: add a batch; per unit, its latest notes
// (messages, posted via /api/messages/add), a status popover and a details
// panel for its fields (both via /api/wizard/units) — see UnitRow.astro.
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import BackLink from '../../../../components/moderator/BackLink.astro';
import Callout from '../../../../components/ui/Callout.astro';
import ExpandBox from '../../../../components/ui/ExpandBox.astro';
import TextMorphButton from '../../../../components/ui/TextMorphButton.astro';
import AppIcon from '../../../../components/icons/AppIcon.astro';
import UnitTableHeader from '../../../../components/units/UnitTableHeader.astro';
import UnitRow from '../../../../components/units/UnitRow.astro';
import OptsFields from '../../../../components/units/OptsFields.astro';
import { UNIT_FORM_FIELDS, inputClass, labelClass } from '../../../../components/units/unitTable';
import type { UnitStatus } from '../../../../db/schema';
import { compareUnitsByStatus, getUnitsPageItem, listUnitsForItem } from '../../../../lib/units';
import { listUnitNotes } from '../../../../lib/messages';
import { getOverbookedOrders } from '../../../../lib/availability';
import { todayIsoInOslo } from '../../../../lib/dates';
import { hasRole } from '../../../../lib/auth';

// How far ahead to look for orders a lowered stock can no longer cover.
const OVERBOOK_HORIZON_DAYS = 180;

const itemId = Number(Astro.params.id);
if (!Number.isInteger(itemId) || itemId <= 0) return Astro.redirect('/admin/items');
const item = await getUnitsPageItem(itemId);
if (!item) return Astro.redirect('/admin/items');

const today = todayIsoInOslo();
const unitRows = (await listUnitsForItem(itemId)).sort(compareUnitsByStatus);
const notesByUnit = await listUnitNotes(unitRows.map((unit) => unit.id));
const overbooked = getOverbookedOrders(itemId, OVERBOOK_HORIZON_DAYS, { today });
const count = (status: UnitStatus) => unitRows.filter((unit) => unit.status === status).length;
const redirectTo = Astro.url.pathname;
// Message rules for unit notes, same as the hub board (MessageTableRow.astro).
const currentUserId = Astro.locals.user?.id ?? null;
const isAdmin = hasRole(Astro.locals.user?.role, 'admin');
---

<AdminLayout title={`Units · ${item.name}`}>
	<div class="mx-auto flex max-w-5xl flex-col gap-6 p-4 sm:p-8">
		<BackLink href="/admin/items">Back to items</BackLink>

		<div>
			<h1 class="text-xl font-semibold text-text">{item.name}</h1>
			<p class="mt-1 text-sm text-text-muted">
				{item.product?.title ?? 'Unassigned'} · #{item.id}{item.archived && ' · archived'}
			</p>
			<p class="mt-2 text-sm text-text">
				<strong>{count('active')}</strong> active (stock)
				<span class="text-text-muted"> · {count('out_of_service')} out of service · {count('retired')} retired</span>
			</p>
		</div>

		{overbooked.length > 0 && (
			<Callout variant="warning" title="Stock no longer covers existing bookings">
				<p>
					With {count('active')} active unit{count('active') === 1 ? '' : 's'}, these orders overlap days where this item is overbooked. Contact the members or put a unit back in service.
				</p>
				<ul class="mt-2 list-disc pl-5">
					{overbooked.map((order) => (
						<li>
							<a class="underline" href={`/moderator/retrieve/${order.orderId}`}>{order.orderCode}</a> — {order.fromDate} → {order.toDate} ({order.status})
						</li>
					))}
				</ul>
			</Callout>
		)}

		<div class="rounded-lg border border-border bg-warning-subtle/60">
			<ExpandBox id="add-units-panel" triggerClass="px-3 py-3">
				<span slot="trigger" class="flex items-center gap-2">
					<AppIcon name="product" size={16} class="text-text-muted" />
					Add units
				</span>
				<form method="post" action="/api/wizard/units" class="flex flex-col gap-3 px-3 pb-3">
					<input type="hidden" name="action" value="create" />
					<input type="hidden" name="itemId" value={item.id} />
					<input type="hidden" name="redirectTo" value={redirectTo} />
					<div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
						<div>
							<label class={labelClass} for="add-units-count">How many</label>
							<input id="add-units-count" class={inputClass} type="number" name="count" min="1" max="100" value="1" required />
						</div>
						{UNIT_FORM_FIELDS.map((field) => (
							<div>
								<label class={labelClass} for={`add-units-${field.name}`}>{field.label}</label>
								<input
									id={`add-units-${field.name}`}
									class={inputClass}
									type={field.type}
									name={field.name}
									placeholder={field.placeholder}
									max={field.type === 'date' ? today : undefined}
								/>
							</div>
						))}
					</div>
					<OptsFields />
					<p class="text-xs text-text-muted">Every unit in the batch gets these values; adjust markings and serials per unit afterwards.</p>
					<div class="flex justify-end gap-2">
						<TextMorphButton type="reset" action="cancel" />
						<TextMorphButton type="submit" action="save" variant="primary">Add units</TextMorphButton>
					</div>
				</form>
			</ExpandBox>
		</div>

		<section class="rounded-lg border border-border bg-surface">
			<h2 class="border-b border-border px-3 py-2 text-sm font-semibold text-text">Units</h2>
			<UnitTableHeader />
			{unitRows.length === 0 ? (
				<p class="px-3 py-8 text-center text-sm text-text-muted">No units yet, so this item has no stock.</p>
			) : (
				<div class="overflow-hidden rounded-b-lg">
					{unitRows.map((unit) => <UnitRow unit={unit} notes={notesByUnit.get(unit.id) ?? []} currentUserId={currentUserId} isAdmin={isAdmin} today={today} redirectTo={redirectTo} />)}
				</div>
			)}
		</section>
	</div>
</AdminLayout>

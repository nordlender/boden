---
export const prerender = false;

// Gated by src/middleware/index.ts (ADMIN_ROUTE_PREFIXES via /admin) —
// reached only when logged in with role === 'admin'.
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminNavbar from '../../components/AdminNavbar.astro';
import PickupDaysCalendar from '../../components/pickup-days/PickupDaysCalendar.astro';
import SelectedPickupDaysForm from '../../components/pickup-days/SelectedPickupDaysForm.astro';
import PickupDaysTable from '../../components/pickup-days/PickupDaysTable.astro';
import RecurringPickupDaysTable from '../../components/pickup-days/RecurringPickupDaysTable.astro';
import RecurringPickupDayForm from '../../components/pickup-days/RecurringPickupDayForm.astro';
import { listUpcomingPickupDays, listRecurringRules } from '../../lib/pickupDays';
import { todayIsoInOslo } from '../../lib/dates';

const currentUserId = Astro.locals.user!.id;
const todayIso = todayIsoInOslo();

const [pickupDays, recurringRules] = await Promise.all([listUpcomingPickupDays(todayIso), listRecurringRules()]);

// "Single pickup days" is every moderator/admin ad-hoc submission, with no
// userId filter — unlike /moderator/pickup-days's "Other pickup days"
// (which is this exact same underlying data, just filtered away from the
// viewer), an admin sees the full pool in one table since there's no "My
// pickup days" table here to split it against.
const singleDays = pickupDays.filter((day) => day.kind === 'single');
---

<AdminLayout title="Pickup days">
	<AdminNavbar />
	<div class="mx-auto flex max-w-3xl flex-col gap-8 p-8">
		<div>
			<h1 class="text-xl font-semibold text-text">Pickup days</h1>
			<p class="mt-1 text-sm text-text-muted">
				Set up recurring training days below, or select individual days on the calendar the same way a moderator
				would.
			</p>
		</div>

		<PickupDaysCalendar rows={pickupDays} currentUserId={currentUserId} />

		<SelectedPickupDaysForm />

		<section class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-text">All pickup days</h2>
			<PickupDaysTable rows={pickupDays} currentUserId={currentUserId} emptyMessage="No upcoming pickup days yet." />
		</section>

		<section class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-text">Recurring pickup days</h2>
			<RecurringPickupDayForm />
			<RecurringPickupDaysTable rules={recurringRules} deletable emptyMessage="No recurring training days set up yet." />
		</section>

		<section class="flex flex-col gap-2">
			<h2 class="text-sm font-semibold text-text">Single pickup days</h2>
			<PickupDaysTable rows={singleDays} currentUserId={currentUserId} emptyMessage="No moderator has offered a pickup day yet." />
		</section>
	</div>
</AdminLayout>

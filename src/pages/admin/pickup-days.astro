---
export const prerender = false;

// Gated by src/middleware/index.ts (ADMIN_ROUTE_PREFIXES via /admin) —
// reached only when logged in with role === 'admin'.
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminNavbar from '../../components/AdminNavbar.astro';
import Button from '../../components/ui/Button.astro';
import TextMorphButton from '../../components/ui/TextMorphButton.astro';
import { listAvailablePickupDates } from '../../lib/pickupDays';
import { todayIsoInOslo, formatDateDisplay } from '../../lib/dates';

const redirectTo = Astro.url.pathname;
const dates = await listAvailablePickupDates();
// Europe/Oslo's today, not the server host's — see src/lib/dates.ts. Same
// bug class as the reservation calendar/form (#50): this page's `min` and
// past-date strikethrough were comparing against a UTC-derived "today".
const todayIso = todayIsoInOslo();
const error = Astro.url.searchParams.get('error');
---
<AdminLayout title="Pick-up days">
	<AdminNavbar />
	<div class="mx-auto flex max-w-2xl flex-col gap-6 p-8">
		<div>
			<h1 class="text-xl font-semibold text-text">Pick-up days</h1>
			<p class="mt-1 text-sm text-text-muted">
				Dates listed here show as "Pick up available" (green) on the member-facing reservation calendar — add a date
				once a moderator is confirmed to hand out orders that day.
			</p>
		</div>

		{
			error === 'invalid_date' && (
				<p class="rounded-lg border border-error-border bg-error-subtle p-3 text-sm text-error-text">
					That doesn't look like a valid date (expected YYYY-MM-DD).
				</p>
			)
		}

		<form
			method="post"
			action="/api/pickup-days/add"
			class="flex items-end gap-3 rounded-lg border border-border bg-warning-subtle px-3 py-3"
		>
			<input type="hidden" name="redirectTo" value={redirectTo} />
			<div>
				<label class="mb-1 block text-xs text-text-muted" for="pickup-day-date">Date</label>
				<input
					id="pickup-day-date"
					name="date"
					type="date"
					min={todayIso}
					required
					class="rounded border border-border-interactive px-2 py-1.5 text-sm"
				/>
			</div>
			<Button type="submit" variant="primary">Mark available</Button>
		</form>

		<div class="rounded-lg border border-border bg-surface">
			{
				dates.length === 0 ? (
					<p class="p-4 text-sm text-text-muted">No pick-up days marked available yet.</p>
				) : (
					<ul class="divide-y divide-border">
						{dates.map((date) => (
							<li class="flex items-center justify-between gap-4 px-4 py-2.5 text-sm">
								<span class={date < todayIso ? 'text-disabled-text line-through' : 'text-text'}>{formatDateDisplay(date, { weekday: true })}</span>
								<form method="post" action="/api/pickup-days/remove">
									<input type="hidden" name="redirectTo" value={redirectTo} />
									<input type="hidden" name="date" value={date} />
									<button type="submit" class="text-xs text-error-text hover:underline">
										Remove
									</button>
								</form>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</div>
</AdminLayout>

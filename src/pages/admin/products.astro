---
// Gated by src/middleware/prefixes.ts (ROUTE_RULES via /admin) —
// reached only when logged in with role === 'admin'. Links out to
// /admin/products/new and each row into /admin/products/[id]/edit.
import AdminLayout from '../../layouts/AdminLayout.astro';
import Page from '../../components/ui/Page.astro';
import Badge from '../../components/ui/Badge.astro';
import { cardClasses, emptyStateFramedClasses } from '../../lib/layout-styles';
import TextMorphButton from '../../components/ui/TextMorphButton.astro';
import { listProductsForAdmin } from '../../lib/products';

const products = await listProductsForAdmin();
---

<AdminLayout title="Products">
	<Page title="Products" description="All product listings, alphabetical by title.">
		<TextMorphButton slot="actions" href="/admin/products/new" action="add" variant="primary">New product</TextMorphButton>

		{
			products.length === 0 ? (
				<p class={emptyStateFramedClasses}>No products yet.</p>
			) : (
				<div class:list={[cardClasses, 'flex flex-col divide-y divide-border overflow-hidden']}>
					{products.map((product) => (
						<a href={`/admin/products/${product.id}/edit`} class="flex items-center justify-between gap-stack px-card py-4 hover:bg-bg-subtle">
							<div class="flex flex-col gap-1">
								<span class="text-sm font-medium text-text">{product.title}</span>
								<span class="text-xs text-text-muted">
									{product.categoryName}
									{product.subcategoryName ? ` → ${product.subcategoryName}` : ''}
								</span>
							</div>
							<Badge tone={product.status === 'published' ? 'success' : 'neutral'} class="capitalize">
								{product.status}
							</Badge>
						</a>
					))}
				</div>
			)
		}
	</Page>
</AdminLayout>

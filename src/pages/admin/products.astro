---
export const prerender = false;

// Gated by src/middleware/index.ts (ADMIN_ROUTE_PREFIXES via /admin) —
// reached only when logged in with role === 'admin'. Was read-only (see
// git history) since no create/edit UI existed yet; now links out to
// /admin/products/new and each row into /admin/products/[id]/edit.
import '../../styles/global.css';
import ThemeInit from '../../components/ThemeInit.astro';
import AdminNavbar from '../../components/AdminNavbar.astro';
import Button from '../../components/ui/Button.astro';
import { listProductsForAdmin } from '../../lib/products';

const products = await listProductsForAdmin();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Products</title>
		<ThemeInit />
	</head>
	<body class="min-h-screen bg-bg-subtle">
		<AdminNavbar />
		<div class="mx-auto flex max-w-4xl flex-col gap-6 p-8">
			<div class="flex items-center justify-between gap-4">
				<div>
					<h1 class="text-xl font-semibold text-text">Products</h1>
					<p class="mt-1 text-sm text-text-muted">All product listings, alphabetical by title.</p>
				</div>
				<Button href="/admin/products/new" variant="primary">New product</Button>
			</div>

			{
				products.length === 0 ? (
					<p class="text-sm text-text-muted">No products yet.</p>
				) : (
					<div class="flex flex-col divide-y divide-border rounded-lg border border-border bg-surface">
						{products.map((product) => (
							<a href={`/admin/products/${product.id}/edit`} class="flex items-center justify-between gap-4 px-4 py-3 hover:bg-bg-subtle">
								<div class="flex flex-col">
									<span class="text-sm font-medium text-text">{product.title}</span>
									<span class="text-xs text-text-muted">
										{product.categoryName}
										{product.subcategoryName ? ` → ${product.subcategoryName}` : ''}
									</span>
								</div>
								<span
									class:list={[
										'rounded-full border px-3 py-1 text-xs font-medium capitalize',
										product.status === 'published'
											? 'border-success-border bg-success-subtle text-success-text'
											: 'border-border text-text-muted',
									]}
								>
									{product.status}
								</span>
							</a>
						))}
					</div>
				)
			}
		</div>
	</body>
</html>

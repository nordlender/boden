---
export const prerender = false;

// Gated by src/middleware/index.ts (ADMIN_ROUTE_PREFIXES via /admin).
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import ProductForm from '../../../../components/wizard/ProductForm.astro';
import { listCategoryOptions, listSubcategoryOptions, getProductForEdit } from '../../../../lib/products';

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) {
	return Astro.redirect('/admin/products');
}

const product = await getProductForEdit(id);
if (!product) {
	return Astro.redirect('/admin/products');
}

const [categories, subcategories] = await Promise.all([listCategoryOptions(), listSubcategoryOptions()]);
---

<AdminLayout title={`Edit ${product.title}`}>
	<div class="mx-auto flex max-w-2xl flex-col gap-6 p-8">
		<div>
			<h1 class="text-xl font-semibold text-text">Edit product</h1>
			<p class="mt-1 text-sm text-text-muted">/{product.slug}</p>
		</div>

		<ProductForm mode="edit" product={product} categories={categories} subcategories={subcategories} redirectTo="/admin/products" />
	</div>
</AdminLayout>

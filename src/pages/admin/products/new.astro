---
export const prerender = false;

// Gated by src/middleware/prefixes.ts (ROUTE_RULES via /admin).
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Page from '../../../components/ui/Page.astro';
import ProductForm from '../../../components/wizard/ProductForm.astro';
import { listCategoryOptions, listSubcategoryOptions } from '../../../lib/products';

const [categories, subcategories] = await Promise.all([listCategoryOptions(), listSubcategoryOptions()]);
---

<AdminLayout title="New product">
	<Page width="medium" title="New product" description="Items get assigned to this product afterward, from /admin/items.">

		<ProductForm mode="create" categories={categories} subcategories={subcategories} redirectTo="/admin/products" />
	</Page>
</AdminLayout>

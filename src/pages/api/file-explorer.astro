---
// Lazy-load endpoint backing <FileExplorer>'s expand-on-demand folders.
// Returns just the <li> fragment for one directory's immediate children —
// no full HTML document — so the client (FileExplorerNode.astro's toggle
// listener, ImageMenu.astro's post-upload refresh) can drop it straight
// into the placeholder <ul> already rendered for that row. Reusing
// FileExplorerNode here (rather than hand-building HTML in a .ts endpoint)
// keeps one source of truth for the row markup.
//
// `root` must be one of the fixed FILE_ROOTS keys (see fileExplorer.ts) —
// never a path. `path` is client input (which folder they expanded),
// validated by listChildren(): rejected if it resolves outside the root.
// Deliberately NOT gated behind /admin: every root is a directory whose
// files are already publicly served (public/, and uploads at /media/), so
// listing their names isn't a meaningful disclosure.
import FileExplorerNode from '../../components/FileExplorerNode.astro';
import { getFileRoot, isFileRootKey, listChildren } from '../../lib/fileExplorer';

const rootKey = Astro.url.searchParams.get('root') ?? 'public';
const subPath = Astro.url.searchParams.get('path') ?? '';

if (!isFileRootKey(rootKey)) {
	return new Response('Not found', { status: 404 });
}

const { dir, filter } = getFileRoot(rootKey);
let children;
try {
	children = listChildren(dir, subPath, filter);
} catch {
	return new Response('Not found', { status: 404 });
}
---
{children.length > 0 ? children.map((child) => <FileExplorerNode node={child} root={rootKey} />) : <li class="py-1 text-text-muted">Empty</li>}

---
export const prerender = false;
import '../../styles/global.css';
import LoginCard from '../../components/auth/LoginCard.astro';

// Preserves the redirect target the auth+role gate middleware set when it
// bounced an unauthenticated request here (src/middleware/index.ts).
const next = Astro.url.searchParams.get('next') ?? '/';
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Sign in</title>
	</head>
	<body class="bg-bg text-text">
		<main class="flex min-h-screen items-center justify-center px-4">
			<LoginCard next={next} />
		</main>
	</body>
</html>

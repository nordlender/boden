---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import CartActionsBar from '../components/cart/CartActionsBar.astro';
import SetChildrenList from '../components/cart/SetChildrenList.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import ItemLine from '../components/ui/ItemLine.astro';
import { findOvercommittedItems, getCartLines, overcommittedForLine } from '../lib/cart';

// Gated by src/middleware/index.ts (MEMBER_ROUTES) — reached only when logged in.
const cartLines = await getCartLines(Astro.cookies);
// Totalled across lines (a loose item plus a set containing it), the same
// way checkout counts them — a per-line check misses that.
const overcommitted = findOvercommittedItems(cartLines);
---

<BaseLayout title="Cart">
	<div class="mx-auto max-w-3xl px-4 py-8">
		<h1 class="mb-6 text-2xl font-semibold tracking-tight text-text">Cart</h1>

		{
			cartLines.length === 0 ? (
				<p class="mb-8 text-sm text-text-muted">Your cart is empty.</p>
			) : (
				<div class="mb-8 divide-y divide-border border-y border-border">
					{cartLines.map((line) => {
						const isSet = 'setId' in line;
						// The update/remove forms below post whichever of itemId/setId
						// this line is (see api/cart/{update,remove}.ts).
						const lineIdField = isSet ? 'setId' : 'itemId';
						const lineId = isSet ? line.setId : line.itemId;
						const lineOvercommitted = overcommittedForLine(line, overcommitted);
						return (
							<div class="py-4">
								<ItemLine
									imageUrl={line.imageUrl}
									name={line.productTitle}
									href={line.productSlug ? `/products/${line.productSlug}` : null}
									attributes={isSet ? [] : line.attributes}
									subtitle={isSet ? line.label : null}
									thumbnailSize={64}
									gap="lg"
									class="flex-wrap"
								>
									{isSet && <Badge class="mt-0.5 inline-block">Set</Badge>}
									{/* An item line's own row already says which item it is
									    (product title + attributes); a set line names the
									    component, as its children list below does. */}
									{lineOvercommitted.length > 0 ? (
										lineOvercommitted.map((item) => (
											<p class="text-sm text-error-text">
												{isSet
													? `Your cart has ${item.needed} × ${item.productTitle} in total — we only have ${item.stockCount}`
													: `Your cart has ${item.needed} of this item in total — we only have ${item.stockCount}`}
											</p>
										))
									) : (
										line.quantity > line.inStock && (
											<p class="text-sm text-text-muted">Booked today — you'll pick dates when it's free</p>
										)
									)}
									<Fragment slot="action">
										<form method="post" action="/api/cart/update" class="flex items-center gap-2">
											<input type="hidden" name={lineIdField} value={lineId} />
											<label class="sr-only" for={`quantity-${lineIdField}-${lineId}`}>
												Quantity for {line.productTitle}
											</label>
											<input
												id={`quantity-${lineIdField}-${lineId}`}
												type="number"
												name="quantity"
												value={line.quantity}
												min="0"
												class="w-16 rounded-md border border-border-interactive px-2 py-1 text-sm"
											/>
											<Button type="submit" size="sm">Update</Button>
										</form>

										<form method="post" action="/api/cart/remove">
											<input type="hidden" name={lineIdField} value={lineId} />
											<button type="submit" class="text-sm text-error hover:underline">
												Remove
											</button>
										</form>
									</Fragment>
								</ItemLine>
								{isSet && <SetChildrenList components={line.children} quantity={line.quantity} class="ml-20" />}
							</div>
						);
					})}
				</div>
			)
		}

		{
			cartLines.length > 0 && (
				<CartActionsBar primaryHref="/reservation" primaryLabel="Continue to reservation dates" clearAction="/api/cart/clear" />
			)
		}
	</div>
</BaseLayout>

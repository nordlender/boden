---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import CartActionsBar from '../components/cart/CartActionsBar.astro';
import ItemLine from '../components/ui/ItemLine.astro';
import { getCartItems } from '../lib/cart';

// Gated by src/middleware/index.ts (MEMBER_ROUTES) — reached only when logged in.
const cartItems = await getCartItems(Astro.cookies);
---

<BaseLayout title="Cart">
	<form id="cart-form" method="post" action="/api/cart/update-all"></form>
	<div class="mx-auto max-w-3xl px-4 py-8">
		<h1 class="mb-6 text-2xl font-semibold tracking-tight text-text">Cart</h1>

		{
			cartItems.length === 0 ? (
				<p class="mb-8 text-sm text-text-muted">Your cart is empty.</p>
			) : (
				<div class="mb-8 divide-y divide-border border-y border-border">
					{cartItems.map((item) => (
						<div class="py-4">
							<ItemLine
								imageUrl={item.imageUrl}
								name={item.productTitle}
								href={item.productSlug ? `/products/${item.productSlug}` : null}
								attributes={item.attributes}
								thumbnailSize={64}
								gap="lg"
								class="flex-wrap"
							>
								{item.quantity > item.inStock && (
									<p class="text-sm text-error">Only {Math.max(item.inStock, 0)} left in stock</p>
								)}
								<Fragment slot="action">
									<label class="sr-only" for={`quantity-${item.itemId}`}>
										Quantity for {item.productTitle} (0 removes it)
									</label>
									<input
										id={`quantity-${item.itemId}`}
										type="number"
										name={`quantity_${item.itemId}`}
										form="cart-form"
										value={item.quantity}
										min="0"
										data-cart-quantity
										class="h-6 w-14 shrink-0 rounded-md border border-border-interactive px-2 py-0 text-xs"
									/>
								</Fragment>
							</ItemLine>
						</div>
					))}
				</div>
			)
		}

		{
			cartItems.length > 0 && (
				<CartActionsBar
					updateFormId="cart-form"
					primaryHref="/reservation"
					primaryLabel="Continue to reservation dates"
					clearAction="/api/cart/clear"
				/>
			)
		}
	</div>
</BaseLayout>

<script>
	// Shows "Update cart" in place of the primary action as soon as any
	// quantity differs from what the server rendered; a successful update
	// redirects back to /cart, so the page reloads with "Review order" again.
	const inputs = document.querySelectorAll<HTMLInputElement>('[data-cart-quantity]');
	const update = document.querySelector<HTMLElement>('[data-cart-update]');
	const primary = document.querySelector<HTMLElement>('[data-cart-primary]');

	function sync() {
		const dirty = [...inputs].some((input) => input.value !== input.defaultValue);
		if (update) update.hidden = !dirty;
		if (primary) primary.hidden = dirty;
	}
	inputs.forEach((input) => input.addEventListener('input', sync));
	sync();
</script>

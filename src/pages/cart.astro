---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCartItems, getCartSets, type CartItem } from '../lib/cart';
import { getSetSummaries } from '../lib/sets';

// Gated by src/middleware/index.ts (MEMBER_ROUTES) — reached only when logged in.
const cartItems = await getCartItems(Astro.cookies);
const cartSets = getCartSets(Astro.cookies);

// Items sharing a non-null setId (see CartItem.setId's doc comment — tagged
// only when a row's *entire* quantity came from exactly one kit) render as
// one grouped block: a single "how many kits" stepper (bound to the kit's
// own stored quantity, not the derived per-item quantity) plus a read-only
// list of what's inside, rather than N separate item rows each with their
// own update/remove controls. Standalone items (setId: null — including any
// mixed-provenance row) keep rendering exactly as before.
const setIdsInCart = [...new Set(cartItems.map((item) => item.setId).filter((id): id is number => id !== null))];
const setSummaries = await getSetSummaries(setIdsInCart);
const kitQuantityBySetId = new Map(cartSets.map((entry) => [entry.setId, entry.quantity]));

interface CartRow {
	kind: 'item';
	item: CartItem;
}
interface SetGroupRow {
	kind: 'set';
	setId: number;
	slug: string | null;
	title: string;
	kitQuantity: number;
	items: CartItem[];
}

const rows: (CartRow | SetGroupRow)[] = [];
const renderedSetIds = new Set<number>();
for (const item of cartItems) {
	if (item.setId === null) {
		rows.push({ kind: 'item', item });
		continue;
	}
	if (renderedSetIds.has(item.setId)) continue;
	renderedSetIds.add(item.setId);
	rows.push({
		kind: 'set',
		setId: item.setId,
		slug: setSummaries.get(item.setId)?.slug ?? null,
		title: setSummaries.get(item.setId)?.title ?? 'Set',
		kitQuantity: kitQuantityBySetId.get(item.setId) ?? 1,
		items: cartItems.filter((i) => i.setId === item.setId),
	});
}
---

<BaseLayout title="Cart">
	<div class="mx-auto max-w-3xl px-4 py-8">
		<h1 class="mb-6 text-2xl font-semibold tracking-tight text-text">Cart</h1>

		{
			cartItems.length === 0 ? (
				<p class="mb-8 text-sm text-text-muted">Your cart is empty.</p>
			) : (
				<div class="mb-8 divide-y divide-border border-y border-border">
					{rows.map((row) =>
						row.kind === 'item' ? (
							<div class="flex flex-wrap items-center gap-4 py-4">
								<div class="h-16 w-16 shrink-0 overflow-hidden rounded bg-bg-subtle">
									{row.item.imageUrl && <img src={row.item.imageUrl} alt={row.item.productTitle} class="h-full w-full object-cover" />}
								</div>

								<div class="min-w-0 flex-1">
									<a
										href={row.item.productSlug ? `/products/${row.item.productSlug}` : '#'}
										class="font-medium text-text hover:underline"
									>
										{row.item.productTitle}
									</a>
									{row.item.attributes.length > 0 && (
										<p class="text-sm text-text-muted">{row.item.attributes.map((a) => a.value).join(' / ')}</p>
									)}
									{row.item.quantity > row.item.inStock && (
										// TODO: Style later, warning? — low-stock notice, not necessarily an error.
										<p class="text-sm text-error">Only {Math.max(row.item.inStock, 0)} left in stock</p>
									)}
								</div>

								<form method="post" action="/api/cart/update" class="flex items-center gap-2">
									<input type="hidden" name="itemId" value={row.item.itemId} />
									<label class="sr-only" for={`quantity-${row.item.itemId}`}>
										Quantity for {row.item.productTitle}
									</label>
									<input
										id={`quantity-${row.item.itemId}`}
										type="number"
										name="quantity"
										value={row.item.quantity}
										min="0"
										class="w-16 rounded-md border border-border-interactive px-2 py-1 text-sm"
									/>
									<button type="submit" class="rounded-md border border-border-strong px-2 py-1 text-sm text-text-muted hover:bg-bg-subtle">
										Update
									</button>
								</form>

								<form method="post" action="/api/cart/remove">
									<input type="hidden" name="itemId" value={row.item.itemId} />
									<button type="submit" class="text-sm text-error hover:underline">
										Remove
									</button>
								</form>
							</div>
						) : (
							<div class="flex flex-col gap-3 bg-bg-subtle py-4">
								<div class="flex flex-wrap items-center gap-4 px-4">
									<div class="min-w-0 flex-1">
										{row.slug ? (
											<a href={`/sets/${row.slug}`} class="font-medium text-text hover:underline">
												{row.title}
											</a>
										) : (
											<span class="font-medium text-text">{row.title}</span>
										)}
										<p class="text-xs uppercase tracking-wide text-text-muted">Kit</p>
									</div>

									<form method="post" action="/api/cart/update-set" class="flex items-center gap-2">
										<input type="hidden" name="setId" value={row.setId} />
										<label class="sr-only" for={`set-quantity-${row.setId}`}>
											Number of {row.title} kits
										</label>
										<input
											id={`set-quantity-${row.setId}`}
											type="number"
											name="quantity"
											value={row.kitQuantity}
											min="0"
											class="w-16 rounded-md border border-border-interactive px-2 py-1 text-sm"
										/>
										<button type="submit" class="rounded-md border border-border-strong px-2 py-1 text-sm text-text-muted hover:bg-bg-subtle">
											Update
										</button>
									</form>

									<form method="post" action="/api/cart/remove-set">
										<input type="hidden" name="setId" value={row.setId} />
										<button type="submit" class="text-sm text-error hover:underline">
											Remove kit
										</button>
									</form>
								</div>

								<ul class="flex flex-col gap-2 px-4 pl-8">
									{row.items.map((item) => (
										<li class="flex items-center gap-3 text-sm text-text-muted">
											<div class="h-10 w-10 shrink-0 overflow-hidden rounded bg-surface">
												{item.imageUrl && <img src={item.imageUrl} alt={item.productTitle} class="h-full w-full object-cover" />}
											</div>
											<span>
												{item.productTitle} × {item.quantity}
											</span>
											{item.quantity > item.inStock && (
												<span class="text-error">(only {Math.max(item.inStock, 0)} left in stock)</span>
											)}
										</li>
									))}
								</ul>
							</div>
						),
					)}
				</div>
			)
		}

		{
			cartItems.length > 0 && (
				<a
					href="/reservation"
					class="block rounded-md bg-accent px-4 py-2 text-center text-sm font-medium text-text-inverted hover:bg-accent-hover"
				>
					Continue to reservation dates
				</a>
			)
		}
	</div>
</BaseLayout>

---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import CartActionsBar from '../components/cart/CartActionsBar.astro';
import ItemLine from '../components/ui/ItemLine.astro';
import { getCartItems } from '../lib/cart';

// Gated by src/middleware/index.ts (MEMBER_ROUTES) — reached only when logged in.
const cartItems = await getCartItems(Astro.cookies);
---

<BaseLayout title="Cart">
	<div class="mx-auto max-w-3xl px-4 py-8">
		<h1 class="mb-6 text-2xl font-semibold tracking-tight text-text">Cart</h1>

		{
			cartItems.length === 0 ? (
				<p class="mb-8 text-sm text-text-muted">Your cart is empty.</p>
			) : (
				<div class="mb-8 divide-y divide-border border-y border-border">
					{cartItems.map((item) => (
						<div class="py-4">
							<ItemLine
								imageUrl={item.imageUrl}
								name={item.productTitle}
								href={item.productSlug ? `/products/${item.productSlug}` : null}
								attributes={item.attributes}
								quantity={item.quantity}
								thumbnailSize={64}
								gap="lg"
								class="flex-wrap"
							>
								{item.quantity > item.inStock && (
									<p class="text-sm text-error">Only {Math.max(item.inStock, 0)} left in stock</p>
								)}
								<Fragment slot="action">
									<form method="post" action="/api/cart/remove" class="self-center">
										<input type="hidden" name="itemId" value={item.itemId} />
										<button type="submit" class="text-sm text-error hover:underline">
											Remove
										</button>
									</form>
								</Fragment>
							</ItemLine>
						</div>
					))}
				</div>
			)
		}

		{
			cartItems.length > 0 && (
				<CartActionsBar
					primaryHref="/reservation"
					primaryLabel="Continue to reservation dates"
					clearAction="/api/cart/clear"
				/>
			)
		}
	</div>
</BaseLayout>

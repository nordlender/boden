---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import CartActionsBar from '../components/cart/CartActionsBar.astro';
import IconButton from '../components/ui/IconButton.astro';
import { getCartItems } from '../lib/cart';

// Gated by src/middleware/index.ts (MEMBER_ROUTES) — reached only when logged in.
const cartItems = await getCartItems(Astro.cookies);
---

<BaseLayout title="Cart">
	<div class="mx-auto max-w-3xl px-4 py-8">
		<h1 class="mb-6 text-2xl font-semibold tracking-tight text-text">Cart</h1>

		{
			cartItems.length === 0 ? (
				<p class="mb-8 text-sm text-text-muted">Your cart is empty.</p>
			) : (
				<div class="mb-8 divide-y divide-border border-y border-border">
					{cartItems.map((item) => (
						<div class="flex flex-wrap items-center gap-4 py-4">
							<div class="h-16 w-16 shrink-0 overflow-hidden rounded bg-bg-subtle">
								{item.imageUrl && <img src={item.imageUrl} alt={item.productTitle} class="h-full w-full object-cover" />}
							</div>

							<div class="min-w-0 flex-1">
								<a
									href={item.productSlug ? `/products/${item.productSlug}` : '#'}
									class="font-medium text-text hover:underline"
								>
									{item.productTitle}
								</a>
								{item.attributes.length > 0 && (
									<p class="text-sm text-text-muted">{item.attributes.map((a) => a.value).join(' / ')}</p>
								)}
								{item.quantity > item.inStock && (
									<p class="text-sm text-error">Only {Math.max(item.inStock, 0)} left in stock</p>
								)}
							</div>

							<form method="post" action="/api/cart/update" data-cart-update-form class="flex items-center gap-2">
								<input type="hidden" name="itemId" value={item.itemId} />
								<label class="sr-only" for={`quantity-${item.itemId}`}>
									Quantity for {item.productTitle}
								</label>
								<input
									id={`quantity-${item.itemId}`}
									type="number"
									name="quantity"
									value={item.quantity}
									min="0"
									class="w-16 rounded-md border border-border-interactive px-2 py-1 text-sm"
								/>
								<IconButton
										type="submit"
										icon="confirm"
										label="Update quantity"
										size="sm"
										disabled
										class="enabled:border-accent enabled:text-accent-text enabled:hover:bg-accent-subtle enabled:hover:text-accent-text"
									/>
							</form>

							<form method="post" action="/api/cart/remove">
								<input type="hidden" name="itemId" value={item.itemId} />
								<button type="submit" class="text-sm text-error hover:underline">
									Remove
								</button>
							</form>
						</div>
					))}
				</div>
			)
		}

		{
			cartItems.length > 0 && (
				<CartActionsBar
					primaryHref="/reservation"
					primaryLabel="Continue to reservation dates"
					clearAction="/api/cart/clear"
				/>
			)
		}
	</div>
</BaseLayout>

<script>
	// The update button stays disabled (greyed out) until the quantity differs
	// from what the server rendered, then turns accent-colored and clickable.
	document.querySelectorAll<HTMLFormElement>('[data-cart-update-form]').forEach((form) => {
		const input = form.querySelector<HTMLInputElement>('input[name="quantity"]');
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		if (!input || !button) return;
		input.addEventListener('input', () => {
			button.disabled = input.value === '' || input.value === input.defaultValue;
		});
	});
</script>

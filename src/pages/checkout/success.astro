---
export const prerender = false;

import '../../styles/global.css';
import UserOrderSummary from '../../components/orders/UserOrderSummary.astro';
import { db } from '../../db/client';

// Gated by src/middleware/index.ts (MEMBER_ROUTE_PREFIXES via /checkout) —
// reached only when logged in, so Astro.locals.user is non-null here.
//
// `order` can be a comma-separated list — the reservation page's
// split-order action (src/lib/orders.ts's createSplitOrders) creates two
// orders from one checkout submission, both landing here together.
const orderCodes = (Astro.url.searchParams.get('order') ?? '').split(',').filter(Boolean);
const foundOrders = orderCodes.length
  ? await db.query.orders.findMany({
      where: (t, { inArray }) => inArray(t.orderCode, orderCodes),
      with: { orderItems: { with: { item: true } } },
    })
  : [];

// Don't leak another member's order by guessing/enumerating codes.
if (foundOrders.length !== orderCodes.length || foundOrders.some((o) => o.userId !== Astro.locals.user?.id)) {
  return Astro.redirect('/cart');
}
// Preserve the order codes appeared in the URL (query result order isn't guaranteed).
const ordersByCode = new Map(foundOrders.map((o) => [o.orderCode, o]));
const orderedOrders = orderCodes.map((code) => ordersByCode.get(code)!);
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Order placed</title>
	</head>
	<body>
		<main>
			{orderedOrders.length > 1 && <p>Your items were split across {orderedOrders.length} separate orders:</p>}
			{orderedOrders.map((order) => (
				<UserOrderSummary
					orderCode={order.orderCode}
					status={order.status}
					note={order.note}
					items={order.orderItems.map((oi) => ({
						itemName: oi.item.name,
						requestedQuantity: oi.requestedQuantity,
					}))}
				/>
			))}
		</main>
	</body>
</html>

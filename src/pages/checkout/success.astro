---
import ConfirmationLayout from '../../layouts/ConfirmationLayout.astro';
import UserOrderSummary from '../../components/orders/UserOrderSummary.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import { db } from '../../db/client';

// Gated by src/middleware/prefixes.ts (ROUTE_RULES via /checkout) —
// reached only when logged in, so Astro.locals.user is non-null here.
//
// `order` is the order code. The lookup is scoped to the signed-in user, so
// guessing another member's code just redirects away rather than leaking it.
const orderCode = Astro.url.searchParams.get('order') ?? '';
const order = orderCode
  ? await db.query.orders.findFirst({
      where: (t, { and, eq }) => and(eq(t.orderCode, orderCode), eq(t.userId, Astro.locals.user!.id)),
      with: { orderItems: { with: { item: true } } },
    })
  : undefined;

if (!order) {
  return Astro.redirect('/orders');
}
---

<ConfirmationLayout title="Order placed" heading="Order placed">
	<Fragment slot="subtitle">
		<p>
			Please take a screenshot of this page for your records — it's the easiest way to have your order code on
			hand when you come to pick up.
		</p>
	</Fragment>

	<Card as="div">
		<UserOrderSummary
			orderCode={order.orderCode}
			status={order.status}
			fromDate={order.fromDate}
			toDate={order.toDate}
			note={order.note}
			items={order.orderItems.map((oi) => ({
				itemName: oi.item.name,
				requestedQuantity: oi.requestedQuantity,
				itemImageUrl: oi.item.imageUrl,
			}))}
			showImages
		/>
		<Button variant="primary" size="lg" href={`/orders/${order.orderCode}`} class="self-start">
			View or manage this order
		</Button>
	</Card>

	<a href="/" class="self-center text-sm font-medium text-accent-text hover:underline">
		Continue shopping
	</a>
</ConfirmationLayout>

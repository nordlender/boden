---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemGrid from '../components/shop/ItemGrid.astro';
import { getShopGridProducts } from '../lib/shop';

// Prerendered (static output, see astro.config.mjs) — this query runs once
// at build time, same as worktree-navbar-homepage's index.astro did against
// the old schema. One row per product (issue #17) — see getShopGridProducts.
const products = await getShopGridProducts();
---

<BaseLayout title="Boden">
	<div class="mx-auto max-w-6xl px-4 py-8">
		<ItemGrid products={products} />
	</div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuantitySelector from '../../components/shop/QuantitySelector.astro';
import { db } from '../../db/client';
import { items } from '../../db/schema';
import { eq } from 'drizzle-orm';

export async function getStaticPaths() {
	const allItems = await db.query.items.findMany({
		where: (items, { eq }) => eq(items.archived, false),
	});

	return allItems.map((item) => ({ params: { slug: item.slug } }));
}

const { slug } = Astro.params;

const item = await db.query.items.findFirst({
	where: eq(items.slug, slug!),
	with: {
		category: true,
		attributes: { orderBy: (attributes, { asc }) => asc(attributes.sortOrder) },
	},
});

if (!item) {
	return Astro.redirect('/404');
}

const inStock = item.stockCount > 0;
---

<BaseLayout title={item.name}>
	<div class="mx-auto grid max-w-4xl gap-8 px-4 py-12 sm:grid-cols-2">
		<div class="aspect-square overflow-hidden rounded-lg bg-gray-100">
			<img src={item.imageUrl} alt={item.name} class="h-full w-full object-cover" />
		</div>

		<div class="flex flex-col gap-4">
			<div>
				{item.category && <p class="text-xs uppercase tracking-wide text-gray-500">{item.category.name}</p>}
				<h1 class="text-2xl font-semibold tracking-tight text-gray-900">{item.name}</h1>
			</div>

			{item.description && <p class="text-sm text-gray-600">{item.description}</p>}

			<span class={`text-sm font-medium ${inStock ? 'text-emerald-700' : 'text-red-700'}`}>
				{inStock ? `${item.stockCount} in stock` : 'Out of stock'}
			</span>

			{
				item.attributes.length > 0 && (
					<dl class="grid grid-cols-2 gap-x-4 gap-y-2 border-t border-gray-200 pt-4 text-sm">
						{item.attributes.map((attribute) => (
							<div class="contents">
								<dt class="text-gray-500">{attribute.key}</dt>
								<dd class="text-gray-900">{attribute.value}</dd>
							</div>
						))}
					</dl>
				)
			}

			<form action="/api/cart/add" method="post" class="flex items-center gap-3 border-t border-gray-200 pt-4">
				<input type="hidden" name="itemId" value={item.id} />
				<input type="hidden" name="redirect" value={`/items/${item.slug}`} />
				<QuantitySelector max={item.stockCount || 1} />
				<button
					type="submit"
					disabled={!inStock}
					class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 disabled:cursor-not-allowed disabled:bg-gray-300"
				>
					Add to cart
				</button>
			</form>
		</div>
	</div>
</BaseLayout>

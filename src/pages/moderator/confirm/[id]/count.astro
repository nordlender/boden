---
export const prerender = false;

// Blind count — step 2 of 2 in the confirm flow. One numeric input per
// line, left empty on first load (never pre-filled with the target — the
// whole point is the moderator reports an unbiased count). Gated by
// src/middleware/index.ts (MOD_ROUTE_PREFIXES via /moderator).
import ModeratorLayout from '../../../../layouts/ModeratorLayout.astro';
import { getOrderDetail } from '../../../../lib/moderatorOrders';

const idParam = Number(Astro.params.id);
const order = Number.isInteger(idParam) ? await getOrderDetail(idParam) : null;

if (!order) {
	return Astro.redirect('/moderator/retrieve');
}
if (order.acceptedAt === null || order.status !== 'requested') {
	return Astro.redirect(`/moderator/orders/${order.id}`);
}

const mismatch = Astro.url.searchParams.get('mismatch') === '1';

const lines = order.items.map((item) => {
	const targetRaw = Astro.url.searchParams.get(`target_${item.orderItemId}`);
	const target = targetRaw !== null && Number.isFinite(Number(targetRaw)) ? Number(targetRaw) : item.requestedQuantity;
	const enteredRaw = Astro.url.searchParams.get(`entered_${item.orderItemId}`);
	const entered = mismatch && enteredRaw !== null ? Number(enteredRaw) : null;
	const isMismatched = mismatch && entered !== null && entered !== target;
	return {
		...item,
		target,
		enteredValue: entered,
		// The count page computes and displays this diff itself from its own
		// target_*/entered_* query params — the API route just redirects back
		// with the raw numbers, it doesn't encode a message.
		correction: !isMismatched ? null : entered! < target ? `Retrieve ${target - entered!} more` : `Put back ${entered! - target}`,
	};
});
---

<ModeratorLayout title={`Confirm order #${order.orderCode} — Moderator`}>
	<div class="mx-auto flex max-w-xl flex-col gap-4 p-6">
		<a href={`/moderator/confirm/${order.id}`} class="self-start text-sm font-medium text-text-muted hover:text-text">
			&larr; Back to checklist
		</a>

		<div class="flex flex-col gap-6 rounded-lg border border-border bg-surface p-6">
			<div>
				<h1 class="text-xl font-semibold text-text">Confirm order #{order.orderCode}</h1>
				<p class="mt-1 text-sm text-text-muted">
					Enter the actual quantity of each item you retrieved — not what the order expects.
				</p>
			</div>

			{
				mismatch && (
					<p class="rounded-md border border-warning-border bg-warning-subtle px-3 py-2 text-sm text-warning-text">
						Some counts don't match yet — see the notes below and adjust.
					</p>
				)
			}

			<form method="post" action={`/api/moderator/orders/${order.id}/confirm`} class="flex flex-col gap-4">
				<ul class="flex flex-col divide-y divide-border">
					{
						lines.map((line) => (
							<li class="flex items-center gap-3 py-2">
								<input type="hidden" name={`target_${line.orderItemId}`} value={line.target} />
								<div class="flex flex-1 flex-col gap-0.5">
									<span class="text-sm text-text">{line.itemName}</span>
									{line.correction && <span class="text-xs font-medium text-warning-text">{line.correction}</span>}
								</div>
								<input
									type="number"
									name={`qty_${line.orderItemId}`}
									min="0"
									value={line.enteredValue ?? undefined}
									required
									class="w-20 rounded border border-border-strong px-2 py-1 text-sm text-text"
								/>
							</li>
						))
					}
				</ul>

				<button
					type="submit"
					class="self-start rounded-md bg-accent px-4 py-2 text-sm font-medium text-text-inverted hover:bg-accent-hover"
				>
					Complete
				</button>
			</form>
		</div>
	</div>
</ModeratorLayout>

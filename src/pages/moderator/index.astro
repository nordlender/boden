---
// Moderator hub — landing page for the /moderator/* section. Gated by
// src/middleware/prefixes.ts (ROUTE_RULES via /moderator). The message
// board is the same shared MessageTable the admin hub renders (see issue
// #151) — moderators can now post their own messages here too, and delete
// only the ones they authored (see issue #225); admin-authored messages,
// and pinning, stay admin-only, enforced again server-side in
// src/pages/api/messages/{add,delete,pin,unpin}.ts. The requests list
// reuses the same query/shape as requests.astro via getPendingRequestRows
// so the two never drift apart.
import ModeratorLayout from '../../layouts/ModeratorLayout.astro';
import Page from '../../components/ui/Page.astro';
import Callout from '../../components/ui/Callout.astro';
import { actionRowClasses, emptyStateFramedClasses, sectionTitleClasses } from '../../lib/layout-styles';
import { formClasses, textareaClasses } from '../../lib/form-styles';
import MessageTable from '../../components/messages/MessageTable.astro';
import ActionButton from '../../components/moderator/ActionButton.astro';
import OrdersTableRow from '../../components/orders/OrdersTableRow.astro';
import Modal from '../../components/ui/Modal.astro';
import Button from '../../components/ui/Button.astro';
import TextMorphButton from '../../components/ui/TextMorphButton.astro';
import { getPendingRequestRows } from '../../lib/moderatorOrders';
import { listMessages } from '../../lib/messages';

// This is a preview, not the full queue (see the "See all" link to
// /moderator/requests below) — capped and compact-only (no item contents),
// so it doesn't grow the hub page unbounded. Rendered directly via
// OrdersTableRow rather than the OrdersTable wrapper, since that wrapper
// also builds a hidden detailed-layout copy (with item contents) for its
// layout toggle, which we don't want here at all, not even off-screen.
const MAX_PREVIEW_REQUESTS = 8;
const pendingRequests = await getPendingRequestRows();
const previewRequests = pendingRequests.slice(0, MAX_PREVIEW_REQUESTS);
const messages = await listMessages();

// The requests preview sits between the message board and the action tiles,
// so the board's scroll cap (MessageTable `scrollable`) has to leave room for
// it: gap to the block, its header row (2rem), gap under it, then the list.
// Row heights are the compact OrdersTableRow card (4.5rem in one line from
// `sm`, 8.5rem in the stacked mobile layout) plus 0.75rem between rows; the
// empty state is one framed message (~7.5rem). With a full preview the board
// just sits at its 10rem floor and the page scrolls.
const requestsBlockReserve = (rowRem: number, emptyRem: number) => {
	const n = previewRequests.length;
	const listRem = n === 0 ? emptyRem : n * rowRem + (n - 1) * 0.75;
	return `calc(var(--ui-space-region) + var(--ui-space-stack) + ${2 + listRem}rem)`;
};
const extraReserve = { base: requestsBlockReserve(8.5, 7.5), sm: requestsBlockReserve(4.5, 7.5) };
const redirectTo = Astro.url.pathname;
const error = Astro.url.searchParams.get('error');
const modalId = 'add-message-modal';
---

<ModeratorLayout title="Moderator — Boden">
	<Page width="wide" title="Moderator">
		{
			error === 'empty_message' && (
				<Callout variant="error">
					<p>Message can't be blank.</p>
				</Callout>
			)
		}
		<MessageTable messages={messages} currentUserId={Astro.locals.user?.id ?? null} redirectTo={redirectTo} scrollable extraReserve={extraReserve}>
			<TextMorphButton
				slot="actions"
				action="message"
				variant="primary"
				data-modal-open
				data-modal-target={modalId}
			/>
		</MessageTable>

		<div class="flex flex-col gap-stack">
			<div class="flex items-center justify-between gap-stack">
				<h2 class={sectionTitleClasses}>Upcoming requests</h2>
				<TextMorphButton action="next" href="/moderator/requests" variant="secondary" size="sm">See all</TextMorphButton>
			</div>

			{
				previewRequests.length === 0 ? (
					<p class={emptyStateFramedClasses}>No orders are waiting for review.</p>
				) : (
					<div class="flex flex-col gap-3">
						{previewRequests.map((order) => (
							<OrdersTableRow
								orderCode={order.orderCode}
								status={order.status}
								fromDate={order.fromDate}
								toDate={order.toDate}
								customerName={order.customerName}
								viewHref={`/moderator/review/${order.orderCode}`}
							/>
						))}
					</div>
				)
			}
		</div>

		<div class="flex flex-col gap-stack sm:flex-row">
			<ActionButton
				href="/moderator/retrieve"
				iconKey="retrieve"
				label="Retrieve"
				description="Look up an order and hand out gear."
			/>
			<ActionButton
				href="/moderator/retrieve"
				iconKey="return"
				label="Return"
				description="Look up an order and take gear back."
			/>
			<ActionButton
				href="/moderator/pickup-days"
				iconKey="pickupDays"
				label="Pickup days"
				description="Register your availability for pickup."
			/>
		</div>
	</Page>

	<Modal id={modalId} labelledBy={`${modalId}-title`}>
		<h2 id={`${modalId}-title`} class={sectionTitleClasses}>
			New message
		</h2>
		<form method="post" action="/api/messages/add" class={formClasses}>
			<input type="hidden" name="redirectTo" value={redirectTo} />
			<textarea
				name="content"
				rows="4"
				required
				placeholder="Shift notes, stock issues, closures…"
				class:list={['min-w-0', textareaClasses]}
			></textarea>
			<div class={actionRowClasses}>
				<Button type="button" data-modal-close>Cancel</Button>
				<Button type="submit" variant="primary">Post</Button>
			</div>
		</form>
	</Modal>
</ModeratorLayout>

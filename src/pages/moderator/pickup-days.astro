---
// Gated by src/middleware/prefixes.ts (ROUTE_RULES via /moderator) —
// reached only when logged in as at least a moderator (admins included).
import ModeratorLayout from '../../layouts/ModeratorLayout.astro';
import Page from '../../components/ui/Page.astro';
import { sectionTitleClasses } from '../../lib/layout-styles';
import PickupDaysCalendar from '../../components/pickup-days/PickupDaysCalendar.astro';
import SelectedPickupDaysForm from '../../components/pickup-days/SelectedPickupDaysForm.astro';
import PickupDaysTable from '../../components/pickup-days/PickupDaysTable.astro';
import RecurringPickupDaysTable from '../../components/pickup-days/RecurringPickupDaysTable.astro';
import { listUpcomingPickupDays, listRecurringRules } from '../../lib/pickupDays';
import { todayIsoInOslo } from '../../lib/dates';

const currentUserId = Astro.locals.user!.id;
const todayIso = todayIsoInOslo();

const [pickupDays, recurringRules] = await Promise.all([listUpcomingPickupDays(todayIso), listRecurringRules()]);

const myDays = pickupDays.filter((day) => day.kind === 'single' && day.userId === currentUserId);
const otherDays = pickupDays.filter((day) => day.kind === 'single' && day.userId !== currentUserId);
---

<ModeratorLayout title="Pickup days — Moderator">
	<Page
		width="medium"
		title="Pickup days"
		description="Select one or more days you're available to hand out orders. Other moderators (in yellow) and recurring training days (in red) stay visible so you can avoid duplicate coverage."
	>

		<PickupDaysCalendar rows={pickupDays} currentUserId={currentUserId} />

		<SelectedPickupDaysForm />

		<section class="flex flex-col gap-stack">
			<h2 class={sectionTitleClasses}>My pickup days</h2>
			<PickupDaysTable rows={myDays} currentUserId={currentUserId} deletable emptyMessage="You haven't offered any pickup days yet." />
		</section>

		<section class="flex flex-col gap-stack">
			<h2 class={sectionTitleClasses}>Other pickup days</h2>
			<PickupDaysTable rows={otherDays} currentUserId={currentUserId} emptyMessage="No other moderator has offered a pickup day yet." />
		</section>

		<section class="flex flex-col gap-stack">
			<h2 class={sectionTitleClasses}>Recurring pickup days</h2>
			<RecurringPickupDaysTable rules={recurringRules} emptyMessage="No recurring training days set up yet." />
		</section>
	</Page>
</ModeratorLayout>

---
// Review-stage entry point: every order still pending moderator review,
// earliest submitted first — see src/pages/admin/orders.astro for the
// OrdersTable pattern this mirrors. Gated by src/middleware/prefixes.ts
// (ROUTE_RULES via /moderator).
import ModeratorLayout from '../../layouts/ModeratorLayout.astro';
import Page from '../../components/ui/Page.astro';
import OrdersTable from '../../components/orders/OrdersTable.astro';
import { getPendingRequestRows } from '../../lib/orders';

const rows = await getPendingRequestRows();
---

<ModeratorLayout title="Order requests — Moderator">
	<Page width="wide" title="Order requests" description="Orders waiting for review, earliest submitted first.">

		<OrdersTable
			orders={rows}
			viewHref={(code: string) => `/moderator/review/${code}`}
			emptyMessage="No orders are waiting for review."
		/>
	</Page>
</ModeratorLayout>

---
import ModeratorLayout from '../../layouts/ModeratorLayout.astro';
import Page from '../../components/ui/Page.astro';
import Callout from '../../components/ui/Callout.astro';
import { cardClasses } from '../../lib/layout-styles';
import { fieldClasses, formClasses, inputClasses, labelClasses } from '../../lib/form-styles';
import Button from '../../components/ui/Button.astro';

// Allows an optional leading "#" (e.g. "#AB12CD") on top of the
// ORDER_CODE_LENGTH-character code itself — stripped server-side in
// src/pages/api/moderator/retrieve.ts before the lookup.
const CODE_INPUT_MAX_LENGTH = 8;

// Universal entry point for the moderator flow — reached by asking the
// member to read out their order code, for either the review step or the
// retrieval step (see src/pages/api/moderator/retrieve.ts, which looks the
// code up and redirects to the hub at /moderator/retrieve/[id]).
const error = Astro.url.searchParams.get('error');
---

<ModeratorLayout title="Retrieve order — Boden Moderator">
	<Page width="narrow" title="Retrieve order" description="Ask the member to read out their order code, then enter it below.">

		{
			error === 'not_found' && (
				<Callout variant="error">
					<p>No order found with that code — check it and try again.</p>
				</Callout>
			)
		}

		<form method="post" action="/api/moderator/retrieve" class:list={[cardClasses, 'p-card', formClasses]}>
			<label class={fieldClasses}>
				<span class={labelClasses}>Order code</span>
				<input
					type="text"
					name="code"
					required
					maxlength={CODE_INPUT_MAX_LENGTH}
					autocomplete="off"
					autocapitalize="characters"
					class:list={[inputClasses, 'uppercase tracking-wide']}
					placeholder="e.g. #AB12CD"
				/>
			</label>
			<Button type="submit" variant="primary" size="lg" class="self-start">
				Look up order
			</Button>
		</form>
	</Page>
</ModeratorLayout>

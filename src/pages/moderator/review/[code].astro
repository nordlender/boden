---
// Accept/reject an order still pending moderator review. Gated by
// src/middleware/prefixes.ts (ROUTE_RULES via /moderator) — reached only
// when logged in with role 'moderator' or 'admin'.
import ModeratorLayout from '../../../layouts/ModeratorLayout.astro';
import Page from '../../../components/ui/Page.astro';
import Callout from '../../../components/ui/Callout.astro';
import { textareaClasses } from '../../../lib/form-styles';
import OrderDetailCard from '../../../components/moderator/OrderDetailCard.astro';
import BackLink from '../../../components/ui/BackLink.astro';
import Button from '../../../components/ui/Button.astro';
import TextMorphButton from '../../../components/ui/TextMorphButton.astro';
import AcceptTimeChoice from '../../../components/moderator/AcceptTimeChoice.astro';
import { getAcceptReadiness, getOrderDetailByCode, type AcceptBlocker } from '../../../lib/moderatorOrders';
import { formatDateDisplay } from '../../../lib/dates';

const codeParam = Astro.params.code;
const order = codeParam ? await getOrderDetailByCode(codeParam) : null;

// A code that doesn't resolve to a real order (bad bookmark, typo, deleted
// row) has nowhere sensible to land but back at the requests queue.
if (!order) {
	return Astro.redirect('/moderator/requests');
}

// Defensive against a stale bookmark/back-button after this order has
// already been accepted or rejected (by this moderator or another one, in
// another tab).
const alreadyReviewed = order.status !== 'requested';
const error = Astro.url.searchParams.get('error');

// Accepting confirms a pick-up and a return window overlapping the member's
// requested time ranges (#343); acceptOrder re-checks all of this.
const readiness = alreadyReviewed ? null : getAcceptReadiness(order);
const blockerText = (blocker: AcceptBlocker) =>
	blocker.error === 'start_date_passed'
		? 'The pick-up date has already passed. Reject the order, or ask the member to change the dates.'
		: `No ${blocker.kind === 'pickup' ? 'pick-up' : 'return'} window on ${formatDateDisplay(blocker.date, { weekday: true })} overlaps the member's time ranges. Add a pick-up window that covers one of them, or reject the order with a reason.`;
const acceptErrors: Record<string, string> = {
	start_date_passed: 'The order could not be accepted: its pick-up date has already passed.',
	invalid_pickup_window: 'The order could not be accepted: the chosen pick-up window is gone or no longer overlaps the member\'s time ranges. Choose again.',
	invalid_return_window: 'The order could not be accepted: the chosen return window is gone or no longer overlaps the member\'s time ranges. Choose again.',
};
---

<ModeratorLayout title={`Review order #${order.orderCode} — Moderator`}>
	<Page width="narrow">
		<BackLink slot="before-title" href="/moderator/requests">Back to requests</BackLink>

		<OrderDetailCard order={order} showAvailability={true}>
			<Fragment slot="actions">
				{
					alreadyReviewed ? (
						// Accepted orders move on to the retrieval stage via order-code
						// lookup (see requests.astro) — there's no per-id retrieval route
						// to link to. Rejected orders have nothing further to review, so
						// no link is shown for them at all.
						order.status === 'scheduled' && (
							<Button href="/moderator/retrieve">
								Retrieve order
							</Button>
						)
					) : (
						<>
							<form method="post" action={`/api/moderator/orders/${order.id}/accept`} class="flex w-full flex-col gap-stack">
								{error && acceptErrors[error] && (
									<Callout variant="error">
										<p>{acceptErrors[error]}</p>
									</Callout>
								)}
								{readiness && (
									<>
										<AcceptTimeChoice option={readiness.pickup} />
										<AcceptTimeChoice option={readiness.return} />
									</>
								)}
								{readiness && readiness.blockers.length > 0 && (
									<Callout variant="warning" title="Can't accept yet" live={false}>
										<ul class="flex flex-col gap-1">
											{readiness.blockers.map((blocker) => <li>{blockerText(blocker)}</li>)}
										</ul>
									</Callout>
								)}
								<TextMorphButton action="accept" type="submit" variant="primary" size="lg" class="self-start" disabled={!readiness || readiness.blockers.length > 0} />
							</form>

							<form method="post" action={`/api/moderator/orders/${order.id}/reject`} class="flex w-full flex-col gap-3">
								{
									error === 'blank_reason' && (
										<Callout variant="error">
											<p>Please provide a reason for rejecting this order.</p>
										</Callout>
									)
								}
								<textarea
									name="reason"
									required
									aria-label="Reason for rejecting this order"
									rows={2}
									placeholder="Reason for rejecting this order"
									class:list={['w-full', textareaClasses]}
								></textarea>
								<TextMorphButton action="reject" type="submit" variant="danger" class="self-start" />
							</form>
						</>
					)
				}
			</Fragment>
		</OrderDetailCard>
	</Page>
</ModeratorLayout>

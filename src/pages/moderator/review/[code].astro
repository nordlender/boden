---
// Accept/reject an order still pending moderator review. Gated by
// src/middleware/prefixes.ts (ROUTE_RULES via /moderator) — reached only
// when logged in with role 'moderator' or 'admin'.
import ModeratorLayout from '../../../layouts/ModeratorLayout.astro';
import Page from '../../../components/ui/Page.astro';
import Callout from '../../../components/ui/Callout.astro';
import { textareaClasses } from '../../../lib/form-styles';
import OrderDetailCard from '../../../components/moderator/OrderDetailCard.astro';
import BackLink from '../../../components/ui/BackLink.astro';
import Button from '../../../components/ui/Button.astro';
import ActionPopover from '../../../components/ui/ActionPopover.astro';
import TextMorphButton from '../../../components/ui/TextMorphButton.astro';
import AcceptTimeChoice from '../../../components/moderator/AcceptTimeChoice.astro';
import { getAcceptReadiness, getOrderDetailByCode, type AcceptBlocker } from '../../../lib/moderatorOrders';
import { formatDateDisplay } from '../../../lib/dates';

const codeParam = Astro.params.code;
const order = codeParam ? await getOrderDetailByCode(codeParam) : null;

// A code that doesn't resolve to a real order (bad bookmark, typo, deleted
// row) has nowhere sensible to land but back at the requests queue.
if (!order) {
	return Astro.redirect('/moderator/requests');
}

// Defensive against a stale bookmark/back-button after this order has
// already been accepted or rejected (by this moderator or another one, in
// another tab).
const alreadyReviewed = order.status !== 'requested';
const error = Astro.url.searchParams.get('error');

// Accepting confirms a pick-up and a return window overlapping the member's
// requested time ranges (#343); acceptOrder re-checks all of this.
const readiness = alreadyReviewed ? null : getAcceptReadiness(order);
const acceptFormId = `accept-order-${order.id}`;
const side = (kind: 'pickup' | 'return') => (kind === 'pickup' ? 'pick-up' : 'return');
const day = (date: string) => formatDateDisplay(date, { weekday: true });
function blockerText(blocker: AcceptBlocker): string {
	switch (blocker.error) {
		case 'start_date_passed':
			return 'The pick-up date has already passed. Reject the order, or ask the member to change the dates.';
		case 'no_time_ranges':
			return `The member gave no ${side(blocker.kind)} time ranges, so there is nothing to match a window against. Ask the member to change the order and add them, or reject it with a reason.`;
		case 'windows_ended':
			return `Every ${side(blocker.kind)} window today that overlaps the member's time ranges has already ended. Add a later window that covers one of them, or reject the order with a reason.`;
		case 'return_before_pickup':
			return `This is a same-day rental, and no return window on ${day(blocker.date)} ends after a pick-up window starts. Add a later window, or reject the order with a reason.`;
		case 'no_overlapping_window':
			return `No ${side(blocker.kind)} window on ${day(blocker.date)} overlaps the member's time ranges. Add a pick-up window that covers one of them, or reject the order with a reason.`;
	}
}
const acceptErrors: Record<string, string> = {
	start_date_passed: 'The order could not be accepted: its pick-up date has already passed.',
	invalid_pickup_window: 'The order could not be accepted: the chosen pick-up window is gone or no longer overlaps the member\'s time ranges. Choose again.',
	invalid_return_window: 'The order could not be accepted: the chosen return window is gone or no longer overlaps the member\'s time ranges. Choose again.',
	pickup_window_ended: 'The order could not be accepted: the chosen pick-up window has already ended. Choose a later one.',
	return_window_ended: 'The order could not be accepted: the chosen return window has already ended. Choose a later one.',
	return_before_pickup: 'The order could not be accepted: on a same-day rental the return window must end after the pick-up window starts. Choose again.',
};
---

<ModeratorLayout title={`Review order #${order.orderCode} — Moderator`}>
	<Page width="narrow">
		<BackLink slot="before-title" href="/moderator/requests">Back to requests</BackLink>

		<OrderDetailCard order={order} showAvailability={true}>
			<Fragment slot="actions">
				{
					alreadyReviewed ? (
						// Accepted orders move on to the retrieval stage via order-code
						// lookup (see requests.astro) — there's no per-id retrieval route
						// to link to. Rejected orders have nothing further to review, so
						// no link is shown for them at all.
						order.status === 'scheduled' && (
							<Button href="/moderator/retrieve">
								Retrieve order
							</Button>
						)
					) : (
						<div class="flex w-full flex-col gap-stack">
							{error && acceptErrors[error] && (
								<Callout variant="error">
									<p>{acceptErrors[error]}</p>
								</Callout>
							)}
							{
								error === 'blank_reason' && (
									<Callout variant="error">
										<p>Please provide a reason for rejecting this order.</p>
									</Callout>
								)
							}
							{/* The window radios sit outside the accept <form> (it only wraps
							    its button in the grid below) and join it via form=. */}
							{readiness && (
								<>
									<AcceptTimeChoice option={readiness.pickup} form={acceptFormId} />
									<AcceptTimeChoice option={readiness.return} form={acceptFormId} />
								</>
							)}
							{readiness && readiness.blockers.length > 0 && (
								<Callout variant="warning" title="Can't accept yet" live={false}>
									<ul class="flex flex-col gap-1">
										{readiness.blockers.map((blocker) => <li>{blockerText(blocker)}</li>)}
									</ul>
								</Callout>
							)}
							{/* data-popover-container: the reason popover spans both buttons */}
							<div data-popover-container class="grid grid-cols-2 gap-controls">
								<form id={acceptFormId} method="post" action={`/api/moderator/orders/${order.id}/accept`} class="contents">
									<TextMorphButton action="accept" type="submit" variant="primary" size="lg" class="w-full" disabled={!readiness || readiness.blockers.length > 0} />
								</form>

								<ActionPopover
									id="reject-order-reason"
									title="Reject this order?"
									confirmLabel="Reject"
									placement="fill-parent"
									formAction={`/api/moderator/orders/${order.id}/reject`}
								>
									<Fragment slot="trigger">
										<TextMorphButton
											action="reject"
											variant="danger"
											size="lg"
											class="w-full"
											popovertarget="reject-order-reason"
										/>
									</Fragment>
									<textarea
										name="reason"
										required
										aria-label="Reason for rejecting this order"
										rows={3}
										placeholder="Reason for rejecting this order"
										class:list={['w-full', textareaClasses]}
									></textarea>
								</ActionPopover>
							</div>
						</div>
					)
				}
			</Fragment>
		</OrderDetailCard>
	</Page>
</ModeratorLayout>

<script>
	// The server rejects a whitespace-only reason by redirecting back with
	// ?error=blank_reason: reopen the reason popover so the field is in view,
	// then drop the one-shot param so a reload doesn't reopen it (same trick as
	// wizard/AssignWarning.astro). Importing openPopover guarantees Popover's
	// positioning listeners exist already (see lib/popover.ts).
	import { openPopover } from '../../../lib/popover';

	const url = new URL(location.href);
	const popover = document.getElementById('reject-order-reason');
	if (popover && url.searchParams.get('error') === 'blank_reason') {
		openPopover(popover);
		popover.querySelector<HTMLTextAreaElement>('textarea')?.focus();
		url.searchParams.delete('error');
		history.replaceState({}, '', url);
	}
</script>

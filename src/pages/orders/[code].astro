---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMemberOrder } from '../../lib/orders';
import { getMaxRentalDays } from '../../lib/rental-policy';
import OrderCodeHeader from '../../components/orders/OrderCodeHeader.astro';
import OrderContents from '../../components/orders/OrderContents.astro';
import SubmittedContactDetails from '../../components/orders/SubmittedContactDetails.astro';
import DeleteOrderButton from '../../components/orders/DeleteOrderButton.astro';
import ChangeOrderLink from '../../components/orders/ChangeOrderLink.astro';

// Gated by src/middleware/prefixes.ts (ROUTE_RULES via /orders) —
// reached only when logged in, so Astro.locals.user is non-null here.
// getMemberOrder scopes the lookup to the signed-in user, so another member's
// code resolves exactly like a nonexistent one — don't leak it by guessing or
// enumerating order codes (never redirect differently for "not yours").
const order = await getMemberOrder(Astro.params.code ?? '', Astro.locals.user?.id ?? '');

if (!order) {
  return Astro.redirect('/');
}
---

<BaseLayout title={`Order #${order.orderCode}`}>
	<div class="mx-auto flex max-w-xl flex-col gap-4 p-6">
		<a href="/" class="self-start text-sm font-medium text-text-muted hover:text-text">&larr; Back to shop</a>

		<div class="flex flex-col gap-6 rounded-lg border border-border bg-surface p-6">
			<OrderCodeHeader orderCode={order.orderCode} status={order.status} fromDate={order.fromDate} toDate={order.toDate} />
			<OrderContents
				items={order.orderItems.map((oi) => ({
					itemName: oi.item.name,
					requestedQuantity: oi.requestedQuantity,
				}))}
				note={order.note}
			/>
			<SubmittedContactDetails contactName={order.contactName} />
			<div class="flex flex-wrap gap-2 border-t border-border pt-4">
				<ChangeOrderLink orderCode={order.orderCode} status={order.status} acceptedAt={order.acceptedAt} fromDate={order.fromDate} toDate={order.toDate} maxRentalDays={getMaxRentalDays()} />
				<DeleteOrderButton orderCode={order.orderCode} status={order.status} />
			</div>
		</div>
	</div>
</BaseLayout>

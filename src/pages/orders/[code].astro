---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { db } from '../../db/client';
import { getMaxRentalDays } from '../../lib/rental-policy';
import { getUpcomingAvailablePickupDates, listUpcomingPickupDays } from '../../lib/pickupDays';
import { getOrderTimeRanges } from '../../lib/orderTimeRanges';
import RequestedTimeRanges from '../../components/orders/RequestedTimeRanges.astro';
import ConfirmedPickupWindows from '../../components/orders/ConfirmedPickupWindows.astro';
import { todayIsoInOslo } from '../../lib/dates';
import OrderCodeHeader from '../../components/orders/OrderCodeHeader.astro';
import OrderContents from '../../components/orders/OrderContents.astro';
import SubmittedContactDetails from '../../components/orders/SubmittedContactDetails.astro';
import DeleteOrderButton from '../../components/orders/DeleteOrderButton.astro';
import ChangeOrderLink from '../../components/orders/ChangeOrderLink.astro';
import Page from '../../components/ui/Page.astro';
import Card from '../../components/ui/Card.astro';
import BackLink from '../../components/ui/BackLink.astro';
import { cardFooterClasses } from '../../lib/layout-styles';

// Gated by src/middleware/prefixes.ts (ROUTE_RULES via /orders) —
// reached only when logged in, so Astro.locals.user is non-null here.
const { code } = Astro.params;
const order = code
  ? await db.query.orders.findFirst({
      where: (t, { eq }) => eq(t.orderCode, code),
      with: { orderItems: { with: { item: true } }, pickupDay: true, returnDay: true },
    })
  : undefined;

// Don't leak another member's order by guessing/enumerating order codes.
if (!order || order.userId !== Astro.locals.user?.id) {
  return Astro.redirect('/');
}

// Only the reschedule modal needs these: return days must be pick-up days
// (#336), and the day's windows are the time-range presets (#368).
const reschedulable = order.status === 'requested' && !order.acceptedAt;
const availablePickupDates = reschedulable ? await getUpcomingAvailablePickupDates(todayIsoInOslo()) : [];
const timeRangeWindows = reschedulable ? await listUpcomingPickupDays(todayIsoInOslo()) : [];
const timeRanges = getOrderTimeRanges(order.id);
---

<BaseLayout title={`Order #${order.orderCode}`}>
	<Page width="narrow">
		<BackLink slot="before-title" href="/">Back to shop</BackLink>

		<Card as="div">
			<OrderCodeHeader orderCode={order.orderCode} status={order.status} fromDate={order.fromDate} toDate={order.toDate} />
			{order.status === 'requested' && <RequestedTimeRanges fromDate={order.fromDate} toDate={order.toDate} ranges={timeRanges} framed={false} />}
			{(order.status === 'scheduled' || order.status === 'active') && <ConfirmedPickupWindows pickup={order.pickupDay} return={order.returnDay} />}
			<OrderContents
				items={order.orderItems.map((oi) => ({
					itemName: oi.item.name,
					requestedQuantity: oi.requestedQuantity,
				}))}
				note={order.note}
			/>
			<SubmittedContactDetails contactName={order.contactName} />
			<div class={cardFooterClasses}>
				<ChangeOrderLink orderCode={order.orderCode} status={order.status} acceptedAt={order.acceptedAt} fromDate={order.fromDate} toDate={order.toDate} maxRentalDays={getMaxRentalDays()} availablePickupDates={availablePickupDates} timeRangeWindows={timeRangeWindows} timeRanges={timeRanges} />
				<DeleteOrderButton orderCode={order.orderCode} status={order.status} />
			</div>
		</Card>
	</Page>
</BaseLayout>

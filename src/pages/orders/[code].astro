---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { db } from '../../db/client';
import { getMaxRentalDays } from '../../lib/rental-policy';
import OrderCodeHeader from '../../components/orders/OrderCodeHeader.astro';
import OrderContents from '../../components/orders/OrderContents.astro';
import SubmittedContactDetails from '../../components/orders/SubmittedContactDetails.astro';
import DeleteOrderButton from '../../components/orders/DeleteOrderButton.astro';
import ChangeOrderLink from '../../components/orders/ChangeOrderLink.astro';
import Page from '../../components/ui/Page.astro';
import Card from '../../components/ui/Card.astro';
import BackLink from '../../components/ui/BackLink.astro';
import Button from '../../components/ui/Button.astro';
import Callout from '../../components/ui/Callout.astro';
import { cardFooterClasses } from '../../lib/layout-styles';
import { formatDateTimeDisplay } from '../../lib/dates';

// Gated by src/middleware/prefixes.ts (ROUTE_RULES via /orders) —
// reached only when logged in, so Astro.locals.user is non-null here.
const { code } = Astro.params;
const found = code
  ? await db.query.orders.findFirst({
      where: (t, { eq }) => eq(t.orderCode, code),
      with: { orderItems: { with: { item: true } } },
    })
  : undefined;

// Another member's order is reported exactly like an unknown code, so order
// codes can't be guessed/enumerated. Rendered in place with a 404 status
// rather than redirecting, so a mistyped code says what went wrong.
const order = found && found.userId === Astro.locals.user?.id ? found : null;
if (!order) {
  Astro.response.status = 404;
}
---

{
	order ? (
		<BaseLayout title={`Order #${order.orderCode}`}>
			<Page width="narrow">
				<BackLink slot="before-title" href="/orders">My orders</BackLink>

				<Card as="div">
					<OrderCodeHeader orderCode={order.orderCode} status={order.status} fromDate={order.fromDate} toDate={order.toDate} />
					{order.status === 'rejected' && (
						<Callout variant="error" title="Order rejected" live={false}>
							<p>{order.rejectedReason || 'A moderator rejected this order.'}</p>
						</Callout>
					)}
					{order.status === 'cancelled' && (
						<Callout variant="info" title="Order cancelled" live={false}>
							<p>
								You cancelled this order{order.cancelledAt && ` on ${formatDateTimeDisplay(order.cancelledAt)}`}. The gear has
								been released for others to book.
							</p>
						</Callout>
					)}
					<OrderContents
						items={order.orderItems.map((oi) => ({
							itemName: oi.item.name,
							requestedQuantity: oi.requestedQuantity,
						}))}
						note={order.note}
					/>
					<SubmittedContactDetails contactName={order.contactName} />
					{
						// Members can change/delete a 'requested' order and cancel a
						// 'scheduled' one; from 'active' on there's nothing they can do.
						(order.status === 'requested' || order.status === 'scheduled') && (
							<div class={cardFooterClasses}>
								<ChangeOrderLink
									orderCode={order.orderCode}
									status={order.status}
									acceptedAt={order.acceptedAt}
									fromDate={order.fromDate}
									toDate={order.toDate}
									maxRentalDays={getMaxRentalDays()}
								/>
								<DeleteOrderButton orderCode={order.orderCode} status={order.status} />
							</div>
						)
					}
				</Card>
			</Page>
		</BaseLayout>
	) : (
		<BaseLayout title="Order not found">
			<Page width="narrow" title="Order not found" description="There's no order with that code on your account." class="sm:py-24">
				<div class="flex flex-wrap gap-2">
					<Button href="/orders" variant="primary" size="lg">My orders</Button>
					<Button href="/" variant="secondary" size="lg">Browse gear</Button>
				</div>
			</Page>
		</BaseLayout>
	)
}

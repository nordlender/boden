---
export const prerender = false;

import '../../styles/global.css';
import { db } from '../../db/client';
import { getMaxRentalDays } from '../../lib/rental-policy';
import OrderCodeHeader from '../../components/orders/OrderCodeHeader.astro';
import OrderContents from '../../components/orders/OrderContents.astro';
import SubmittedContactDetails from '../../components/orders/SubmittedContactDetails.astro';
import DeleteOrderButton from '../../components/orders/DeleteOrderButton.astro';
import ChangeOrderLink from '../../components/orders/ChangeOrderLink.astro';

// Gated by src/middleware/index.ts (MEMBER_ROUTE_PREFIXES via /orders) —
// reached only when logged in, so Astro.locals.user is non-null here.
const { code } = Astro.params;
const order = code
  ? await db.query.orders.findFirst({
      where: (t, { eq }) => eq(t.orderCode, code),
      with: { orderItems: { with: { item: true } } },
    })
  : undefined;

// Don't leak another member's order by guessing/enumerating order codes.
if (!order || order.userId !== Astro.locals.user?.id) {
  return Astro.redirect('/');
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Order #{order.orderCode}</title>
	</head>
	<body>
		<main class="mx-auto flex max-w-xl flex-col gap-6 p-6">
			<OrderCodeHeader orderCode={order.orderCode} status={order.status} fromDate={order.fromDate} toDate={order.toDate} />
			<OrderContents
				items={order.orderItems.map((oi) => ({
					itemName: oi.item.name,
					requestedQuantity: oi.requestedQuantity,
				}))}
				note={order.note}
			/>
			<SubmittedContactDetails contactName={order.contactName} />
			<div class="flex flex-wrap gap-2">
				<ChangeOrderLink orderCode={order.orderCode} status={order.status} fromDate={order.fromDate} toDate={order.toDate} maxRentalDays={getMaxRentalDays()} />
				<DeleteOrderButton orderCode={order.orderCode} status={order.status} />
			</div>
		</main>
	</body>
</html>

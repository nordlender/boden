---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMemberOrder } from '../../lib/orders';
import { toOrderItemView } from '../../lib/orderItemView';
import { getUpcomingPickupWindows } from '../../lib/pickupDays';
import { getMaxRentalDays } from '../../lib/rental-policy';
import { getOrderTimeRanges } from '../../lib/orderTimeRanges';
import RequestedTimeRanges from '../../components/orders/RequestedTimeRanges.astro';
import ConfirmedPickupWindows from '../../components/orders/ConfirmedPickupWindows.astro';
import { timeNowOslo } from '../../lib/dates';
import UserOrderSummary from '../../components/orders/UserOrderSummary.astro';
import SubmittedContactDetails from '../../components/orders/SubmittedContactDetails.astro';
import DeleteOrderButton from '../../components/orders/DeleteOrderButton.astro';
import ChangeOrderLink from '../../components/orders/ChangeOrderLink.astro';
import Page from '../../components/ui/Page.astro';
import Card from '../../components/ui/Card.astro';
import BackLink from '../../components/ui/BackLink.astro';
import { cardFooterClasses } from '../../lib/layout-styles';

// Gated by src/middleware/prefixes.ts (ROUTE_RULES via /orders) —
// reached only when logged in, so Astro.locals.user is non-null here.
// getMemberOrder scopes the lookup to the signed-in user, so another member's
// code resolves exactly like a nonexistent one — don't leak it by guessing or
// enumerating order codes (never redirect differently for "not yours").
const order = await getMemberOrder(Astro.params.code ?? '', Astro.locals.user?.id ?? '');

if (!order) {
  return Astro.redirect('/');
}

// Only the reschedule modal needs the upcoming windows: their dates colour
// the calendar (returns must be on a pick-up day, #336) and they are the
// time-range presets (#368) — one query for both.
const reschedulable = order.status === 'requested' && !order.acceptedAt;
const upcomingWindows = reschedulable ? await getUpcomingPickupWindows(timeNowOslo()) : {};
const timeRanges = getOrderTimeRanges(order.id);
---

<BaseLayout title={`Order #${order.orderCode}`}>
	<Page width="narrow">
		<BackLink slot="before-title" href="/">Back to shop</BackLink>

		<Card as="div">
			<UserOrderSummary
				orderCode={order.orderCode}
				status={order.status}
				fromDate={order.fromDate}
				toDate={order.toDate}
				note={order.note}
				items={order.orderItems.map(toOrderItemView)}
				showImages
			>
				{order.status === 'requested' && <RequestedTimeRanges fromDate={order.fromDate} toDate={order.toDate} ranges={timeRanges} framed={false} />}
				{(order.status === 'scheduled' || order.status === 'active') && <ConfirmedPickupWindows pickup={order.pickupDay} return={order.returnDay} />}
			</UserOrderSummary>
			<SubmittedContactDetails contactName={order.contactName} />
			<div class={cardFooterClasses}>
				<ChangeOrderLink orderCode={order.orderCode} status={order.status} acceptedAt={order.acceptedAt} fromDate={order.fromDate} toDate={order.toDate} maxRentalDays={getMaxRentalDays()} pickupWindows={upcomingWindows} timeRanges={timeRanges} />
				<DeleteOrderButton orderCode={order.orderCode} status={order.status} />
			</div>
		</Card>
	</Page>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { db } from '../../db/client';
import OrdersTable from '../../components/orders/OrdersTable.astro';
import type { OrdersTableRow } from '../../components/orders/OrdersTable.astro';
import OrdersLayoutToggle from '../../components/orders/OrdersLayoutToggle.astro';
import Page from '../../components/ui/Page.astro';
import Callout from '../../components/ui/Callout.astro';
import Button from '../../components/ui/Button.astro';
import { ORDER_CODE_LENGTH } from '../../lib/orders';

// Gated by src/middleware/prefixes.ts (ROUTE_RULES via /orders) —
// reached only when logged in, so Astro.locals.user is non-null here.
const userId = Astro.locals.user?.id ?? '';

// One-shot notice after DeleteOrderButton deletes or cancels an order
// (?deleted=CODE / ?cancelled=CODE). The code is only echoed back if it
// looks like an order code, so the query string can't inject arbitrary text.
const ORDER_CODE_PATTERN = new RegExp(`^[A-Z0-9]{${ORDER_CODE_LENGTH}}$`);
const deletedCode = Astro.url.searchParams.get('deleted');
const cancelledCode = Astro.url.searchParams.get('cancelled');
const notice =
	deletedCode && ORDER_CODE_PATTERN.test(deletedCode)
		? `Order #${deletedCode} was deleted.`
		: cancelledCode && ORDER_CODE_PATTERN.test(cancelledCode)
			? `Order #${cancelledCode} was cancelled. The gear has been released for others to book.`
			: null;

const userOrders = await db.query.orders.findMany({
	where: (t, { eq }) => eq(t.userId, userId),
	orderBy: (t, { desc }) => [desc(t.createdAt)],
	with: { orderItems: { with: { item: true } } },
});

const rows: OrdersTableRow[] = userOrders.map((order) => ({
	orderCode: order.orderCode,
	status: order.status,
	fromDate: order.fromDate,
	toDate: order.toDate,
	items: order.orderItems.map((oi) => ({
		itemName: oi.item.name,
		requestedQuantity: oi.requestedQuantity,
	})),
}));
---

<BaseLayout title="My orders">
	<Page width="medium" title="My orders">
		<OrdersLayoutToggle slot="actions" />

		{
			notice && (
				<Callout variant="success">
					<p>{notice}</p>
				</Callout>
			)
		}

		<OrdersTable orders={rows} viewHref={(code: string) => `/orders/${code}`} emptyMessage="You haven't placed any orders yet.">
			<Button slot="empty-action" href="/" variant="secondary">Browse gear</Button>
		</OrdersTable>
	</Page>
</BaseLayout>

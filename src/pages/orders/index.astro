---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrdersTable from '../../components/orders/OrdersTable.astro';
import OrdersLayoutToggle from '../../components/orders/OrdersLayoutToggle.astro';
import Page from '../../components/ui/Page.astro';
import Callout from '../../components/ui/Callout.astro';
import Button from '../../components/ui/Button.astro';
import { getMemberOrderRows } from '../../lib/orders';
import { takeOrderNotice } from '../../lib/orderNotice';

// Gated by src/middleware/prefixes.ts (ROUTE_RULES via /orders) —
// reached only when logged in, so Astro.locals.user is non-null here.

// One-shot notice after MemberOrderActionButton deletes or cancels an order
// — set by the API route on success, cleared here (see src/lib/orderNotice.ts).
const orderNotice = takeOrderNotice(Astro.cookies);
const notice =
	orderNotice?.kind === 'deleted'
		? `Order #${orderNotice.orderCode} was deleted.`
		: orderNotice?.kind === 'cancelled'
			? `Order #${orderNotice.orderCode} was cancelled. The gear has been released for others to book.`
			: null;

// Rows come without customerName, so the table drops that column.
const rows = await getMemberOrderRows(Astro.locals.user?.id ?? '');
---

<BaseLayout title="My orders">
	<Page width="medium" title="My orders">
		<OrdersLayoutToggle slot="actions" />

		{
			notice && (
				<Callout variant="success">
					<p>{notice}</p>
				</Callout>
			)
		}

		<OrdersTable orders={rows} viewHref={(order) => `/orders/${order.orderCode}`} emptyMessage="You haven't placed any orders yet.">
			<Button slot="empty-action" href="/" variant="secondary">Browse gear</Button>
		</OrdersTable>
	</Page>
</BaseLayout>

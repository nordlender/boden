---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrdersTable from '../../components/orders/OrdersTable.astro';
import OrdersLayoutToggle from '../../components/orders/OrdersLayoutToggle.astro';
import Page from '../../components/ui/Page.astro';
import { getMemberOrderRows } from '../../lib/orders';

// Gated by src/middleware/prefixes.ts (ROUTE_RULES via /orders) —
// reached only when logged in, so Astro.locals.user is non-null here.
const rows = await getMemberOrderRows(Astro.locals.user?.id ?? '');
---

<BaseLayout title="My orders">
	<Page width="medium" title="My orders">
		<OrdersLayoutToggle slot="actions" />

		<OrdersTable orders={rows} viewHref={(code: string) => `/orders/${code}`} emptyMessage="You haven't placed any orders yet." />
	</Page>
</BaseLayout>

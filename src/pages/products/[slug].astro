---
// Route name: "/products/[slug]" (matching src/db/schema.ts's `products`
// table) rather than worktree-navbar-homepage's "/items/[slug]" — in schema
// v3 a slug-routable, customer-facing page is a product (title/description/
// attribute template), with items as its unlabeled variants underneath, so
// "/items/..." would be the wrong noun here. See this PR's description.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImagePlaceholder from '../../components/shop/ImagePlaceholder.astro';
import VariantPicker from '../../components/shop/VariantPicker.astro';
import { getPublishedProductSlugs, getShopProductBySlug } from '../../lib/shop';

export async function getStaticPaths() {
	const slugs = await getPublishedProductSlugs();
	return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const product = await getShopProductBySlug(slug!);

if (!product) {
	return Astro.redirect('/404');
}

// This page is prerendered (static output, see astro.config.mjs), so
// Astro.url.searchParams reflects the build-time request, not a real
// visitor's URL — a `?item=` variant preselect is applied client-side
// instead (see VariantPicker's script). Server-side, just default to the
// first item.
const initialItem = product.items[0] ?? null;
const initialImageUrl = initialItem?.imageUrl ?? product.thumbnailImageUrl ?? null;
---

<BaseLayout title={product.title}>
	<div class="mx-auto grid max-w-4xl gap-8 px-4 py-12 sm:grid-cols-2">
		<div class="aspect-square overflow-hidden rounded-lg bg-bg-subtle">
			<!--
				Both the image and its placeholder are always in the DOM (rather
				than picking one at render time) so the variant-select script can
				reliably toggle between them — an empty data-image on a variant
				with no photo of its own needs to fall back to the placeholder,
				not silently keep showing the previous variant's photo.
			-->
			<img
				data-product-image
				src={initialImageUrl ?? ''}
				alt={product.title}
				class="h-full w-full object-cover"
				hidden={!initialImageUrl}
			/>
			<div
				data-product-image-placeholder
				class="flex h-full w-full items-center justify-center text-disabled-text"
				hidden={Boolean(initialImageUrl)}
			>
				<ImagePlaceholder size={48} />
			</div>
		</div>

		<div class="flex flex-col gap-4">
			<div>
				{product.subcategoryName && <p class="text-xs uppercase tracking-wide text-text-muted">{product.subcategoryName}</p>}
				<h1 class="text-2xl font-semibold tracking-tight text-text">{product.title}</h1>
			</div>

			{product.description && <p class="text-sm text-text-muted">{product.description}</p>}

			{
				product.items.length === 0 ? (
					<p class="text-sm text-error-text">No items available for this product yet.</p>
				) : (
					<VariantPicker
						items={product.items}
						productSlug={product.slug}
						thumbnailImageUrl={product.thumbnailImageUrl}
						attributeKeyOrder={product.attributeKeyOrder}
					/>
				)
			}

			{
				product.links.length > 0 && (
					<ul class="flex flex-col gap-1 border-t border-border pt-4 text-sm">
						{product.links.map((link) => (
							<li>
								<a href={link.url} target="_blank" rel="noopener noreferrer" class="text-text-muted underline hover:text-text">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</div>
</BaseLayout>
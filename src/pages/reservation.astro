---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReservationForm from '../components/reservation/ReservationForm.astro';
import { findOvercommittedItems, getCartLines, totalItemDemand } from '../lib/cart';
import { getUpcomingAvailablePickupDates } from '../lib/pickupDays';
import { getMaxRentalDays } from '../lib/rental-policy';
import { todayIsoInOslo } from '../lib/dates';
import { getUnmetDays } from '../lib/availability';
import { getSession } from 'auth-astro/server';
import { fetchOwnMemberFeeStatus } from '../lib/blocFeeStatus';

// Gated by src/middleware/index.ts (MEMBER_ROUTES) — reached only when logged in.
const cartLines = await getCartLines(Astro.cookies);

// Per-item totals across the whole cart (a loose item plus a set containing
// it count together) — used for both the overcommit check and the calendar.
const demand = totalItemDemand(cartLines);

// A cart that asks for more of an item than we own can't be reserved for
// any date — send it back to the cart, which says which item and how many.
if (cartLines.length === 0 || findOvercommittedItems(demand).size > 0) {
	return Astro.redirect('/cart');
}

// Fetched live on every visit (not carried in the JWT) so a fee paid or
// falling due mid-session is reflected when the order is placed. After the
// empty-cart redirect so that path never waits on bloc; parallel with the session.
const [session, feeStatus] = await Promise.all([getSession(Astro.request), fetchOwnMemberFeeStatus(Astro.request)]);

// Europe/Oslo's today, not the server host's — see src/lib/dates.ts.
const todayIso = todayIsoInOslo();
const availablePickupDates = await getUpcomingAvailablePickupDates(todayIso);

// Days the cart as a whole can't be reserved for, over the next few months —
// greyed out and unselectable in the calendar. Lets a member reserve items
// that are out today for a later date when they're back (see
// src/lib/availability.ts). The per-line check after picking dates still
// catches a range that spans one of these days.
const UNAVAILABLE_HORIZON_DAYS = 120;
const requirements = [...demand].map(([itemId, { needed }]) => ({ itemId, quantity: needed }));
const unavailableDates = getUnmetDays(requirements, todayIso, UNAVAILABLE_HORIZON_DAYS, { today: todayIso });

// Surfaces the two error redirects /api/orders/create can send back here
// (invalid_dates, unavailable) — previously the form just silently
// re-rendered with no indication anything had failed.
const error = Astro.url.searchParams.get('error');
const errorMessage =
	error === 'invalid_dates'
		? `Your selected dates were invalid, the pick-up date has already passed, or the range was longer than the maximum ${getMaxRentalDays()} days — please choose your dates again.`
		: error === 'unavailable'
			? "One or more items in your cart are no longer available for the selected dates — check the availability badges below and adjust your dates, or remove the unavailable item(s) from your cart, before submitting again."
			: error === 'disclaimer_required'
				? 'You must accept the disclaimer before submitting the order.'
				: null;
---

<BaseLayout title="Reservation dates">
	<div class="mx-auto max-w-3xl px-4 py-8">
		<h1 class="mb-2 text-2xl font-semibold tracking-tight text-text">Reserve your items</h1>
		<p class="mb-6 text-sm text-text-muted">Choose your dates, then review your items and submit your request.</p>

		{errorMessage && <p class="mb-6 rounded-lg border border-error-border bg-error-subtle p-3 text-sm text-error-text">{errorMessage}</p>}

		<ReservationForm
			cartLines={cartLines}
			availablePickupDates={availablePickupDates}
			unavailableDates={unavailableDates}
			name={session?.user?.name ?? null}
			email={session?.user?.email ?? null}
			mobile={session?.bloc?.mobile ?? null}
			hasUnpaidFees={feeStatus.hasUnpaidFees}
			userIsMember={feeStatus.userIsMember}
		/>
	</div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import Page from '../../components/ui/Page.astro';
import { cardClasses, eyebrowClasses, sectionTitleClasses } from '../../lib/layout-styles';
import OrdersTableRow from '../../components/orders/OrdersTableRow.astro';
import ItemLine from '../../components/ui/ItemLine.astro';
import Badge from '../../components/ui/Badge.astro';
import SetChildrenList from '../../components/cart/SetChildrenList.astro';
import { getCartLines } from '../../lib/cart';
import { isValidDateRange } from '../../lib/reservation';
import { getPickupWindowsForDate } from '../../lib/pickupDays';
import { formatPickupWindow } from '../../lib/pickupWindowFormat';
import { formatDateDisplay } from '../../lib/dates';

// Gated by src/middleware/prefixes.ts (/reservation) — member-only. Only
// reachable via the reservation form's POST: this page is a read-only
// overview, the order itself is created by /api/orders/create when the
// "Confirm order" button below is pressed.
if (Astro.request.method !== 'POST') {
	return Astro.redirect('/reservation');
}

const form = await Astro.request.formData();
const cartLines = await getCartLines(Astro.cookies);
if (cartLines.length === 0) {
	return Astro.redirect('/reservation');
}

const fromDate = form.get('fromDate')?.toString() ?? '';
const toDate = form.get('toDate')?.toString() ?? '';
if (!isValidDateRange({ from: fromDate, to: toDate })) {
	return Astro.redirect('/reservation?error=invalid_dates');
}
if (form.get('disclaimerAccepted') !== 'on') {
	return Astro.redirect('/reservation?error=disclaimer_required');
}

const text = (name: string) => form.get(name)?.toString().trim() ?? '';
const contact = { name: text('name'), email: text('email'), mobile: text('mobile') };
const note = text('note');
const pickupWindows = await getPickupWindowsForDate(fromDate);

// Everything the API route needs, passed through unchanged. Fee/membership
// status is deliberately absent: /api/orders/create fetches it from bloc itself.
const hiddenFields: Record<string, string> = {
	fromDate,
	toDate,
	name: contact.name,
	email: contact.email,
	mobile: contact.mobile,
	note,
	disclaimerAccepted: 'on',
};
---

<BaseLayout title="Confirm order">
	<Page width="medium" title="Confirm your order" description="Check everything below, then confirm to submit your request.">
		<dl class:list={[cardClasses, 'p-card']}>
			<dt class={eyebrowClasses}>Pick-up time</dt>
			<dd class="mt-2 text-sm text-text">
				{formatDateDisplay(fromDate, { weekday: true })}
				{
					pickupWindows.length === 0 ? (
						<span class="text-text-muted">· time to be announced</span>
					) : (
						<ul class="mt-1 flex flex-col gap-1">
							{pickupWindows.map((w) => <li>{formatPickupWindow(w)}</li>)}
						</ul>
					)
				}
			</dd>
		</dl>

		<div>
			<OrdersTableRow fromDate={fromDate} toDate={toDate} customerName={contact.name}>
				<ul class="flex flex-col gap-3 text-sm text-text">
					{
						cartLines.map((line) => {
							const isSet = 'setId' in line;
							return (
								<li>
									<ItemLine
										imageUrl={line.imageUrl}
										name={line.productTitle}
										href={line.productSlug ? `/products/${line.productSlug}` : null}
										attributes={isSet ? [] : line.attributes}
										subtitle={isSet ? line.label : null}
										quantity={line.quantity}
										thumbnailSize={56}
									>
										{isSet && <Badge class="mt-0.5 self-start">Set</Badge>}
										{isSet && <SetChildrenList slot="below" components={line.children} quantity={line.quantity} />}
									</ItemLine>
								</li>
							);
						})
					}
				</ul>
			</OrdersTableRow>
		</div>

		<section class="flex flex-col gap-snug text-sm text-text">
			<h2 class:list={['mb-1', sectionTitleClasses]}>Your details</h2>
			<p>{contact.email}{contact.mobile && ` · ${contact.mobile}`}</p>
			{note && <p class="text-text-muted">Note: {note}</p>}
		</section>

		<form method="POST" action="/api/orders/create" class="flex items-center gap-controls">
			{Object.entries(hiddenFields).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
			<Button href="/reservation" variant="secondary" size="lg" data-back-link>Back</Button>
			<Button type="submit" variant="primary" size="lg">Confirm order</Button>
		</form>
	</Page>
</BaseLayout>

<script>
	// Prefer real history navigation: it lets the browser restore the
	// reservation form the member just came from. Falls back to the plain
	// /reservation link (e.g. page opened directly).
	document.querySelector<HTMLAnchorElement>('[data-back-link]')?.addEventListener('click', (event) => {
		// Only when we really came from the reservation form (the form POST
		// sends it as referrer) — otherwise history.back() could leave the flow.
		const cameFromForm = document.referrer !== '' && new URL(document.referrer).pathname === '/reservation';
		if (cameFromForm && history.length > 1) {
			event.preventDefault();
			history.back();
		}
	});
</script>

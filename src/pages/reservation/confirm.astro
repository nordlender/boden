---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import Page from '../../components/ui/Page.astro';
import CartView from '../../components/cart/CartView.astro';
import CartNextButton from '../../components/cart/CartNextButton.astro';
import { actionRowClasses, sectionTitleClasses } from '../../lib/layout-styles';
import { loadCart } from '../../lib/cart';
import { isCartId, parseCartEntries, sameSnapshot } from '../../lib/cartEntries';
import { isValidDateRange } from '../../lib/reservation';
import { getPickupWindowsForDate } from '../../lib/pickupDays';
import { formatPickupWindow } from '../../lib/pickupWindowFormat';
import { formatDateDisplay } from '../../lib/dates';

// Gated by src/middleware/prefixes.ts (/reservation) — member-only. Only
// reachable via the reservation form's POST: this page is a read-only
// overview, the order itself is created by /api/orders/create when the
// "Confirm order" button below is pressed — from exactly the cart shown here
// (its CartSnapshot, posted by CartNextButton), and only if the cart is
// still that one by then.
if (Astro.request.method !== 'POST') {
	return Astro.redirect('/reservation');
}

const form = await Astro.request.formData();
const cart = await loadCart(Astro.cookies);
if (cart.lines.length === 0) {
	return Astro.redirect('/reservation');
}

// The cart the member saw on /reservation must still be the cart now —
// otherwise send them back to see what changed rather than reviewing (and
// availability-checking) a different cart.
const postedCartId = form.get('cartId')?.toString();
const postedEntries = parseCartEntries(form.get('cartEntries')?.toString() ?? '');
if (!isCartId(postedCartId) || postedEntries === null || !sameSnapshot(cart, { cartId: postedCartId, entries: postedEntries })) {
	return Astro.redirect('/reservation?error=cart_changed');
}

const fromDate = form.get('fromDate')?.toString() ?? '';
const toDate = form.get('toDate')?.toString() ?? '';
if (!isValidDateRange({ from: fromDate, to: toDate })) {
	return Astro.redirect('/reservation?error=invalid_dates');
}
if (form.get('disclaimerAccepted') !== 'on') {
	return Astro.redirect('/reservation?error=disclaimer_required');
}

const text = (name: string) => form.get(name)?.toString().trim() ?? '';
const contact = { name: text('name'), email: text('email'), mobile: text('mobile') };
const note = text('note');
const pickupWindows = await getPickupWindowsForDate(fromDate);

// Everything the API route needs, passed through unchanged. Fee/membership
// status is deliberately absent: /api/orders/create fetches it from bloc itself.
const hiddenFields: Record<string, string> = {
	fromDate,
	toDate,
	name: contact.name,
	email: contact.email,
	mobile: contact.mobile,
	note,
	disclaimerAccepted: 'on',
};

// Label/value pairs for the "Your details" section; empty values are skipped.
const details = [
	{ label: 'Name', value: contact.name },
	{ label: 'Email', value: contact.email },
	{ label: 'Mobile', value: contact.mobile },
	{ label: 'Note', value: note },
].filter((detail) => detail.value !== '');
---

<BaseLayout title="Confirm order">
	<Page width="medium" title="Confirm your order" description="Check everything below, then confirm to submit your request.">
		<form method="POST" action="/api/orders/create" class="flex flex-col gap-region">
			{Object.entries(hiddenFields).map(([name, value]) => <input type="hidden" name={name} value={value} />)}

			<section class="flex flex-col gap-stack">
				<h2 class={sectionTitleClasses}>1. Pick-up &amp; return dates</h2>
				<dl class="flex flex-col gap-snug text-sm text-text">
					<div>
						<dt class="text-text-muted">Pick-up</dt>
						<dd>
							{formatDateDisplay(fromDate, { weekday: true })}
							{
								pickupWindows.length === 0 ? (
									<span class="text-text-muted">· time to be announced</span>
								) : (
									<ul class="mt-1 flex flex-col gap-1">
										{pickupWindows.map((w) => (
											<li>{formatPickupWindow(w)}</li>
										))}
									</ul>
								)
							}
						</dd>
					</div>
					<div>
						<dt class="text-text-muted">Return</dt>
						<dd>{formatDateDisplay(toDate, { weekday: true })}</dd>
					</div>
				</dl>
			</section>

			<section class="flex flex-col gap-stack">
				<h2 class={sectionTitleClasses}>2. Your items</h2>
				<CartView name="confirm" cart={cart} size="detailed" newTab class="border-y border-border" />
			</section>

			<section class="flex flex-col gap-stack">
				<h2 class={sectionTitleClasses}>3. Your details</h2>
				<dl class="flex flex-col gap-snug text-sm text-text">
					{
						details.map(({ label, value }) => (
							<div>
								<dt class="text-text-muted">{label}</dt>
								<dd class="whitespace-pre-line">{value}</dd>
							</div>
						))
					}
				</dl>
				<div class={actionRowClasses}>
					<Button href="/reservation" variant="secondary" size="lg" data-back-link>Back</Button>
					<CartNextButton view="confirm" cart={cart} label="Confirm order" size="lg" />
				</div>
			</section>
		</form>
	</Page>
</BaseLayout>

<script>
	// Prefer real history navigation: it lets the browser restore the
	// reservation form the member just came from. Falls back to the plain
	// /reservation link (e.g. page opened directly).
	document.querySelector<HTMLAnchorElement>('[data-back-link]')?.addEventListener('click', (event) => {
		// Only when we really came from the reservation form (the form POST
		// sends it as referrer) — otherwise history.back() could leave the flow.
		const cameFromForm = document.referrer !== '' && new URL(document.referrer).pathname === '/reservation';
		if (cameFromForm && history.length > 1) {
			event.preventDefault();
			history.back();
		}
	});
</script>

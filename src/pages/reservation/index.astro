---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReservationForm from '../../components/reservation/ReservationForm.astro';
import { getCartLines } from '../../lib/cart';
import { getUpcomingAvailablePickupDates } from '../../lib/pickupDays';
import { getMaxRentalDays } from '../../lib/rental-policy';
import { todayIsoInOslo } from '../../lib/dates';
import { getSession } from 'auth-astro/server';

// Gated by src/middleware/index.ts (MEMBER_ROUTES) — reached only when logged in.
const cartLines = await getCartLines(Astro.cookies);
const session = await getSession(Astro.request);

// Europe/Oslo's today, not the server host's — see src/lib/dates.ts.
const todayIso = todayIsoInOslo();
const availablePickupDates = await getUpcomingAvailablePickupDates(todayIso);

// Surfaces the error redirects /api/orders/create (and /reservation/confirm)
// can send back here (invalid_dates, unavailable, ...) — previously the form just silently
// re-rendered with no indication anything had failed.
const error = Astro.url.searchParams.get('error');
const errorMessage =
	error === 'invalid_dates'
		? `Your selected dates were invalid, the pick-up date has already passed, or the range was longer than the maximum ${getMaxRentalDays()} days — please choose your dates again.`
		: error === 'unavailable'
			? "One or more items in your cart are no longer available for the selected dates — check the availability badges below and adjust your dates, or split off the unavailable item(s), before submitting again."
			: error === 'disclaimer_required'
				? 'You must accept the disclaimer before submitting the order.'
				: error === 'account_not_found'
					? 'We could not find your account — please sign out and back in, then try again.'
					: error === 'cart_empty'
						? 'Your cart is empty, so no order was placed.'
						: error === 'items_unrentable'
							? 'None of the items in your cart can be reserved any more, so the order was not placed.'
							: error === 'order_failed'
								? 'Something went wrong while placing your order — please review your items and dates and try again.'
								: null;
---

<BaseLayout title="Reservation dates">
	<div class="mx-auto max-w-3xl px-4 py-8">
		<h1 class="mb-2 text-2xl font-semibold tracking-tight text-text">Reserve your items</h1>
		{cartLines.length > 0 && <p class="mb-6 text-sm text-text-muted">Choose your dates, then review your items and submit your request.</p>}

		{errorMessage && <p class="mb-6 rounded-lg border border-error-border bg-error-subtle p-3 text-sm text-error-text">{errorMessage}</p>}

		{cartLines.length === 0 && (
			<p class="text-sm text-text-muted">Your cart is empty. <a href="/" class="font-medium text-accent-text hover:underline">Continue shopping</a></p>
		)}

		{cartLines.length > 0 && <ReservationForm
			cartLines={cartLines}
			availablePickupDates={availablePickupDates}
			name={session?.user?.name ?? null}
			email={session?.user?.email ?? null}
			mobile={session?.bloc?.mobile ?? null}
			hasUnpaidFees={session?.bloc?.hasUnpaidFees ?? null}
			userIsMember={session?.bloc?.userIsMember ?? null}
		/>}
	</div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReservationForm from '../../components/reservation/ReservationForm.astro';
import Page from '../../components/ui/Page.astro';
import Callout from '../../components/ui/Callout.astro';
import { emptyStateFramedClasses } from '../../lib/layout-styles';
import { getCartLines } from '../../lib/cart';
import { getUpcomingPickupWindows } from '../../lib/pickupDays';
import { getMaxRentalDays } from '../../lib/rental-policy';
import { nowInOslo } from '../../lib/dates';
import { getSession } from 'auth-astro/server';
import { fetchOwnMemberFeeStatus } from '../../lib/blocFeeStatus';

// Gated by src/middleware/prefixes.ts (ROUTE_RULES) — reached only when logged in.
const cartLines = await getCartLines(Astro.cookies);

// Fetched live on every visit (not carried in the JWT) so a fee paid or
// falling due mid-session is reflected when the order is placed. Skipped for an
// empty cart so that path never waits on bloc; parallel with the session.
const [session, feeStatus] = await Promise.all([
	getSession(Astro.request),
	cartLines.length > 0 ? fetchOwnMemberFeeStatus(Astro.request) : Promise.resolve({ hasUnpaidFees: null, userIsMember: null }),
]);

// Europe/Oslo's clock, not the server host's — see src/lib/dates.ts.
const pickupWindows = await getUpcomingPickupWindows(nowInOslo());

// Surfaces the error redirects /api/orders/create (and /reservation/confirm)
// can send back here — see the keys of errorMessages below. Without this the
// form would silently re-render with no indication anything had failed.
const error = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
	invalid_dates: `Your selected dates were invalid, the pick-up date has already passed, or the range was longer than the maximum ${getMaxRentalDays()} days — please choose your dates again.`,
	unavailable:
		'One or more items in your cart are no longer available for the selected dates — check the availability badges below and adjust your dates, or remove the unavailable item(s) from your cart, before submitting again.',
	disclaimer_required: 'You must accept the disclaimer before submitting the order.',
	account_not_found: 'We could not find your account — please sign out and back in, then try again.',
	cart_empty: 'Your cart is empty, so no order was placed.',
	items_unrentable: 'None of the items in your cart can be reserved any more, so the order was not placed.',
	order_failed: 'Something went wrong while placing your order — please review your items and dates and try again.',
};
const errorMessage = error ? (errorMessages[error] ?? null) : null;
---

<BaseLayout title="Reservation dates">
	<Page
		width="medium"
		title="Reserve your items"
		description={cartLines.length > 0 ? 'Choose your dates, then review your items and submit your request.' : undefined}
	>
		{errorMessage && <Callout variant="error"><p>{errorMessage}</p></Callout>}

		{cartLines.length === 0 && (
			<p class={emptyStateFramedClasses}>Your cart is empty. <a href="/" class="font-medium text-accent-text hover:underline">Continue shopping</a></p>
		)}

		{cartLines.length > 0 && <ReservationForm
			cartLines={cartLines}
			pickupWindows={pickupWindows}
			maxRentalDays={getMaxRentalDays()}
			name={session?.user?.name ?? null}
			email={session?.user?.email ?? null}
			mobile={session?.bloc?.mobile ?? null}
			hasUnpaidFees={feeStatus.hasUnpaidFees}
			userIsMember={feeStatus.userIsMember}
		/>}
	</Page>
</BaseLayout>

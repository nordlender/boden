---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Wizard component test</title>
	</head>
	<body class="min-h-screen bg-slate-100 p-8">
		<div class="mx-auto flex max-w-4xl flex-col gap-6">
			<WizardHeader title="Items" />

			<div>
				<p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-400">Add item panel (demo — always open here)</p>
				<div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
					<AddItemPanel nextItemId={1059} />
				</div>
			</div>

			<ItemPanel variant="unassigned" title="Unassigned items" items={unassignedItems} />
			<ItemPanel variant="assigned" title="Assigned items" items={assignedItems} />
		</div>
	</body>
</html>

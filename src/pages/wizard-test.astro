---
// Scratch page for visually reviewing the dynamic wizard's item-table
// components against mock data. Not part of the real admin app yet — no
// wiring, no client-side state (checkbox/selected state is baked into the
// mock data below to demonstrate each visual state).
import '../styles/global.css';
import WizardHeader from '../components/wizard/WizardHeader.astro';
import ItemPanel from '../components/wizard/ItemPanel.astro';
import AddItemPanel from '../components/wizard/AddItemPanel.astro';
import type { ItemView } from '../components/wizard/ItemPanel.astro';

const unassignedItems: ItemView[] = [
	{ itemId: 1041, name: 'Blue Rain Jacket, size M', image: null, inStock: 6, totalStock: 6 },
	{ itemId: 1042, name: 'Blue Rain Jacket, size L', image: null, inStock: 0, totalStock: 4, selected: true },
	{ itemId: 1058, name: 'Camping Stove — Duo', image: null, inStock: 2, totalStock: 2 },
];

const assignedItems: ItemView[] = [
	{
		itemId: 992,
		name: 'Red Rain Jacket, size S',
		image: null,
		subCategory: 'Jackets',
		product: 'Rain Jacket',
		inStock: 18,
		totalStock: 24,
		selected: true,
		description: 'A fully waterproof shell jacket built for sustained rain, not just showers.',
		attributes: [
			{ key: 'Material', value: 'Ripstop nylon' },
			{ key: 'Waterproof rating', value: '10,000mm' },
			{ key: 'Weight', value: '420g' },
		],
	},
	{
		itemId: 993,
		name: 'Red Rain Jacket, size M',
		image: null,
		subCategory: 'Jackets',
		product: 'Rain Jacket',
		inStock: 9,
		totalStock: 24,
		selected: true,
		description: 'A fully waterproof shell jacket built for sustained rain, not just showers.',
		attributes: [
			{ key: 'Material', value: 'Ripstop nylon' },
			{ key: 'Waterproof rating', value: '10,000mm' },
			{ key: 'Weight', value: '450g' },
		],
	},
	{
		itemId: 1001,
		name: '4-Person Tent',
		image: null,
		subCategory: 'Tents',
		product: 'Family Tent',
		inStock: 1,
		totalStock: 5,
		description: 'Freestanding dome tent with a full-coverage rainfly, sleeps four.',
		attributes: [
			{ key: 'Capacity', value: '4 people' },
			{ key: 'Packed weight', value: '3.8kg' },
			{ key: 'Season rating', value: '3-season' },
			{ key: 'Poles', value: 'Aluminium' },
			{ key: 'Doors', value: '2' },
